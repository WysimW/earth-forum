{% extends 'base.html.twig' %}

{% block title %}Nouveau message{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/editor.css') }}">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                {% for item in breadcrumbs %}
                    <li class="breadcrumb-item">
                        <a href="{{ item.url }}">{{ item.name }}</a>
                    </li>
                {% endfor %}
            </ol>
        </nav>

        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">{{ thread.title }}</h5>
                {{ form_start(form, {'attr': {'class': 'post-form', 'novalidate': 'novalidate'}}) }}
                    {% if thread.type == 'roleplay' %}
                        <div class="mb-3">
                            {{ form_label(form.character) }}
                            {{ form_widget(form.character, {'attr': {'class': 'form-select'}}) }}
                            {{ form_help(form.character) }}
                            {{ form_errors(form.character) }}
                        </div>
                    {% endif %}
                    <div class="mb-3">
                        {{ form_label(form.content) }}
                        <div id="editor" class="wysiwyg-editor-full" data-mode="{{ thread.type == 'roleplay' ? 'roleplay' : 'hrp' }}"></div>
                        {{ form_widget(form.content, {'attr': {'class': 'd-none', 'required': false}}) }}
                        {{ form_errors(form.content) }}
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary" name="publish">Publier</button>
                        <button type="submit" class="btn btn-secondary" name="save_draft">Enregistrer comme brouillon</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editor = new Quill('#editor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        ['blockquote', 'code-block'],
                        [{ 'header': 1 }, { 'header': 2 }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'script': 'sub'}, { 'script': 'super' }],
                        [{ 'indent': '-1'}, { 'indent': '+1' }],
                        [{ 'direction': 'rtl' }],
                        [{ 'size': ['small', false, 'large', 'huge'] }],
                        [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'font': [] }],
                        [{ 'align': [] }],
                        ['clean']
                    ]
                }
            });

            const form = document.querySelector('.post-form');
            const contentInput = form.querySelector('textarea[name$="[content]"]');

            editor.on('text-change', function() {
                contentInput.value = editor.root.innerHTML;
            });

            // Si le contenu existe déjà, l'afficher dans l'éditeur
            if (contentInput.value) {
                editor.root.innerHTML = contentInput.value;
            }

            // Validation personnalisée avant soumission
            form.addEventListener('submit', function(e) {
                if (!editor.getText().trim()) {
                    e.preventDefault();
                    alert('Veuillez saisir un message');
                    return false;
                }
                contentInput.value = editor.root.innerHTML;
            });
        });
    </script>
{% endblock %}