{# Template partiel pour le formulaire de réponse RP avec cartes d'identité #}
<div class="reply-form">
    {# Accordéon principal avec style cohérent #}
    <div class="reply-form__accordion">
        <button class="reply-form__header reply-form__header--roleplay" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#replyFormAccordion" 
                aria-expanded="false">
            <span class="reply-form__title">
                <i class="fas fa-dice-d20 me-2"></i>
                Répondre en tant que personnage
            </span>
            <i class="fas fa-chevron-down reply-form__icon"></i>
        </button>
        
        <div id="replyFormAccordion" class="collapse">
            <div class="reply-form__content">
                {{ form_start(form, {'attr': {'class': 'reply-form__form', 'id': 'character-reply-form'}}) }}
                    
                    {# Sélection du personnage avec cartes #}
                    <div class="character-selector">
                        <div class="character-selector__header">
                            <h5 class="character-selector__title">
                                <i class="fas fa-user-astronaut me-2"></i>
                                Choisir votre personnage
                            </h5>
                            <small class="character-selector__subtitle">
                                Personnages validés dans {{ universe ? universe.name : 'cet univers' }}
                            </small>
                        </div>
                        

                        
                        {% if characters|length == 0 %}
                            <div class="character-selector__empty">
                                <div class="alert alert-warning">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Aucun personnage validé dans cet univers.
                                    <br>
                                    <a href="{{ path('app_roleplay_character_new') }}" class="alert-link">
                                        Créer un nouveau personnage
                                    </a>
                                </div>
                            </div>
                        {% else %}
                            {# Galerie de cartes de personnages cliquables - Design Dark Mode #}
                            <div class="character-gallery row g-4" id="character-gallery">
                                {% for character in characters %}
                                    <div class="col-lg-6 col-xl-4">
                                        <div class="character-card" 
                                             data-character-id="{{ character.id }}" 
                                             onclick="selectCharacter({{ character.id }})"
                                             title="Sélectionner {{ character.name }}">
                                            <div class="character-card__inner">
                                                {# Badge de héros principal #}
                                                <div class="character-card__hero-badge">
                                                    <i class="fas fa-star"></i>
                                                </div>
                                                
                                                {# Header avec avatar et informations principales #}
                                                <div class="character-card__header">
                                                    <div class="character-card__avatar-container">
                                                        <div class="character-card__avatar">
                                                            {% if character.avatar %}
                                                                <img src="{{ character.avatarCircleUrl }}" 
                                                                     alt="{{ character.name }}" 
                                                                     class="character-card__avatar-img">
                                                            {% else %}
                                                                <div class="character-card__avatar-placeholder">
                                                                    <i class="fas fa-user-astronaut"></i>
                                                                </div>
                                                            {% endif %}
                                                            
                                                            {# Badge de validation #}
                                                            <div class="character-card__status-badge">
                                                                <i class="fas fa-shield-check" title="Personnage validé"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="character-card__basic-info">
                                                        <h5 class="character-card__name">{{ character.name }}</h5>
                                                        {% if character.actualPseudo %}
                                                            <div class="character-card__alias">
                                                                <i class="fas fa-mask me-1"></i>
                                                                "{{ character.actualPseudo }}"
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                
                                                {# Corps avec informations détaillées #}
                                                <div class="character-card__body">
                                                    <div class="character-card__info-grid">
                                                        {% if character.occupation %}
                                                            <div class="character-card__info-item">
                                                                <i class="fas fa-briefcase"></i>
                                                                <span>{{ character.occupation }}</span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if character.age %}
                                                            <div class="character-card__info-item">
                                                                <i class="fas fa-calendar-alt"></i>
                                                                <span>{{ character.age }}</span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if character.location %}
                                                            <div class="character-card__info-item">
                                                                <i class="fas fa-map-marker-alt"></i>
                                                                <span>{{ character.location.name }}</span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if character.moralAffiliation %}
                                                            <div class="character-card__info-item">
                                                                <i class="fas fa-balance-scale"></i>
                                                                <span>{{ character.moralAffiliation }}</span>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    
                                                    {# Accordéons pour réduire la hauteur #}
                                                    <div class="character-card__accordions">
                                                        {% if character.abilities %}
                                                            <div class="character-card__accordion-item">
                                                                <button class="character-card__accordion-header" 
                                                                        type="button" 
                                                                        onclick="toggleCharacterAccordion(event, 'abilities-{{ character.id }}')">
                                                                    <span class="character-card__accordion-title">
                                                                        <i class="fas fa-bolt me-1"></i>
                                                                        Capacités
                                                                    </span>
                                                                    <i class="fas fa-chevron-down character-card__accordion-icon"></i>
                                                                </button>
                                                                <div class="character-card__accordion-content" id="abilities-{{ character.id }}">
                                                                    <div class="character-card__accordion-body">
                                                                        {{ character.abilities|striptags }}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if character.equipment %}
                                                            <div class="character-card__accordion-item">
                                                                <button class="character-card__accordion-header" 
                                                                        type="button" 
                                                                        onclick="toggleCharacterAccordion(event, 'equipment-{{ character.id }}')">
                                                                    <span class="character-card__accordion-title">
                                                                        <i class="fas fa-shield-alt me-1"></i>
                                                                        Équipement
                                                                    </span>
                                                                    <i class="fas fa-chevron-down character-card__accordion-icon"></i>
                                                                </button>
                                                                <div class="character-card__accordion-content" id="equipment-{{ character.id }}">
                                                                    <div class="character-card__accordion-body">
                                                                        {{ character.equipment|striptags }}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                
                                                {# Footer avec hint d'action #}
                                                <div class="character-card__footer">
                                                    <div class="character-card__action-hint">
                                                        <i class="fas fa-hand-pointer me-1"></i>
                                                        Cliquer pour incarner ce personnage
                                                    </div>
                                                </div>
                                                
                                                {# Overlay de sélection amélioré #}
                                                <div class="character-card__selection-overlay">
                                                    <div class="character-card__selection-content">
                                                        <div class="character-card__selection-icon">
                                                            <i class="fas fa-check-circle"></i>
                                                        </div>
                                                        <div class="character-card__selection-text">Personnage Sélectionné</div>
                                                        <div class="character-card__selection-subtext">Prêt à jouer</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            

                        {% endif %}
                        
                        {# Select caché pour la synchronisation avec Symfony #}
                        {% if form.character is defined %}
                            <div style="display: none;">
                                {{ form_widget(form.character) }}
                            </div>

                            {# Affichage des erreurs du champ character #}
                            {% if form.character.vars.errors|length > 0 %}
                                <div class="alert alert-danger">
                                    {{ form_errors(form.character) }}
                                </div>
                            {% endif %}
                        {% endif %}
                        
                        {# Données JSON pour le JavaScript #}
                        <script type="application/json" id="characters-data">
                            {{ characters|map(c => {
                                id: c.id,
                                name: c.name,
                                actualPseudo: c.actualPseudo,
                                occupation: c.occupation,
                                avatar: c.avatar,
                                location: c.location ? c.location.name : null,
                                abilities: c.abilities ? (c.abilities|striptags|slice(0, 200)) : null,
                                age: c.age,
                                moralAffiliation: c.moralAffiliation,
                                equipment: c.equipment ? (c.equipment|striptags|slice(0, 150)) : null,
                                appearance: c.appearance ? (c.appearance|striptags|slice(0, 150)) : null
                            })|json_encode|raw }}
                        </script>
                    </div>

                    {# Section du message #}
                    <div class="post-editor" id="post-editor" style="display: none;">
                        <div class="post-editor__header">
                            <h5 class="post-editor__title">
                                <i class="fas fa-feather-alt me-2"></i>
                                Votre message RP
                            </h5>
                            <div class="post-editor__character-info" id="selected-character-info">
                                <span class="post-editor__character-name" id="editor-character-name"></span>
                                <small class="post-editor__character-note">
                                    Vous écrivez en tant que ce personnage
                                </small>
                            </div>
                        </div>
                        
                        <div class="post-editor__content">
                            {{ form_widget(form.content, {'attr': {
                                'class': 'post-editor__textarea wysiwyg-editor',
                                'rows': '12',
                                'placeholder': 'Racontez les actions et paroles de votre personnage...',
                                'id': 'reply-content'
                            }}) }}
                            {{ form_errors(form.content) }}
                        </div>
                    </div>

                    {# Section des PNJ avec cartes sélectionnables #}
                    {% if npcs|length > 0 %}
                        <div class="npcs-selector" id="npcs-selector" style="display: none;">
                            <div class="npcs-selector__header">
                                <h5 class="npcs-selector__title">
                                    <i class="fas fa-users me-2"></i>
                                    PNJ présents (optionnel)
                                </h5>
                                <small class="npcs-selector__subtitle">
                                    Sélectionnez les PNJ qui apparaissent dans votre message. Vous pouvez sélectionner plusieurs PNJ.
                                </small>
                            </div>
                            
                            <div class="npcs-selector__content" id="npcs-cards-container">
                                <div class="npcs-gallery row g-3">
                                    {% for npc in npcs %}
                                        <div class="col-md-6 col-xl-4">
                                            <div class="npc-card" 
                                                 data-npc-id="{{ npc.id }}" 
                                                 onclick="toggleNpcSelection({{ npc.id }})"
                                                 title="Cliquez pour sélectionner {{ npc.name }}">
                                                <div class="npc-card__inner">
                                                    {# Badge de statut propriétaire #}
                                                    {% if npc.user.id == app.user.id %}
                                                        <div class="npc-card__owner-badge">
                                                            <i class="fas fa-crown"></i>
                                                        </div>
                                                    {% endif %}
                                                    
                                                    {# En-tête avec avatar et infos principales #}
                                                    <div class="npc-card__header">
                                                        <div class="npc-card__avatar-container">
                                                            <div class="npc-card__avatar">
                                                                {% if npc.avatar %}
                                                                    <img src="{{ npc.avatar }}" 
                                                                         alt="{{ npc.name }}" 
                                                                         class="npc-card__avatar-img">
                                                                {% else %}
                                                                    <div class="npc-card__avatar-placeholder">
                                                                        <i class="fas fa-user-tie"></i>
                                                                    </div>
                                                                {% endif %}
                                                                
                                                                {# Badge de validation #}
                                                                <div class="npc-card__status-badge">
                                                                    <i class="fas fa-check-circle" title="PNJ validé"></i>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        
                                                        <div class="npc-card__basic-info">
                                                            <h6 class="npc-card__name">{{ npc.name }}</h6>
                                                            {% if npc.occupation %}
                                                                <div class="npc-card__occupation">
                                                                    <i class="fas fa-briefcase me-1"></i>
                                                                    {{ npc.occupation }}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                    
                                                    {# Corps de la carte avec informations détaillées #}
                                                    <div class="npc-card__body">
                                                        {% if npc.age %}
                                                            <div class="npc-card__info-item">
                                                                <i class="fas fa-calendar-alt"></i>
                                                                <span>{{ npc.age }}</span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if npc.factionsRelation|length > 0 %}
                                                            <div class="npc-card__info-item npc-card__factions">
                                                                <i class="fas fa-users"></i>
                                                                <span>
                                                                    {% for faction in npc.factionsRelation|slice(0, 2) %}
                                                                        {{ faction.name }}{% if not loop.last %}, {% endif %}
                                                                    {% endfor %}
                                                                    {% if npc.factionsRelation|length > 2 %}
                                                                        <small class="text-muted">+{{ npc.factionsRelation|length - 2 }}</small>
                                                                    {% endif %}
                                                                </span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if npc.user.id != app.user.id %}
                                                            <div class="npc-card__info-item npc-card__shared">
                                                                <i class="fas fa-share-alt"></i>
                                                                <span>Partagé par {{ npc.user.pseudo }}</span>
                                                            </div>
                                                        {% endif %}
                                                        
                                                        {% if npc.personality %}
                                                            <div class="npc-card__description">
                                                                <em>"{{ npc.personality|striptags|slice(0, 80) }}{% if npc.personality|length > 80 %}...{% endif %}"</em>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    
                                                    {# Footer avec action hint #}
                                                    <div class="npc-card__footer">
                                                        <small class="npc-card__hint">
                                                            <i class="fas fa-mouse-pointer me-1"></i>
                                                            Cliquer pour sélectionner
                                                        </small>
                                                    </div>
                                                    
                                                    {# Overlay de sélection amélioré #}
                                                    <div class="npc-card__selection-overlay">
                                                        <div class="npc-card__selection-content">
                                                            <div class="npc-card__selection-check">
                                                                <i class="fas fa-check"></i>
                                                            </div>
                                                            <div class="npc-card__selection-text">Sélectionné</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                
                                <div class="npcs-selector__summary mt-3" id="npcs-summary" style="display: none;">
                                    <div class="alert alert-info">
                                        <strong>PNJ sélectionnés :</strong> <span id="selected-npcs-list"></span>
                                    </div>
                                </div>
                            </div>
                            
                            {# Select caché pour la synchronisation avec Symfony #}
                            {% if form.npcs is defined %}
                                <div style="display: none;">
                                    {{ form_widget(form.npcs) }}
                                </div>
                                
                                {# Affichage des erreurs du champ npcs #}
                                {% if form.npcs.vars.errors|length > 0 %}
                                    <div class="alert alert-danger">
                                        {{ form_errors(form.npcs) }}
                                    </div>
                                {% endif %}
                            {% endif %}
                            
                            {# Données JSON pour le JavaScript #}
                            <script type="application/json" id="npcs-data">
                                {{ npcs|map(n => {
                                    id: n.id,
                                    name: n.name,
                                    occupation: n.occupation,
                                    avatar: n.avatar,
                                    age: n.age,
                                    user: n.user.pseudo,
                                    isOwner: n.user.id == app.user.id,
                                    factions: n.factionsRelation|map(f => f.name)|join(', '),
                                    personality: n.personality ? (n.personality|striptags|slice(0, 80)) : null
                                })|json_encode|raw }}
                            </script>
                        </div>
                    {% endif %}

                    {# Actions #}
                    <div class="reply-actions" id="reply-actions" style="display: none;">
                        <div class="reply-actions__buttons">
                            <button type="submit" name="publish" class="reply-actions__btn reply-actions__btn--publish" onclick="return validateCharacterSelection()">
                                <i class="fas fa-paper-plane me-2"></i>
                                Publier le message
                    </button>
                            <button type="submit" name="save_draft" class="reply-actions__btn reply-actions__btn--draft" onclick="return validateCharacterSelection()">
                                <i class="fas fa-save me-2"></i>
                                Sauvegarder en brouillon
                    </button>

                            <button type="button" class="reply-actions__btn reply-actions__btn--reset" onclick="resetCharacterForm()">
                                <i class="fas fa-undo me-2"></i>
                                Recommencer
                    </button>
                </div>
            </div>
                    
        {{ form_end(form) }}
            </div>
        </div>
    </div>
</div> 

<script>
// Variables globales
let charactersData = [];
let selectedCharacterId = null;
let npcsData = [];
let selectedNpcIds = [];

document.addEventListener('DOMContentLoaded', function() {
    // Vérifier la présence du select
    const hiddenSelect = document.getElementById('post_roleplay_character');
    console.log('Select au chargement:', hiddenSelect);
    if (hiddenSelect) {
        console.log('Select trouvé, ID:', hiddenSelect.id, 'Name:', hiddenSelect.name);
    } else {
        console.error('Select post_roleplay_character non trouvé!');
        // Chercher tous les selects pour debug
        const allSelects = document.querySelectorAll('select');
        console.log('Tous les selects:', allSelects);
    }
    
    // Charger les données des personnages
    const charactersDataElement = document.getElementById('characters-data');
    if (charactersDataElement) {
        try {
            charactersData = JSON.parse(charactersDataElement.textContent);
            console.log('Personnages chargés:', charactersData);
        } catch (e) {
            console.error('Erreur lors du parsing des données des personnages:', e);
            return;
        }
    }
    
    // Charger les données des PNJ
    const npcsDataElement = document.getElementById('npcs-data');
    if (npcsDataElement) {
        try {
            npcsData = JSON.parse(npcsDataElement.textContent);
            console.log('PNJ chargés:', npcsData);
        } catch (e) {
            console.error('Erreur lors du parsing des données des PNJ:', e);
        }
    }
    
    // Initialiser l'éditeur WYSIWYG
    initializeWysiwyg();
    
    // Animation de l'accordéon
    const accordion = document.getElementById('replyFormAccordion');
    if (accordion) {
        accordion.addEventListener('shown.bs.collapse', function() {
            // Focus sur la galerie de personnages
            const gallery = document.getElementById('character-gallery');
            if (gallery) {
                gallery.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    }
});

// Fonction pour sélectionner un personnage
function selectCharacter(characterId) {
    console.log('Sélection du personnage:', characterId);
    selectedCharacterId = characterId;
    
    // Synchroniser avec le select caché (ID généré par Symfony)
    const hiddenSelect = document.getElementById('post_roleplay_character');
    if (hiddenSelect) {
        console.log('Select trouvé, valeur avant:', hiddenSelect.value);
        hiddenSelect.value = characterId;
        console.log('Select après assignation:', hiddenSelect.value);
        
        // Déclencher l'événement change
        hiddenSelect.dispatchEvent(new Event('change'));
        
        // Marquer comme validé
        hiddenSelect.setCustomValidity('');
    } else {
        console.error('Select caché non trouvé!');
    }
    
    // Mettre à jour l'interface
    updateCharacterSelection(characterId);
    showEditorSections();
}

// Fonction pour mettre à jour la sélection visuelle
function updateCharacterSelection(characterId) {
    // Retirer la sélection de toutes les cartes
    document.querySelectorAll('.character-card').forEach(card => {
        card.classList.remove('character-card--selected');
    });
    
    // Ajouter la sélection à la carte choisie
    const selectedCard = document.querySelector(`[data-character-id="${characterId}"]`);
    if (selectedCard) {
        selectedCard.classList.add('character-card--selected');
        
        // Animation de sélection plus subtile
        selectedCard.style.transform = 'translateY(-6px) scale(1.03)';
        setTimeout(() => {
            selectedCard.style.transform = '';
        }, 300);
    }
}



// Fonction pour afficher les sections de l'éditeur
function showEditorSections() {
    const sections = ['post-editor', 'npcs-selector', 'reply-actions'];
    
    sections.forEach((sectionId, index) => {
        const section = document.getElementById(sectionId);
        if (section) {
            setTimeout(() => {
                section.style.display = 'block';
                setTimeout(() => {
                    section.classList.add('section--visible');
                }, 50);
            }, index * 200);
        }
    });
    
    // Mettre à jour l'info dans l'éditeur
    const character = charactersData.find(c => c.id == selectedCharacterId);
    if (character) {
        const editorCharacterName = document.getElementById('editor-character-name');
        const selectedCharacterInfo = document.getElementById('selected-character-info');
        
        if (editorCharacterName) {
            editorCharacterName.textContent = character.name;
        }
        if (selectedCharacterInfo) {
            selectedCharacterInfo.style.display = 'block';
        }
        
        // Initialiser l'éditeur WYSIWYG et focus après un délai
        setTimeout(() => {
            // Initialiser l'éditeur WYSIWYG
            initializeWysiwyg();
            
            // Focus sur l'éditeur après l'initialisation
            setTimeout(() => {
                const textarea = document.getElementById('reply-content');
                if (textarea && textarea._quill) {
                    // Si Quill est initialisé, focus sur l'éditeur Quill
                    textarea._quill.focus();
                } else if (textarea) {
                    // Sinon, focus sur le textarea
                    textarea.focus();
                }
            }, 300);
        }, 600);
    }
}

// Fonction pour initialiser l'éditeur WYSIWYG
function initializeWysiwyg() {
    // Cette fonction sera appelée quand l'éditeur devient visible
    setTimeout(() => {
        const textarea = document.getElementById('reply-content');
        if (textarea && textarea.classList.contains('wysiwyg-editor')) {
            // Vérifier si l'éditeur n'est pas déjà initialisé
            if (textarea.dataset.quillInitialized !== 'true') {
                // Utiliser la fonction globale d'initialisation de dc-editor.js
                if (typeof window.initWysiwygEditors === 'function') {
                    window.initWysiwygEditors();
                }
            }
        }
    }, 100);
}

// Fonction pour réinitialiser le formulaire
function resetCharacterForm() {
    if (confirm('Êtes-vous sûr de vouloir recommencer ? Toutes les données saisies seront perdues.')) {
        // Réinitialiser la sélection
        selectedCharacterId = null;
        
        // Réinitialiser l'interface
        document.querySelectorAll('.character-card').forEach(card => {
            card.classList.remove('character-card--selected');
        });
        
        // Masquer les sections
        const sections = ['post-editor', 'npcs-selector', 'reply-actions'];
        sections.forEach(sectionId => {
            const section = document.getElementById(sectionId);
            if (section) {
                section.style.display = 'none';
                section.classList.remove('section--visible');
            }
        });
        
        // Réinitialiser le formulaire
        document.getElementById('character-reply-form').reset();
        
        // Réinitialiser l'éditeur WYSIWYG si présent
        const textarea = document.getElementById('reply-content');
        if (textarea) {
            if (typeof tinymce !== 'undefined' && tinymce.get('reply-content')) {
                tinymce.get('reply-content').setContent('');
            } else if (typeof CKEDITOR !== 'undefined' && CKEDITOR.instances['reply-content']) {
                CKEDITOR.instances['reply-content'].setData('');
            }
        }
        
        // Réinitialiser la sélection des PNJ
        resetNpcsSelection();
    }
}

// Définir la fonction createRipple pour l'effet ripple sur les boutons
if (typeof createRipple === 'undefined') {
    window.createRipple = function(event) {
        const button = event.currentTarget;
        
        // Créer l'élément ripple
        const ripple = document.createElement('span');
        const rect = button.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height);
        const x = event.clientX - rect.left - size / 2;
        const y = event.clientY - rect.top - size / 2;
        
        ripple.style.cssText = `
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: scale(0);
            animation: ripple-effect 0.6s linear;
            width: ${size}px;
            height: ${size}px;
            left: ${x}px;
            top: ${y}px;
            pointer-events: none;
        `;
        
        // S'assurer que le bouton a position relative
        if (getComputedStyle(button).position === 'static') {
            button.style.position = 'relative';
        }
        
        // Assurer overflow hidden pour contenir l'effet
        button.style.overflow = 'hidden';
        
        // Ajouter l'animation CSS si elle n'existe pas
        if (!document.querySelector('#ripple-animation-style')) {
            const style = document.createElement('style');
            style.id = 'ripple-animation-style';
            style.textContent = `
                @keyframes ripple-effect {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
            `;
            document.head.appendChild(style);
        }
        
        // Ajouter l'effet ripple
        button.appendChild(ripple);
        
        // Supprimer l'effet après l'animation
        setTimeout(() => {
            if (ripple.parentNode) {
                ripple.parentNode.removeChild(ripple);
            }
        }, 600);
    };
}

// Fonction de validation avant soumission
function validateCharacterSelection() {
    console.log('Validation - selectedCharacterId:', selectedCharacterId);
    
    if (!selectedCharacterId) {
        alert('Veuillez sélectionner un personnage avant de publier votre message.');
        
        // Faire défiler vers la galerie de personnages
        const gallery = document.getElementById('character-gallery');
        if (gallery) {
            gallery.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return false;
    }
    
    // S'assurer que le select caché a la bonne valeur
    const hiddenSelect = document.getElementById('post_roleplay_character');
    if (hiddenSelect) {
        console.log('Validation - select value avant:', hiddenSelect.value);
        hiddenSelect.value = selectedCharacterId;
        console.log('Validation - select value après:', hiddenSelect.value);
        
        // Marquer le champ comme valide
        hiddenSelect.setCustomValidity('');
        
        // Vérifier que la valeur est bien définie
        if (!hiddenSelect.value || hiddenSelect.value === '') {
            console.error('Erreur: la valeur du select est vide après assignation');
            alert('Erreur technique: impossible de sauvegarder le personnage sélectionné.');
            return false;
        }
    } else {
        console.error('Select caché non trouvé lors de la validation!');
        alert('Erreur technique: champ de personnage non trouvé.');
        return false;
    }
    
    console.log('Validation réussie');
    return true;
}

// Fonctions de gestion des PNJ
function toggleNpcSelection(npcId) {
    const card = document.querySelector(`[data-npc-id="${npcId}"]`);
    const index = selectedNpcIds.indexOf(npcId);
    
    if (index > -1) {
        // Désélectionner
        selectedNpcIds.splice(index, 1);
        card.classList.remove('npc-card--selected');
    } else {
        // Sélectionner
        selectedNpcIds.push(npcId);
        card.classList.add('npc-card--selected');
        
        // Animation de sélection
        card.style.transform = 'scale(0.95)';
        setTimeout(() => {
            card.style.transform = 'scale(1)';
        }, 150);
    }
    
    // Mettre à jour l'interface et le select caché
    updateNpcsSelection();
}

function updateNpcsSelection() {
    // Mettre à jour le select caché
    const hiddenSelect = document.querySelector('select[name$="[npcs][]"]');
    if (hiddenSelect) {
        // Désélectionner toutes les options
        Array.from(hiddenSelect.options).forEach(option => {
            option.selected = false;
        });
        
        // Sélectionner les options correspondantes
        selectedNpcIds.forEach(npcId => {
            const option = hiddenSelect.querySelector(`option[value="${npcId}"]`);
            if (option) {
                option.selected = true;
            }
        });
        
        // Déclencher l'événement change
        hiddenSelect.dispatchEvent(new Event('change'));
    }
    
    // Mettre à jour le résumé
    updateNpcsSummary();
}

function updateNpcsSummary() {
    const summary = document.getElementById('npcs-summary');
    const list = document.getElementById('selected-npcs-list');
    
    if (selectedNpcIds.length > 0) {
        const selectedNames = selectedNpcIds.map(id => {
            const npc = npcsData.find(n => n.id == id);
            return npc ? npc.name : '';
        }).filter(name => name);
        
        list.textContent = selectedNames.join(', ');
        summary.style.display = 'block';
    } else {
        summary.style.display = 'none';
    }
}

function resetNpcsSelection() {
    selectedNpcIds = [];
    document.querySelectorAll('.npc-card').forEach(card => {
        card.classList.remove('npc-card--selected');
    });
    updateNpcsSelection();
}

// Fonction pour gérer les accordéons des cartes de personnages
function toggleCharacterAccordion(event, contentId) {
    // Empêcher complètement la propagation de l'événement
    event.preventDefault();
    event.stopPropagation();
    event.stopImmediatePropagation();
    
    const button = event.currentTarget;
    const content = document.getElementById(contentId);
    const icon = button.querySelector('.character-card__accordion-icon');
    
    if (!content) return false;
    
    const isExpanded = content.classList.contains('show');
    
    // Fermer tous les autres accordéons de cette carte
    const card = button.closest('.character-card');
    if (card) {
        const allContents = card.querySelectorAll('.character-card__accordion-content');
        const allButtons = card.querySelectorAll('.character-card__accordion-header');
        const allIcons = card.querySelectorAll('.character-card__accordion-icon');
        
        allContents.forEach(c => c.classList.remove('show'));
        allButtons.forEach(b => b.setAttribute('aria-expanded', 'false'));
        allIcons.forEach(i => i.style.transform = 'rotate(0deg)');
    }
    
    if (!isExpanded) {
        // Ouvrir cet accordéon
        content.classList.add('show');
        button.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(180deg)';
    }
    
    return false; // Empêcher toute action supplémentaire
}
