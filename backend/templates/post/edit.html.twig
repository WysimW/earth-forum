{% extends 'base.html.twig' %}

{% block title %}Éditer le message{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/editor.css') }}">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                {% for item in breadcrumbs %}
                    <li class="breadcrumb-item">
                        <a href="{{ item.url }}">{{ item.name }}</a>
                    </li>
                {% endfor %}
            </ol>
        </nav>

        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">{{ thread.title }}</h5>
                {{ form_start(form, {'attr': {'class': 'post-form', 'novalidate': 'novalidate'}}) }}
                    {% if isRoleplay and form.character is defined %}
                        <div class="mb-3">
                            {{ form_label(form.character) }}
                            {{ form_widget(form.character, {'attr': {'class': 'form-select'}}) }}
                            {{ form_help(form.character) }}
                            {{ form_errors(form.character) }}
                        </div>

                        {% if form.npcs is defined %}
                            <div class="mb-3">
                                {{ form_label(form.npcs) }}
                                {{ form_widget(form.npcs, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.npcs) }}
                                <small class="form-text text-muted">
                                    Sélectionnez les PNJ qui participent à ce message
                                </small>
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="mb-3">
                        {{ form_label(form.content) }}
                        {{ form_widget(form.content, {'attr': {
                            'class': 'form-control wysiwyg-editor',
                            'rows': '10',
                            'placeholder': 'Écrivez votre message ici...',
                            'data-mode': isRoleplay ? 'roleplay' : 'hrp',
                            'data-characters': app.user.characters|filter(c => c.status == 'validated')|map(c => {'id': c.id, 'name': c.name})|json_encode,
                            'data-npcs': app.user.npcs|filter(n => n.status == 'validated')|map(n => {'id': n.id, 'name': n.name})|json_encode
                        }}) }}
                        {{ form_errors(form.content) }}
                    </div>
                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-primary" name="publish">Publier</button>
                        <button type="submit" class="btn btn-secondary" name="save_draft">Enregistrer comme brouillon</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script src="{{ asset('js/dc-editor.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Rien à faire ici, l'initialisation est gérée par dc-editor.js
        });
    </script>
{% endblock %}