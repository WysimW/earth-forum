{% extends 'base.html.twig' %}

{% block title %}Nouveaux Messages{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/components/unread.css') }}">
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' %}
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Nouveaux Messages</h1>
        
        {% if standardUnreadPosts|length > 0 or participatingUnreadPosts|length > 0 or adminUnreadPosts|length > 0 %}
            <a href="{{ path('app_unread_messages_mark_all_read') }}" class="btn btn-primary">
                <i class="fas fa-check-double me-2"></i>Tout marquer comme lu
            </a>
        {% endif %}
    </div>
    
    {# Préférences d'affichage #}
    <div class="preferences-card">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="filterNonParticipatingMessages" {{ app.user.filterNonParticipatingMessages ? 'checked' : '' }}>
            <label class="form-check-label ms-2 text-light" for="filterNonParticipatingMessages">
                <i class="fas fa-filter me-1"></i> Ne pas afficher les messages des discussions où je ne participe pas
            </label>
        </div>
        <small class="text-light mt-1 d-block">
            Cette option vous permet de ne voir que les messages des discussions importantes et de celles où vous participez déjà.
        </small>
    </div>
    
    {% if standardUnreadPosts|length == 0 and participatingUnreadPosts|length == 0 and adminUnreadPosts|length == 0 %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="mb-3">Vous n'avez pas de nouveaux messages</h3>
                <p class="text-muted mb-4">Tous vos messages ont été lus</p>
                <a href="{{ path('app_front_office') }}" class="btn btn-primary">
                    <i class="fas fa-home me-2"></i>Retour à l'accueil
                </a>
            </div>
        </div>
    {% else %}
        {# Messages de l'administration #}
        {% if adminUnreadPosts|length > 0 %}
            <div class="unread-section unread-admin">
                <div class="unread-section-header">
                    <h2><i class="fas fa-bullhorn me-2"></i>Messages importants ({{ adminUnreadPosts|length }})</h2>
                </div>
                
                <div class="unread-messages-list">
                    {% for post in adminUnreadPosts %}
                        <div class="unread-message">
                            <div class="unread-message-header">
                                <div class="unread-message-user">
                                    {% if post.character %}
                                        <i class="fas fa-user-circle me-1"></i>{{ post.character.name }}
                                    {% else %}
                                        <i class="fas {% if 'ROLE_ADMIN' in post.author.roles %}fa-shield-alt{% else %}fa-user{% endif %} me-1"></i>{{ post.author.pseudo }}{% if 'ROLE_ADMIN' in post.author.roles %} (Admin){% endif %}
                                    {% endif %}
                                </div>
                                <div class="unread-message-date"><i class="far fa-clock me-1"></i>{{ post.createdAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="unread-message-thread">
                                <i class="fas fa-comments me-2"></i>Dans 
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug}) }}">
                                    {{ post.thread.title }}
                                </a>
                                <span class="badge bg-primary ms-2">
                                    <i class="fas fa-globe-americas me-1"></i>{{ post.thread.universe.name }}
                                </span>
                            </div>
                            <div class="unread-message-content">
                                {{ post.content|striptags|slice(0, 200) }}{% if post.content|length > 200 %}...{% endif %}
                            </div>
                            <div class="unread-message-actions">
                                <button onclick="markAsRead({{ post.id }}, this)" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-check me-1"></i>Marquer comme lu
                                </button>
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug, '_fragment': 'post-' ~ post.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye me-1"></i>Voir le message
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        
        {# Messages dans les threads où vous participez #}
        {% if participatingUnreadPosts|length > 0 %}
            <div class="unread-section unread-participating">
                <div class="unread-section-header">
                    <h2><i class="fas fa-user-friends me-2"></i>Messages dans vos discussions actives ({{ participatingUnreadPosts|length }})</h2>
                    <small class="text-light">Messages des discussions où vous avez participé ou où vos personnages sont inscrits</small>
                </div>
                
                <div class="unread-messages-list">
                    {% for post in participatingUnreadPosts %}
                        <div class="unread-message">
                            <div class="unread-message-header">
                                <div class="unread-message-user">
                                    {% if post.character %}
                                        <i class="fas fa-user-circle me-1"></i>{{ post.character.name }}
                                    {% else %}
                                        <i class="fas fa-user me-1"></i>{{ post.author.pseudo }}
                                    {% endif %}
                                </div>
                                <div class="unread-message-date"><i class="far fa-clock me-1"></i>{{ post.createdAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="unread-message-thread">
                                <i class="fas fa-comments me-2"></i>Dans 
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug}) }}">
                                    {{ post.thread.title }}
                                </a>
                                <span class="badge bg-primary ms-2">
                                    <i class="fas fa-globe-americas me-1"></i>{{ post.thread.universe.name }}
                                </span>
                            </div>
                            <div class="unread-message-content">
                                {{ post.content|striptags|slice(0, 200) }}{% if post.content|length > 200 %}...{% endif %}
                            </div>
                            <div class="unread-message-actions">
                                <button onclick="markAsRead({{ post.id }}, this)" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-check me-1"></i>Marquer comme lu
                                </button>
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug, '_fragment': 'post-' ~ post.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye me-1"></i>Voir le message
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        
        {# Messages standard #}
        {% if standardUnreadPosts|length > 0 %}
            <div class="unread-section unread-standard" id="standardMessagesSection">
                <div class="unread-section-header">
                    <h2><i class="fas fa-envelope me-2"></i>Autres messages ({{ standardUnreadPosts|length }})</h2>
                </div>
                
                <div class="unread-messages-list">
                    {% for post in standardUnreadPosts %}
                        <div class="unread-message">
                            <div class="unread-message-header">
                                <div class="unread-message-user">
                                    {% if post.character %}
                                        <i class="fas fa-user-circle me-1"></i>{{ post.character.name }}
                                    {% else %}
                                        <i class="fas fa-user me-1"></i>{{ post.author.pseudo }}
                                    {% endif %}
                                </div>
                                <div class="unread-message-date"><i class="far fa-clock me-1"></i>{{ post.createdAt|date('d/m/Y H:i') }}</div>
                            </div>
                            <div class="unread-message-thread">
                                <i class="fas fa-comments me-2"></i>Dans 
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug}) }}">
                                    {{ post.thread.title }}
                                </a>
                                <span class="badge bg-primary ms-2">
                                    <i class="fas fa-globe-americas me-1"></i>{{ post.thread.universe.name }}
                                </span>
                            </div>
                            <div class="unread-message-content">
                                {{ post.content|striptags|slice(0, 200) }}{% if post.content|length > 200 %}...{% endif %}
                            </div>
                            <div class="unread-message-actions">
                                <button onclick="markAsRead({{ post.id }}, this)" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-check me-1"></i>Marquer comme lu
                                </button>
                                <a href="{{ path('app_thread_show', {'universeSlug': post.thread.universe.slug, 'id': post.thread.id, 'slug': post.thread.slug, '_fragment': 'post-' ~ post.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye me-1"></i>Voir le message
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion du switch de préférence
        const filterSwitch = document.getElementById('filterNonParticipatingMessages');
        const standardMessagesSection = document.getElementById('standardMessagesSection');
        
        if (filterSwitch) {
            // Appliquer la préférence de filtrage au chargement de la page
            if (filterSwitch.checked && standardMessagesSection) {
                standardMessagesSection.style.display = 'none';
            }
            
            // Changement de préférence
            filterSwitch.addEventListener('change', function() {
                const isChecked = this.checked;
                
                // Masquer/Afficher les messages standards selon la préférence
                if (standardMessagesSection) {
                    standardMessagesSection.style.display = isChecked ? 'none' : 'block';
                }
                
                // Enregistrer la préférence en base de données
                fetch('{{ path('app_unread_messages_update_preferences') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: 'filterNonParticipatingMessages=' + (isChecked ? '1' : '0')
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('Préférence enregistrée');
                    }
                })
                .catch(error => console.error('Erreur:', error));
            });
        }
    });

    // Fonction pour marquer un message comme lu via AJAX
    function markAsRead(postId, button) {
        fetch('{{ path('app_unread_messages_mark_read', {'id': 0}) }}'.replace('0', postId), {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Trouver le message parent et le supprimer avec une animation
                const messageElement = button.closest('.unread-message');
                messageElement.style.transition = 'all 0.3s ease';
                messageElement.style.opacity = '0';
                messageElement.style.transform = 'translateX(-20px)';
                
                setTimeout(() => {
                    messageElement.remove();
                    
                    // Mettre à jour le compteur dans le header
                    const badge = document.querySelector('.notification-badge');
                    if (badge) {
                        const currentCount = parseInt(badge.textContent);
                        if (currentCount > 1) {
                            badge.textContent = currentCount - 1;
                        } else {
                            badge.remove();
                        }
                    }
                    
                    // Vérifier si la section est vide
                    const section = messageElement.closest('.unread-section');
                    const remainingMessages = section.querySelectorAll('.unread-message');
                    if (remainingMessages.length === 0) {
                        section.remove();
                    }
                    
                    // Vérifier si toutes les sections sont vides
                    const allSections = document.querySelectorAll('.unread-section');
                    if (allSections.length === 0) {
                        location.reload(); // Recharger pour afficher le message "pas de nouveaux messages"
                    }
                }, 300);
            }
        })
        .catch(error => console.error('Erreur:', error));
    }
</script>
{% endblock %} 