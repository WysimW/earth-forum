{% if threads is defined %}
    {% if threads|length > 0 %}
        <div class="threads-list">
            <div class="threads-header">
                <div class="header-type">Type</div>
                <div class="header-content">Discussion</div>
                <div class="header-activity">Dernière activité</div>
            </div>
            
            {% for thread in threads %}
                <div class="thread-card hover-effect hover-shine {% if thread.type == 'roleplay' %}rp-theme hover-glow-rp{% else %}hrp-theme hover-glow-hrp{% endif %} {% if thread.sticky %}thread-sticky{% endif %} {% if thread.status == 'closed' %}thread-closed{% endif %}" data-thread-id="{{ thread.id }}">
                    <div class="thread-icon-wrapper {% if thread.type == 'roleplay' %}rp-color{% else %}hrp-color{% endif %}">
                        <div class="thread-icon">
                            {% if thread.sticky and thread.status == 'closed' %}
                                <i class="fas fa-lock" data-bs-toggle="tooltip" title="Discussion verrouillée et épinglée"></i>
                            {% elseif thread.sticky %}
                                <i class="fas fa-thumbtack" data-bs-toggle="tooltip" title="Discussion épinglée"></i>
                            {% elseif thread.status == 'closed' %}
                                <i class="fas fa-lock" data-bs-toggle="tooltip" title="Discussion verrouillée"></i>
                            {% elseif thread.type == 'roleplay' %}
                                <i class="fa-solid fa-dice-d20" data-bs-toggle="tooltip" title="Roleplay"></i>
                            {% else %}
                                <i class="fas fa-comment-alt" data-bs-toggle="tooltip" title="Discussion"></i>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="thread-content">
                        <h3 class="thread-title">
                            <a href="{{ path('app_thread_show', {'universeSlug': univers.slug, 'id': thread.id}) }}">{{ thread.title }}</a>
                            {% if thread.status == 'closed' %}
                                <span class="thread-status-badge"><i class="fas fa-lock" title="Discussion verrouillée"></i></span>
                            {% endif %}
                        </h3>
                        
                        <div class="thread-list--thread-meta">
                            {% if thread.location %}
                                <span class="thread-location">
                                    <i class="fas fa-map-marker-alt"></i> {{ thread.location.name }}
                                </span>
                            {% endif %}
                            
                            <span class="thread-date">
                                <i class="fas fa-calendar-alt"></i> {{ thread.createdAt|date('d/m/Y') }}
                            </span>
                            
                            <span class="thread-replies">
                                <i class="fas fa-comments"></i> {{ (thread.posts|length - 1)|default(0) }} réponse{% if (thread.posts|length - 1)|default(0) > 1 %}s{% endif %}
                            </span>
                            
                            {% if thread.type == 'roleplay' and thread.characterParticipants is defined %}
                                <span class="thread-participants" data-bs-toggle="tooltip" title="Participants">
                                    <i class="fas fa-users"></i> 
                                    {{ thread.characterParticipants|length }} participant{% if thread.characterParticipants|length > 1 %}s{% endif %}
                                </span>
                            {% endif %}
                                                    <div class="thread-list--thread-actions">
                           
                            
                            {% if is_granted('ROLE_MODERATOR') or (is_granted('IS_AUTHENTICATED_FULLY') and thread.author and app.user.id == thread.author.id) %}
                                <div class="thread-actions">
                                    <a href="{{ path('app_thread_edit', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    {% if is_granted('ROLE_MODERATOR') %}
                                        {% if thread.sticky %}
                                            <a href="{{ path('app_thread_unsticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn" title="Désépingler">
                                                <i class="fas fa-thumbtack fa-rotate-90"></i>
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_thread_sticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn" title="Épingler">
                                                <i class="fas fa-thumbtack"></i>
                                            </a>
                                        {% endif %}
                                        {% if thread.status == 'closed' %}
                                            <a href="{{ path('app_thread_open', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn" title="Rouvrir">
                                                <i class="fas fa-lock-open"></i>
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_thread_close', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn" title="Verrouiller">
                                                <i class="fas fa-lock"></i>
                                            </a>
                                        {% endif %}
                                        <a href="{{ path('app_thread_delete', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-sm action-btn btn-danger" title="Supprimer" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette discussion ?')">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                        </div>
                        

                    </div>
                    
                    <div class="thread-last-activity">
                        <div class="thread-author-label">
                            <i class="fas fa-user-edit"></i>  Créé par :               {% if thread.type == 'roleplay' and thread.characterCreator %}
                                <span class="thread-list--character-name">{{ thread.characterCreator.name }}</span>
                            {% else %}
                                <span>{{ thread.author ? thread.author.pseudo : 'Anonyme' }}</span>
                            {% endif %}
                        </div>
                        
             
                        
                        <div class="activity-divider"></div>
                        
                        <div class="last-activity-wrapper d-flex align-items-center">
                            <div class="unread-indicator thread-unread-indicator thread-clock-replacement hidden" style="display: none;" title="Contient des messages non lus">
                                <i class="fas fa-circle-exclamation pulse-animation"></i>
                                <span class="unread-count">0</span>
                            </div>
                            
                            <div class="thread-clock-icon" style="display: inline-flex;">
                                <i class="fas fa-clock"></i>
                            </div>
                            
                            <span class="ms-1">Dernière activité :</span>
                        </div>
                        
                        {% if thread.lastPost is defined and thread.lastPost %}
                            <div class="last-post-details">
                                <div>
                                    <small class="d-block">{{ thread.lastPost.createdAt|date('d/m/Y H:i') }}</small>
                                    <small class="d-block">Par : 
                                        {% if thread.lastPost.character %}
                                            <span class="character-name">{{ thread.lastPost.character.name }}</span>
                                        {% else %}
                                            {{ thread.lastPost.author ? thread.lastPost.author.pseudo : 'Anonyme' }}
                                        {% endif %}
                                    </small>
                                </div>
                            </div>
                        {% else %}
                            <div class="no-replies">
                                <small>Pas de réponse</small>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-comment-slash"></i>
            <p>Aucune discussion dans ce forum pour le moment.</p>
            <p>Soyez le premier à en créer une !</p>
        </div>
    {% endif %}
{% endif %}