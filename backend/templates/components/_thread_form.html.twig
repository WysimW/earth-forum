{{ form_start(form) }}
    <div class="mb-3">
        {{ form_label(form.title) }}
        {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.title) }}
    </div>

    {% if isRoleplay %}
        {% if isNew %}
            <div class="mb-3">
                {{ form_label(form.characterCreator) }}
                {{ form_widget(form.characterCreator, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.characterCreator) }}
                
                {% if not hasValidatedCharacters is defined or not hasValidatedCharacters %}
                    <div class="alert alert-warning mt-2">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        {% if user.characters|length > 0 %}
                            Vous n'avez pas encore de personnage validé. 
                            Vos personnages doivent être validés par un modérateur avant de pouvoir créer une scène RP.
                        {% else %}
                            Vous n'avez pas encore créé de personnage. 
                            <a href="{{ path('app_roleplay_character_new') }}" class="alert-link">
                                Créer un personnage
                            </a> pour créer une scène RP.
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.maxParticipants) }}
            {{ form_widget(form.maxParticipants, {
                'attr': {
                    'class': 'form-control',
                    'min': isNew ? '2' : thread.participants|length
                }
            }) }}
            {{ form_errors(form.maxParticipants) }}
            <small class="form-text text-muted">
                {% if isNew == false and thread.participants|length > 0 %}
                    Minimum : {{ thread.participants|length }} (participants actuels)
                {% endif %}
                Laissez vide pour un nombre illimité de participants
            </small>
        </div>

        <div class="mb-3">
            {{ form_label(form.location) }}
            {{ form_widget(form.location, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.location) }}
        </div>

        {% if isNew %}
            <div class="mb-3">
                {{ form_label(form.npcs) }}
                {{ form_widget(form.npcs, {'attr': {'class': 'form-select', 'data-select2': 'true'}}) }}
                {{ form_errors(form.npcs) }}
                <small class="form-text text-muted">
                    Sélectionnez les PNJ qui participeront à cette scène
                </small>
            </div>
        {% endif %}
        
        {% if form.factions is defined %}
            <div class="mb-3">
                {{ form_label(form.factions) }}
                {{ form_widget(form.factions, {'attr': {'class': 'form-select', 'data-select2': 'true'}}) }}
                {{ form_errors(form.factions) }}
                <small class="form-text text-muted">
                    Sélectionnez les factions liées à cette scène
                </small>
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_widget(form.visibleToCharactersOnly, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.visibleToCharactersOnly, null, {'label_attr': {'class': 'form-check-label'}}) }}
            {{ form_errors(form.visibleToCharactersOnly) }}
            <small class="form-text text-muted d-block">
                Si activé, seuls les personnages participants pourront voir cette scène
            </small>
        </div>
    {% endif %}

    {% if form.description is defined %}
        <div class="mb-3">
            {{ form_label(form.description, isNew ? 'Description initiale' : 'Description') }}
            {{ form_widget(form.description, {
                'attr': {
                    'class': 'form-control wysiwyg-editor',
                    'rows': 10,
                    'data-mode': isRoleplay ? 'roleplay' : 'hrp'
                }
            }) }}
            {{ form_errors(form.description) }}
            {% if isNew %}
                <small class="form-text text-muted">
                    {% if isRoleplay %}
                        Décrivez le contexte et la situation initiale de votre scène
                    {% else %}
                        Présentez le sujet de votre discussion
                    {% endif %}
                </small>
            {% endif %}
        </div>
    {% endif %}

    {% if form.firstPostContent is defined and isNew %}
        <div class="mb-3">
            {{ form_label(form.firstPostContent) }}
            {{ form_widget(form.firstPostContent, {
                'attr': {
                    'class': 'form-control wysiwyg-editor',
                    'rows': 10,
                    'data-mode': isRoleplay ? 'roleplay' : 'hrp'
                }
            }) }}
            {{ form_errors(form.firstPostContent) }}
        </div>
    {% endif %}

    {% if is_granted('ROLE_MODERATOR') %}
        <div class="mb-3">
            {{ form_widget(form.sticky, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.sticky, null, {'label_attr': {'class': 'form-check-label'}}) }}
        </div>
        
        {% if form.status is defined %}
            <div class="mb-3">
                {{ form_label(form.status) }}
                {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.status) }}
                <small class="form-text text-muted">
                    Un thread fermé n'accepte plus de nouveaux participants
                </small>
            </div>
        {% endif %}
    {% endif %}

    <div class="d-flex justify-content-between">
        <div>
            <a href="{{ returnPath }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
            {% if not isNew and is_granted('DELETE', thread) %}
                <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteThreadModal">
                    <i class="fas fa-trash-alt me-2"></i>Supprimer
                </button>
            {% endif %}
        </div>
        <button type="submit" class="btn {% if isRoleplay %}btn-roleplay{% else %}btn-hrp{% endif %}">
            <i class="fas fa-save me-2"></i>{{ isNew ? 'Créer la discussion' : 'Enregistrer les modifications' }}
        </button>
    </div>
{{ form_end(form) }} 