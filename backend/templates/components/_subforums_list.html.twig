{% if subForums is defined and subForums|length > 0 %}
    <div class="subforums-section mb-5">
        <h2 class="section-title {% if forumIsRoleplay is defined and forumIsRoleplay %}rp-forums{% else %}hrp-forums{% endif %}">
            <i class="fas fa-folder"></i> Sous-forums
        </h2>
        <div class="subforums-list">
            {% for subforum in subForums %}
                {% include 'components/_forum_card.html.twig' with {'forum': subforum} %}
            {% endfor %}
        </div>
    </div>
{% endif %}