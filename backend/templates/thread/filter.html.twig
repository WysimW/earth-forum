{% extends 'base.html.twig' %}

{% block title %}{{ title }} - DC Earth{% endblock %}

{% block body %}
<div class="container my-4">
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    <div class="row">
        {# Sidebar avec les filtres #}
        <div class="col-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h3 class="h5 mb-0">Filtres</h3>
                </div>
                <div class="card-body">
                    <div class="nav flex-column nav-pills">
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': 'all'}) }}" 
                           class="nav-link {% if type == 'all' %}active{% endif %}">
                            <i class="fas fa-list me-2"></i>Toutes les discussions
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': 'participating'}) }}" 
                           class="nav-link {% if type == 'participating' %}active{% endif %}">
                            <i class="fas fa-user-friends me-2"></i>Mes participations
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': 'created'}) }}" 
                           class="nav-link {% if type == 'created' %}active{% endif %}">
                            <i class="fas fa-pencil-alt me-2"></i>Mes créations
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': 'recent'}) }}" 
                           class="nav-link {% if type == 'recent' %}active{% endif %}">
                            <i class="fas fa-clock me-2"></i>Discussions récentes
                        </a>
                    </div>

                    <hr>

                    <h4 class="h6 mb-2">État</h4>
                    <div class="nav flex-column nav-pills">
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': type}) }}" 
                           class="nav-link {% if status is empty %}active{% endif %}">
                            <i class="fas fa-globe me-2"></i>Tous
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': type, 'status': 'open'}) }}" 
                           class="nav-link {% if status == 'open' %}active{% endif %}">
                            <i class="fas fa-door-open me-2"></i>Ouvertes
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': type, 'status': 'closed'}) }}" 
                           class="nav-link {% if status == 'closed' %}active{% endif %}">
                            <i class="fas fa-lock me-2"></i>Fermées
                        </a>
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug, 'type': type, 'status': 'archived'}) }}" 
                           class="nav-link {% if status == 'archived' %}active{% endif %}">
                            <i class="fas fa-archive me-2"></i>Archivées
                        </a>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_choose_forum_new_thread', {'universeSlug': univers.slug}) }}" class="btn bg-roleplay text-white w-100">
                    <i class="fas fa-plus-circle me-2"></i>Créer une discussion
                </a>
            {% endif %}
        </div>

        {# Liste des discussions #}
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="h3 mb-0">{{ title }}</h1>
                        </div>
                        <div class="col-auto">
                            <form class="d-flex gap-2" action="{{ path('app_roleplay_search') }}" method="get">
                                <input type="text" name="q" class="form-control form-control-sm" 
                                       placeholder="Rechercher..." value="{{ app.request.query.get('q') }}">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="fas fa-search"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="list-group list-group-flush">
                    {% for thread in threads %}
                        <a href="{{ path('app_thread_show', {'universeSlug': univers.slug, 'id': thread.id}) }}" 
                           class="list-group-item list-group-item-action p-3 {% if thread.sticky %}bg-light{% endif %}">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="thread-main flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        {% if thread.sticky %}
                                            <i class="fas fa-thumbtack text-warning" title="Épinglé"></i>
                                        {% endif %}
                                        
                                        <h5 class="mb-0">{{ thread.title }}</h5>

                                        {% if thread.type == 'roleplay' %}
                                            <span class="badge bg-roleplay">RP</span>
                                        {% else %}
                                            <span class="badge bg-hrp">HRP</span>
                                        {% endif %}

                                        {% if thread.status != 'open' %}
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-lock me-1"></i>Fermé
                                            </span>
                                        {% endif %}
                                    </div>

                                    <p class="text-muted mb-2">
                                        {{ thread.description|striptags|u.truncate(150, '...') }}
                                    </p>

                                    <div class="thread-meta small text-muted">
                                        <span class="me-3">
                                            <i class="fas fa-user me-1"></i>
                                            {% if thread.type == 'roleplay' and thread.characterCreator %}
                                                <span class="character-name">{{ thread.characterCreator.name }}</span>
                                            {% else %}
                                                {{ thread.author.pseudo }}
                                            {% endif %}
                                        </span>

                                        {% if thread.forum %}
                                            <span class="me-3">
                                                <i class="fas fa-folder me-1"></i>{{ thread.forum.name }}
                                            </span>
                                        {% endif %}

                                        {% if thread.location %}
                                            <span class="me-3">
                                                <i class="fas fa-map-marker-alt me-1"></i>{{ thread.location.name }}
                                            </span>
                                        {% endif %}
                                        
                                        <span class="me-3">
                                            <i class="fas fa-clock me-1"></i>{{ thread.updatedAt|date('d/m/Y H:i') }}
                                        </span>
                                    </div>
                                </div>

                                <div class="thread-stats text-end ms-3">
                                    <div class="mb-1">
                                        <span class="badge bg-light text-dark" title="Réponses">
                                            <i class="fas fa-comments me-1"></i>{{ thread.posts|length - 1 }}
                                        </span>
                                    </div>

                                    {% if thread.type == 'roleplay' %}
                                        <div>
                                            <span class="badge bg-light text-dark" title="Participants">
                                                <i class="fas fa-users me-1"></i>
                                                {% if thread.maxParticipants %}
                                                    {{ thread.participants|length }}/{{ thread.maxParticipants }}
                                                {% else %}
                                                    {{ thread.participants|length }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <div class="text-center py-5">
                            <div class="empty-state">
                                <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                                <h3>Aucune discussion trouvée</h3>
                                <p class="text-muted mb-3">
                                    {% if type == 'participating' %}
                                        Vous ne participez à aucune discussion
                                        {% if status %}avec le statut "{{ status }}"{% endif %}.
                                    {% elseif type == 'created' %}
                                        Vous n'avez créé aucune discussion
                                        {% if status %}avec le statut "{{ status }}"{% endif %}.
                                    {% else %}
                                        Aucune discussion ne correspond aux critères sélectionnés.
                                    {% endif %}
                                </p>

                                {% if is_granted('ROLE_USER') %}
                                    <a href="{{ path('app_choose_forum_new_thread', {'universeSlug': univers.slug}) }}" class="btn btn-primary">
                                        <i class="fas fa-plus-circle me-2"></i>Créer une nouvelle discussion
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.character-name {
    color: var(--roleplay-primary);
    font-weight: 600;
}
.thread-stats {
    min-width: 100px;
}
.empty-state {
    color: #6c757d;
}
.nav-link.active {
    background-color: var(--roleplay-primary) !important;
}
.nav-link:not(.active):hover {
    background-color: var(--roleplay-light);
    color: var(--roleplay-primary);
}
</style>
{% endblock %}