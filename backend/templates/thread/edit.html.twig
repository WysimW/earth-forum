{% extends 'base.html.twig' %}

{% block title %}Modifier une discussion{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-dark text-white">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-edit me-2"></i> Modifier la discussion
                    </h1>
                </div>
                <div class="card-body">
                    {% include 'components/_thread_form.html.twig' with {
                        'form': form,
                        'isNew': false,
                        'isRoleplay': isRpThread,
                        'thread': thread,
                        'returnPath': path('app_thread_show', {'universeSlug': univers.slug, 'id': thread.id})
                    } %}
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'components/_thread_styles.html.twig' %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeWysiwygEditors();
            
            // Initialisation pour les sélecteurs multiples avec select2
            if (document.querySelector('[data-select2]')) {
                const selects = document.querySelectorAll('[data-select2]');
                selects.forEach(select => {
                    $(select).select2({
                        width: '100%',
                        placeholder: 'Sélectionnez...',
                        allowClear: true
                    });
                });
            }
        });
    </script>
{% endblock %}