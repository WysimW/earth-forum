{% extends 'base.html.twig' %}

{% block title %}
    Modifier {{ thread.title }}
{% endblock %}

{% block body %}
<div class="container my-4">
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    <div class="card shadow-sm">
        <div class="card-header {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %} text-white">
            <h1 class="h3 mb-0">
                {% if thread.type == 'roleplay' %}
                    <i class="fa-solid fa-dice-d20 me-2"></i>Modifier la scène
                {% else %}
                    <i class="fas fa-edit me-2"></i>Modifier la discussion
                {% endif %}
            </h1>
        </div>

        <div class="card-body">
            {% include 'components/_thread_form.html.twig' with {
                'form': form,
                'isNew': false,
                'isRoleplay': thread.type == 'roleplay',
                'thread': thread,
                'returnPath': path('app_thread_show', {'universeSlug': univers.slug, 'id': thread.id})
            } %}
        </div>
    </div>

    {% include 'components/_delete_thread_modal.html.twig' with {'thread': thread, 'univers': univers} %}
</div>

{% include 'components/_thread_styles.html.twig' %}
{% endblock %}