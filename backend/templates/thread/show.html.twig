{% extends 'base.html.twig' %}

{% block title %}{{ thread.title }} - DC Earth{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/editor.css') }}">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="thread-show container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    {# En-tête du thread #}
    <div class="thread-header {% if thread.type == 'roleplay' %}roleplay-bg{% else %}hrp-bg{% endif %} glass-panel mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h1 class="thread-title mb-0">{{ thread.title }}</h1>
            <div class="thread-badges">
                {% if thread.sticky %}
                    <span class="badge bg-warning" title="Épinglé">
                        <i class="fas fa-thumbtack"></i> Épinglé
                    </span>
                {% endif %}
                
                {% if thread.status == 'closed' %}
                    <span class="badge bg-secondary" title="Fermé">
                        <i class="fas fa-lock"></i> Fermé
                    </span>
                {% endif %}
                
                <span class="badge {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %}" title="Type de discussion">
                    {% if thread.type == 'roleplay' %}
                        <i class="fa-solid fa-dice-d20"></i> RP
                    {% else %}
                        <i class="fas fa-comments"></i> HRP
                    {% endif %}
                </span>
            </div>
        </div>
        
        <div class="thread-metadata mb-3">
            <div class="row small">
                <div class="col-md-7">
                    <span class="me-3">
                        <i class="fas fa-user me-1"></i> Créée par: 
                        {% if thread.type == 'roleplay' and thread.characterCreator %}
                            <span class="character-name">{{ thread.characterCreator.name }}</span> ({{ thread.author.pseudo }})
                        {% else %}
                            {{ thread.author.pseudo }}
                        {% endif %}
                    </span>
                    <span class="me-3">
                        <i class="fas fa-calendar me-1"></i> {{ thread.createdAt|date('d/m/Y H:i') }}
                    </span>
                </div>
                <div class="col-md-5 text-md-end">
                    <span class="me-3">
                        <i class="fas fa-comments me-1"></i> {{ thread.posts|length }} réponses
                    </span>
                    <span>
                        <i class="fas fa-eye me-1"></i> {{ thread.viewCount ?? 0 }} vues
                    </span>
                </div>
            </div>
        </div>
        
        {% if thread.description %}
        <div class="thread-description mb-2">
            {{ thread.description|raw }}
        </div>
        {% endif %}
        
        <div class="thread-details">
            {% if thread.location %}
                <span class="badge bg-info me-2" title="Lieu">
                    <i class="fas fa-map-marker-alt me-1"></i> {{ thread.location.name }}
                </span>
            {% endif %}
            
            {% if thread.type == 'roleplay' and thread.visibleToCharactersOnly %}
                <span class="badge bg-dark" title="Visibilité">
                    <i class="fas fa-user-shield me-1"></i> Visible uniquement par les personnages participants
                </span>
            {% endif %}
        </div>
    </div>
    
    {# Actions rapides #}
    <div class="thread-actions d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_forum_show', {'id': thread.forum.id}) }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour au forum
            </a>
            
            {% if canReply %}
                <a href="#replyForm" class="btn {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %} text-white ms-2">
                    <i class="fas fa-reply me-1"></i> Répondre
                </a>
                
                <a href="{{ path('app_post_new', {'threadId': thread.id}) }}" class="btn btn-outline-primary ms-2">
                    <i class="fas fa-edit me-1"></i> Rédaction complète
                </a>
            {% endif %}
            
            {% if app.user %}
                <a href="{{ path('app_my_drafts') }}" class="btn btn-outline-secondary ms-2">
                    <i class="fas fa-save me-1"></i> Mes brouillons
                </a>
            {% endif %}
        </div>
        
        <div class="btn-group">
            {% if is_granted('EDIT', thread) %}
                <a href="{{ path('app_thread_edit', {'id': thread.id}) }}" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
            {% endif %}
            
            {% if is_granted('DELETE', thread) %}
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteThreadModal">
                    <i class="fas fa-trash-alt me-1"></i> Supprimer
                </button>
            {% endif %}
            
            {% if is_granted('MANAGE', thread) %}
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog me-1"></i> Gérer
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if thread.status == 'open' %}
                            <li>
                                <a href="{{ path('app_thread_close', {'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock me-1"></i> Fermer la discussion
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_open', {'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock-open me-1"></i> Rouvrir la discussion
                                </a>
                            </li>
                        {% endif %}
                        
                        {% if thread.sticky %}
                            <li>
                                <a href="{{ path('app_thread_unstick', {'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack fa-rotate-90 me-1"></i> Désépingler
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_stick', {'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack me-1"></i> Épingler
                                </a>
                            </li>
                        {% endif %}
                        
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('app_thread_move', {'id': thread.id}) }}" class="dropdown-item">
                                <i class="fas fa-exchange-alt me-1"></i> Déplacer
                            </a>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    {# Liste des posts #}
    <div class="posts-container" id="posts">
        {# Affichage du premier post (message initial) #}
        {% for post in posts %}
            <div class="post-anchor" id="post-{{ post.id }}"></div>
            <div class="post-container {% if post.isRoleplay %}roleplay-theme{% else %}hrp-theme{% endif %} mb-4 {% if app.request.get('highlight') == post.id %}highlighted-post{% endif %} {% if post.isDraft %}draft-post{% endif %}">
                {% if post.isDraft %}
                    <div class="draft-badge">
                        <span class="badge bg-warning">Brouillon</span>
                    </div>
                {% endif %}
                
                <div class="post-sidebar">
                    {% if post.isRoleplay and post.character %}
                        <div class="avatar-container">
                            {% if post.character.avatar %}
                                <img src="{{ post.character.avatar }}" alt="{{ post.character.name }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user-astronaut"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="character-info">
                            <div class="name-label">{{ post.character.name }}</div>
                            {% if post.character.actualPseudo %}
                                <div class="character-alias">{{ post.character.actualPseudo }}</div>
                            {% endif %}
                            <div class="player-name">Joueur: {{ post.author.pseudo }}</div>
                        </div>
                    {% else %}
                        <div class="avatar-container">
                            {% if post.author.avatar %}
                                <img src="{{ post.author.avatar }}" alt="{{ post.author.pseudo }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="user-info">
                            <div class="name-label">{{ post.author.pseudo }}</div>
                            <div class="player-since">Membre depuis {{ post.author.createdAt|date('d/m/Y') }}</div>
                        </div>
                    {% endif %}
                </div>
                
                <div class="post-main">
                    <div class="post-header">
                        <div class="post-meta">
                            <span class="post-date">
                                <i class="fas fa-calendar-alt me-1"></i>
                                {{ post.createdAt|date('d/m/Y à H:i') }}
                            </span>
                            <span class="post-id">
                                <i class="fas fa-hashtag me-1"></i>
                                <a href="#post-{{ post.id }}" class="text-reset">#{{ post.id }}</a>
                            </span>
                        </div>
                        
                        <div class="post-actions">
                            {% if is_granted('EDIT', post) %}
                                <a href="{{ path('app_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                            {% endif %}
                            
                            {% if is_granted('DELETE', post) %}
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#deletePostModal" 
                                        data-post-id="{{ post.id }}">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            {% endif %}
                            
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#post-{{ post.id }}">
                                            <i class="fas fa-link me-2"></i> Lien permanent
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_post_quote', {'id': post.id}) }}">
                                            <i class="fas fa-quote-right me-2"></i> Citer
                                        </a>
                                    </li>
                                    {% if is_granted('ROLE_MODERATOR') %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="#">
                                                <i class="fas fa-exclamation-triangle me-2"></i> Modérer
                                            </a>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="post-content">
                        {{ post.content|raw }}
                    </div>
                    
                    {% if post.editedAt and post.editedAt != post.createdAt %}
                        <div class="post-edited">
                            <small>
                                <em>Édité le {{ post.editedAt|date('d/m/Y à H:i') }}</em>
                            </small>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    {# Formulaire de réponse (si l'utilisateur peut répondre) #}
    {% if canReply %}
        <div class="reply-section mt-4" id="replyForm">
            <h3 class="mb-3">
                <i class="fas fa-reply me-2"></i> 
                Répondre à cette discussion
            </h3>
            
            {% if thread.type == 'roleplay' %}
                {{ render(controller('App\\Controller\\PostController::replyForm', { 'threadId': thread.id })) }}
            {% else %}
                {{ render(controller('App\\Controller\\PostController::replyHrpForm', { 'threadId': thread.id })) }}
            {% endif %}
        </div>
    {% elseif not app.user %}
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour participer à cette discussion.
        </div>
    {% elseif thread.status == 'closed' %}
        <div class="alert alert-warning mt-4">
            <i class="fas fa-lock me-2"></i>
            Cette discussion est fermée et n'accepte plus de nouvelles réponses.
        </div>
    {% endif %}
</div>

{% if is_granted('DELETE', thread) %}
    {# Modal de confirmation de suppression du thread #}
    <div class="modal fade" id="deleteThreadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer cette discussion ? Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <a href="{{ path('app_thread_delete', {'id': thread.id}) }}" class="btn btn-danger">Supprimer</a>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{# Modal de confirmation de suppression d'un post #}
<div class="modal fade" id="deletePostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer ce message ? Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <a href="#" id="deletePostLink" class="btn btn-danger">Supprimer</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Highlight anchor position
            if (window.location.hash) {
                const targetElement = document.querySelector(window.location.hash);
                if (targetElement) {
                    targetElement.scrollIntoView();
                }
            }
            
            // Handle delete post modal
            const deletePostModal = document.getElementById('deletePostModal');
            if (deletePostModal) {
                deletePostModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const postId = button.getAttribute('data-post-id');
                    const deleteLink = document.getElementById('deletePostLink');
                    deleteLink.href = '{{ path('app_post_delete', {'id': 'POST_ID'}) }}'.replace('POST_ID', postId);
                });
            }
            
            // Initialize Quill editor if it exists
            const editorContainer = document.getElementById('editor-container');
            if (editorContainer) {
                const quill = new Quill('#editor-container', {
                    modules: {
                        toolbar: [
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['link', 'image'],
                            ['clean']
                        ]
                    },
                    placeholder: 'Rédigez votre réponse...',
                    theme: 'snow'
                });
                
                // Update hidden form field before submit
                const form = document.querySelector('.reply-form');
                if (form) {
                    form.addEventListener('submit', function() {
                        const contentInput = document.getElementById('post_content');
                        contentInput.value = quill.root.innerHTML;
                    });
                }
            }
        });
    </script>
{% endblock %}