{% extends 'base.html.twig' %}

{% block title %}{{ thread.title }} - DC Earth{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/editor.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/posts.css') }}">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        /* Styles pour les notices de modération */
        .moderation-notice {
            border-left: var(--spacing-xs) solid;
            font-size: 0.95rem;
            margin: var(--spacing-sm) 0;
        }
        
        .moderation-notice.alert-warning {
            border-left-color: var(--warning);
            background-color: rgba(255, 193, 7, 0.1);
        }
        
        .moderation-notice.alert-info {
            border-left-color: var(--info);
            background-color: rgba(13, 202, 240, 0.1);
        }
        
        .moderation-notice.alert-danger {
            border-left-color: var(--danger);
            background-color: rgba(220, 53, 69, 0.1);
        }
        
        .moderation-notice.alert-success {
            border-left-color: var(--success);
            background-color: rgba(25, 135, 84, 0.1);
        }
        
        /* Style pour les posts masqués */
        .post-container[data-is-hidden="true"] {
            opacity: 0.7;
            border-left: 4px solid var(--danger);
        }
        
        .post-container[data-is-hidden="true"]:hover {
            opacity: 1;
        }
        
        .moderation-notice .d-flex i {
            font-size: 1.1rem;
        }
        
        /* Styles pour le modal de modération */
        .post-preview-content {
            font-size: 0.9rem;
            line-height: 1.5;
            user-select: text;
            -webkit-user-select: text;
            -moz-user-select: text;
            -ms-user-select: text;
            cursor: text;
            padding: 0.5rem;
            border-radius: 0.375rem;
            transition: background-color 0.2s ease;
        }
        
        .post-preview-content:hover {
            background-color: rgba(0, 123, 255, 0.05);
        }
        
        .post-preview-content::selection {
            background-color: #007bff;
            color: white;
            text-shadow: none;
        }
        
        .post-preview-content::-moz-selection {
            background-color: #007bff;
            color: white;
            text-shadow: none;
        }
        
        /* Sélection pour tous les éléments dans l'aperçu */
        .post-preview-content *::selection {
            background-color: #007bff;
            color: white;
            text-shadow: none;
        }
        
        .post-preview-content *::-moz-selection {
            background-color: #007bff;
            color: white;
            text-shadow: none;
        }
        
        /* Style spécial pour la sélection active */
        .post-preview-content.selecting {
            background-color: rgba(0, 123, 255, 0.08);
            border: 2px dashed #007bff;
        }
        
        .blockquote-sm {
            font-size: 0.875rem;
            background-color: rgba(0, 0, 0, 0.03);
            padding: 0.5rem;
            border-radius: 0.25rem;
            margin: 0.5rem 0;
        }
        
        .modal-xl .card-body {
            scrollbar-width: thin;
            scrollbar-color: rgba(var(--primary-rgb), 0.3) transparent;
        }
        
        .modal-xl .card-body::-webkit-scrollbar {
            width: 6px;
        }
        
        .modal-xl .card-body::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .modal-xl .card-body::-webkit-scrollbar-thumb {
            background-color: rgba(var(--primary-rgb), 0.3);
            border-radius: 3px;
        }
        
        .modal-xl .card-body::-webkit-scrollbar-thumb:hover {
            background-color: rgba(var(--primary-rgb), 0.5);
        }
        
        /* Animation pour les boutons du modal */
        #selectAllBtn, #quoteSelectedBtn, #clearQuoteBtn {
            transition: all 0.2s ease;
        }
        
        #selectAllBtn:hover {
            transform: translateY(-1px);
        }
        
        #quoteSelectedBtn {
            min-width: 160px;
            width: 160px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
        }
        
        #quoteSelectedBtn:enabled {
            animation: pulse-success 2s infinite;
        }
        
        @keyframes pulse-success {
            0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.4); }
            70% { box-shadow: 0 0 0 5px rgba(40, 167, 69, 0); }
            100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
        }
        
        /* Animation pour l'état de sélection */
        .post-preview-content.selecting {
            animation: selecting-glow 1.5s ease-in-out infinite alternate;
        }
        
        @keyframes selecting-glow {
            from {
                border-color: #007bff;
                box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
            }
            to {
                border-color: #0056b3;
                box-shadow: 0 0 10px rgba(0, 123, 255, 0.5);
            }
        }
        
        /* Amélioration des liens dans les messages de modération */
        .moderation-notice a {
            color: inherit;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        
        .moderation-notice a:hover {
            text-decoration: underline;
            color: var(--primary-dark);
        }
        
        .moderation-notice a i {
            transition: transform 0.2s ease;
        }
        
        .moderation-notice a:hover i {
            transform: translateX(2px);
        }
    </style>
{% endblock %}

{% block body %}
<div class="thread-show container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

        {# En-tête du thread avec accordéons #}
    <div class="thread-header {% if thread.type == 'roleplay' %}roleplay-bg{% else %}hrp-bg{% endif %} mb-4">
        {# Titre principal et badges - toujours visibles #}
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="thread-title-container">
                <h1 class="thread-title mb-2">{{ thread.title }}</h1>
                {% if thread.location %}
                    <div class="thread-location mb-2">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>
                        <span class="location-name">{{ thread.location.name }}</span>
                    </div>
                {% endif %}
            </div>
            <div class="thread-badges">
                {% if thread.sticky %}
                    <span class="badge bg-warning" title="Épinglé">
                        <i class="fas fa-thumbtack me-1"></i> Épinglé
                    </span>
                {% endif %}
                
                {% if thread.status == 'closed' %}
                    <span class="badge bg-secondary" title="Fermé">
                        <i class="fas fa-lock me-1"></i> Fermé
                    </span>
                {% endif %}
                
                <span class="badge {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %}" title="Type de discussion">
                    {% if thread.type == 'roleplay' %}
                        <i class="fa-solid fa-dice-d20 me-1"></i> RP
                    {% else %}
                        <i class="fas fa-comments me-1"></i> HRP
                    {% endif %}
                </span>
                
                {% if thread.participants|length > 0 %}
                    <span class="badge bg-info" title="Participants">
                        <i class="fas fa-users me-1"></i> {{ thread.participants|length }}
                    </span>
                {% endif %}
            </div>
        </div>
        
        {# Accordéons pour les détails #}
        <div class="thread-accordion">
            {# Accordéon Informations de base #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadInfoAccordion" aria-expanded="true">
                    <span class="accordion-title">
                        <i class="fas fa-info-circle me-2"></i>
                        Informations de base
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadInfoAccordion" class="collapse show">
                    <div class="thread-accordion-content">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="thread-author-info d-flex align-items-center">
                                    {% if thread.type == 'roleplay' and thread.characterCreator and thread.characterCreator.avatar %}
                                        <img src="{{ thread.characterCreator.avatar }}" alt="{{ thread.characterCreator.name }}" class="thread-author-avatar me-2">
                                    {% elseif thread.author and thread.author.avatar %}
                                        <img src="{{ thread.author.avatar }}" alt="{{ thread.author.pseudo }}" class="thread-author-avatar me-2">
                                    {% else %}
                                        <div class="thread-author-avatar-placeholder me-2">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <div class="thread-author-details">
                                            <i class="fas fa-user me-1 text-muted"></i> Créée par : 
                                            {% if thread.type == 'roleplay' and thread.characterCreator %}
                                                <span class="thread-show--character-name text-primary">{{ thread.characterCreator.name }}</span>
                                                {% if thread.author %}
                                                    <span class="text-muted">({{ thread.author.pseudo }})</span>
                                                {% endif %}
                                            {% else %}
                                                <span class="thread-author-name">{{ thread.author ? thread.author.pseudo : 'Anonyme' }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="thread-date text-muted">
                                            <i class="fas fa-calendar me-1"></i> {{ thread.createdAt|date('d/m/Y à H:i') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <div class="thread-header-stats">
                                    <div class="thread-stat-item">
                                        <i class="fas fa-comments me-1 text-primary"></i> 
                                        <span class="thread-stat-value">{{ thread.posts|length }}</span>
                                        <span class="thread-stat-label">réponses</span>
                                    </div>
                                    <div class="thread-stat-item">
                                        <i class="fas fa-eye me-1 text-info"></i> 
                                        <span class="thread-stat-value">{{ thread.viewCount ?? 0 }}</span>
                                        <span class="thread-stat-label">vues</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if thread.description %}
            {# Accordéon Description #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadDescAccordion" aria-expanded="false">
                    <span class="accordion-title">
                        <i class="fas fa-align-left me-2"></i>
                        Description
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadDescAccordion" class="collapse">
                    <div class="thread-accordion-content">
                        <div class="thread-description">
                            {{ thread.description|raw }}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
            
            {% if thread.factions is not empty or (thread.type == 'roleplay' and thread.visibleToCharactersOnly) %}
            {# Accordéon Détails avancés #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadDetailsAccordion" aria-expanded="false">
                    <span class="accordion-title">
                        <i class="fas fa-cogs me-2"></i>
                        Détails avancés
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadDetailsAccordion" class="collapse">
                    <div class="thread-accordion-content">
            {% if thread.factions is not empty %}
                            <div class="thread-factions mb-2">
                                <span class="detail-label">
                                    <i class="fas fa-users me-1 text-primary"></i> Factions :
                                </span>
                                <div class="faction-tags">
                    {% for faction in thread.factions %}
                                        <a href="{{ path('app_faction_show', {'universeSlug': faction.universe.slug, 'factionSlug': faction.slug}) }}" 
                                           class="faction-tag">
                                            {{ faction.name }}
                                        </a>
                    {% endfor %}
                                </div>
                            </div>
            {% endif %}
            
            {% if thread.type == 'roleplay' and thread.visibleToCharactersOnly %}
                            <div class="visibility-notice">
                                <i class="fas fa-user-shield me-1 text-warning"></i> 
                                <span class="text-warning">Visible uniquement par les personnages participants</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    {# Actions rapides #}
    <div class="thread-actions d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_forum_show', {'universeSlug': univers.slug, 'id': thread.forum.id}) }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour au forum
            </a>
            
            {% if canReply %}
                <a href="#replyForm" class="btn {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %} text-white ms-2">
                    <i class="fas fa-reply me-1"></i> Répondre
                </a>
                
                <a href="{{ path('app_post_new', {'universeSlug': univers.slug, 'threadId': thread.id}) }}" class="btn btn-outline-primary ms-2">
                    <i class="fas fa-edit me-1"></i> Rédaction complète
                </a>
            {% endif %}
            
            {% if app.user %}
                <a href="{{ path('app_my_drafts', {'universeSlug': univers.slug}) }}" class="btn btn-outline-secondary ms-2">
                    <i class="fas fa-save me-1"></i> Mes brouillons
                </a>
            {% endif %}
        </div>
        
        <div class="btn-group">
            {% if is_granted('EDIT', thread) %}
                <a href="{{ path('app_thread_edit', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
            {% endif %}
            
            {% if is_granted('DELETE', thread) %}
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteThreadModal">
                    <i class="fas fa-trash-alt me-1"></i> Supprimer
                </button>
            {% endif %}
            
            {% if is_granted('MANAGE', thread) %}
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog me-1"></i> Gérer
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if thread.status == 'open' %}
                            <li>
                                <a href="{{ path('app_thread_close', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock me-1"></i> Fermer la discussion
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_open', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock-open me-1"></i> Rouvrir la discussion
                                </a>
                            </li>
                        {% endif %}
                        
                        {% if thread.sticky %}
                            <li>
                                <a href="{{ path('app_thread_unsticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack fa-rotate-90 me-1"></i> Désépingler
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_sticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack me-1"></i> Épingler
                                </a>
                            </li>
                        {% endif %}
                        
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('app_thread_move', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                <i class="fas fa-exchange-alt me-1"></i> Déplacer
                            </a>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    {# Afficher le message de restriction si l'utilisateur est sanctionné #}
    {% if app.user and postingRestriction is defined and postingRestriction is not null %}
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i> {{ postingRestriction.message }}
            {% if postingRestriction.type == 'ban_posting' %}
                Vous pouvez consulter l'<a href="{{ path('app_user_my_sanctions') }}">historique de vos sanctions</a> pour plus d'informations.
            {% endif %}
        </div>
    {% endif %}

    {# Liste des posts #}
    <div class="posts-container" id="posts">
        {# Affichage du premier post (message initial) #}
        {% for post in posts %}
            <div class="post-anchor" id="post-{{ post.id }}"></div>
            <div class="post-container {% if post.isRoleplay %}roleplay-theme{% else %}hrp-theme{% endif %} mb-4 {% if app.request.get('highlight') == post.id %}highlighted-post{% endif %} {% if post.isDraft %}draft-post{% endif %}" data-post-id="{{ post.id }}" data-is-hidden="{{ post.isHidden ? 'true' : 'false' }}">
                {% if post.isDraft %}
                    <div class="draft-badge">
                        <span class="badge bg-warning">Brouillon</span>
                    </div>
                {% endif %}
                
                <div class="post-sidebar">
                    {% if post.isRoleplay and post.character %}
                        <div class="avatar-container">
                            {% if post.character.avatar %}
                                <img src="{{ post.character.avatar }}" alt="{{ post.character.name }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user-astronaut"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="post-character-info">
                            <div class="name-label">{{ post.character.name }}</div>
                            {% if post.character.actualPseudo %}
                                <div class="character-alias">{{ post.character.actualPseudo }}</div>
                            {% endif %}
                            {% if post.author %}
                            <div class="player-name">Joueur: {{ post.author.pseudo }}</div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="avatar-container">
                            {% if post.author and post.author.avatar %}
                                <img src="{{ post.author.avatar }}" alt="{{ post.author.pseudo }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="post-user-info">
                            <div class="name-label">{{ post.author ? post.author.pseudo : 'Anonyme' }}</div>
                            {% if post.author %}
                            <div class="player-since">Membre depuis {{ post.author.createdAt|date('d/m/Y') }}</div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Affichage des PNJ associés au post #}
                    {% if post.npcs|length > 0 %}
                        <div class="post-npcs-info mt-3">
                            <div class="post-npcs-label">
                                <i class="fas fa-users me-1"></i> PNJ présents
                            </div>
                            <div class="post-npcs-list">
                                {% for npc in post.npcs %}
                                    <div class="npc-item">
                                        <div class="npc-avatar">
                                            {% if npc.avatar %}
                                                <img src="{{ npc.avatar }}" alt="{{ npc.name }}" class="img-fluid rounded">
                                            {% else %}
                                                <div class="default-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="npc-name">{{ npc.name }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                
                <div class="post-main">
                    <div class="post-header">
                        <div class="post-meta">
                            <span class="post-date">
                                <i class="fas fa-calendar-alt me-1"></i>
                                {{ post.createdAt|date('d/m/Y à H:i') }}
                                {% if post.editedAt and post.editedAt != post.createdAt %}
                                    <span class="post-edited-indicator">
                                        <i class="fas fa-edit me-1 text-warning"></i>
                                        <small class="text-muted">Édité le {{ post.editedAt|date('d/m/Y à H:i') }}</small>
                                    </span>
                                {% endif %}
                            </span>
                            <span class="post-id">
                                <a href="#post-{{ post.id }}" class="text-reset">#{{ post.id }}</a>
                            </span>
                        </div>
                        
                        <div class="post-actions">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#post-{{ post.id }}">
                                            <i class="fas fa-link me-2"></i> Lien permanent
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_post_quote', {'universeSlug': univers.slug, 'id': post.id}) }}">
                                            <i class="fas fa-quote-right me-2"></i> Citer
                                        </a>
                                    </li>
                                    {% if is_granted('EDIT', post) %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_post_edit', {'universeSlug': univers.slug, 'id': post.id}) }}">
                                            <i class="fas fa-edit me-2"></i> Modifier
                                        </a>
                                    </li>
                                    {% endif %}
                                    {% if is_granted('DELETE', post) %}
                                    <li>
                                        <button type="button" class="dropdown-item text-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deletePostModal" 
                                                data-post-id="{{ post.id }}">
                                            <i class="fas fa-trash-alt me-2"></i> Supprimer
                                        </button>
                                    </li>
                                    {% endif %}
                                    {% if is_granted('ROLE_MODERATOR') %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" 
                                                    class="dropdown-item text-warning" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#moderatePostModal"
                                                    data-post-id="{{ post.id }}">
                                                <i class="fas fa-exclamation-triangle me-2"></i> Modérer
                                            </button>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="post-content">
                        {{ post.content|decode_html|raw }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Formulaire de réponse (si l'utilisateur peut répondre) #}
    {% if canReply %}
            {% if thread.type == 'roleplay' %}
                {{ render(controller('App\\Controller\\PostController::replyForm', { 'universeSlug': univers.slug, 'threadId': thread.id })) }}
            {% else %}
                {{ render(controller('App\\Controller\\PostController::replyHrpForm', { 'universeSlug': univers.slug, 'threadId': thread.id })) }}
            {% endif %}
    {% elseif not app.user %}
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour participer à cette discussion.
        </div>
    {% elseif thread.status == 'closed' %}
        <div class="alert alert-warning mt-4">
            <i class="fas fa-lock me-2"></i>
            Cette discussion est fermée et n'accepte plus de nouvelles réponses.
        </div>
    {% endif %}
</div>

{% if is_granted('DELETE', thread) %}
    {# Modal de confirmation de suppression du thread #}
    <div class="modal fade" id="deleteThreadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer cette discussion ? Cette action est irréversible.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="POST" action="{{ path('app_thread_delete', {'universeSlug': univers.slug, 'id': thread.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_thread_' ~ thread.id) }}">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{# Modal de confirmation de suppression d'un post #}
<div class="modal fade" id="deletePostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmer la suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer ce message ? Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="POST" id="deletePostForm" style="display: inline;">
                    <input type="hidden" name="_token" id="deletePostToken">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>

{# Modal de modération d'un post #}
<div class="modal fade" id="moderatePostModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    Modération du message <span id="modalPostId"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" id="moderatePostForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i>
                                Choisissez l'action de modération à appliquer à ce message.
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Action de modération</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="moderation_action" id="warn" value="warn" checked>
                                    <label class="form-check-label" for="warn">
                                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                        Avertissement (message visible par l'auteur)
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="moderation_action" id="edit_request" value="edit_request">
                                    <label class="form-check-label" for="edit_request">
                                        <i class="fas fa-edit text-info me-2"></i>
                                        Demande de modification
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="moderation_action" id="hide" value="hide">
                                    <label class="form-check-label" for="hide">
                                        <i class="fas fa-eye-slash text-danger me-2"></i>
                                        Masquer le message (visible uniquement par les modérateurs)
                                    </label>
                                </div>
                                <div class="form-check" id="unhideOption" style="display: none;">
                                    <input class="form-check-input" type="radio" name="moderation_action" id="unhide" value="unhide">
                                    <label class="form-check-label" for="unhide">
                                        <i class="fas fa-eye text-success me-2"></i>
                                        Démasquer le message
                                    </label>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="moderation_reason" class="form-label fw-bold">Motif de la modération</label>
                                <textarea class="form-control" id="moderation_reason" name="moderation_reason" rows="3" 
                                          placeholder="Expliquez le motif de cette action de modération..." required></textarea>
                                <div class="form-text">
                                    Ce message sera visible par l'auteur du post et les autres modérateurs.
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="internal_note" class="form-label fw-bold">Note interne (optionnel)</label>
                                <textarea class="form-control" id="internal_note" name="internal_note" rows="2" 
                                          placeholder="Note visible uniquement par les modérateurs..."></textarea>
                                <div class="form-text">
                                    Cette note ne sera visible que par les modérateurs.
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">
                                        <i class="fas fa-eye me-1"></i>
                                        Aperçu du message
                                    </h6>
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllBtn">
                                            <i class="fas fa-check-square me-1"></i>
                                            Tout sélectionner
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="quoteSelectedBtn" disabled>
                                            <i class="fas fa-quote-right me-1"></i>
                                            Quoter la sélection
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body" style="max-height: 400px; overflow-y: auto;">
                                    <div class="post-preview-content" id="postPreviewContent">
                                        <!-- Le contenu du message sera injecté ici -->
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-3" id="quotedTextContainer" style="display: none;">
                                <label class="form-label fw-bold">Texte sélectionné :</label>
                                <div class="card">
                                    <div class="card-body bg-light">
                                        <blockquote class="blockquote mb-0" id="quotedText">
                                            <!-- Le texte quoté apparaîtra ici -->
                                        </blockquote>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2" id="clearQuoteBtn">
                                    <i class="fas fa-times me-1"></i>
                                    Effacer la sélection
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <input type="hidden" name="_token" id="moderatePostToken">
                    <input type="hidden" name="quoted_text" id="quotedTextInput">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-gavel me-2"></i>
                        Appliquer la modération
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <!-- <script src="{{ asset('js/dc-editor.js') }}"></script> TEMPORAIREMENT DÉSACTIVÉ -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
                        // === NAVIGATION ===
            // Système d'ancres temporairement désactivé
            
            // === GESTION DES MODALS ===
            
            // Modal de suppression de post
            const deletePostModal = document.getElementById('deletePostModal');
            if (deletePostModal) {
                // Pré-générer les tokens CSRF pour tous les posts
                const csrfTokens = {
                    {% for post in posts %}
                    '{{ post.id }}': '{{ csrf_token('delete_post_' ~ post.id) }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                };
                
                deletePostModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const postId = button.getAttribute('data-post-id');
                    const deleteForm = document.getElementById('deletePostForm');
                    const tokenInput = document.getElementById('deletePostToken');
                    
                    if (deleteForm && postId) {
                        deleteForm.action = '{{ path('app_post_delete', {'universeSlug': univers.slug, 'id': 'POST_ID'}) }}'.replace('POST_ID', postId);
                    }
                    
                    // Utiliser le token CSRF pré-généré
                    if (tokenInput && postId && csrfTokens[postId]) {
                        tokenInput.value = csrfTokens[postId];
                    }
                });
            }
            
            // Modal de modération de post
            const moderatePostModal = document.getElementById('moderatePostModal');
            if (moderatePostModal) {
                // Pré-générer les tokens CSRF pour la modération
                const moderationTokens = {
                    {% for post in posts %}
                    '{{ post.id }}': '{{ csrf_token('moderate_post_' ~ post.id) }}'{% if not loop.last %},{% endif %}
                    {% endfor %}
                };
                
                let currentPostId = null;
                let selectedText = '';
                
                moderatePostModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const postId = button.getAttribute('data-post-id');
                    currentPostId = postId;
                    
                    // Mise à jour du titre avec l'ID du message
                    document.getElementById('modalPostId').textContent = '#' + postId;
                    
                    // Configuration du formulaire
                    const moderateForm = document.getElementById('moderatePostForm');
                    const tokenInput = document.getElementById('moderatePostToken');
                    
                    if (moderateForm && postId) {
                        moderateForm.action = '{{ path('app_post_moderate', {'universeSlug': univers.slug, 'id': 'POST_ID'}) }}'.replace('POST_ID', postId);
                    }
                    
                    // Token CSRF
                    if (tokenInput && postId && moderationTokens[postId]) {
                        tokenInput.value = moderationTokens[postId];
                    }
                    
                    // Gestion de l'affichage des options selon l'état du message
                    const postContainer = document.querySelector('.post-container[data-post-id="' + postId + '"]');
                    const isHidden = postContainer && postContainer.getAttribute('data-is-hidden') === 'true';
                    
                    const hideOption = document.getElementById('hide').parentElement;
                    const unhideOption = document.getElementById('unhideOption');
                    const warnOption = document.getElementById('warn').parentElement;
                    const editRequestOption = document.getElementById('edit_request').parentElement;
                    
                    if (isHidden) {
                        // Si le message est masqué, on affiche uniquement l'option de démasquage
                        hideOption.style.display = 'none';
                        warnOption.style.display = 'none';
                        editRequestOption.style.display = 'none';
                        unhideOption.style.display = 'block';
                        
                        // Sélectionner automatiquement l'option de démasquage
                        document.getElementById('unhide').checked = true;
                        
                        // Modifier le texte d'aide pour le motif
                        const reasonLabel = document.querySelector('label[for="moderation_reason"]');
                        const reasonHelp = reasonLabel.nextElementSibling.nextElementSibling;
                        reasonLabel.textContent = 'Motif du démasquage (optionnel)';
                        reasonHelp.textContent = 'Expliquez pourquoi vous démasquez ce message (optionnel).';
                        
                        // Rendre le champ motif optionnel
                        document.getElementById('moderation_reason').required = false;
                        document.getElementById('moderation_reason').placeholder = 'Raison du démasquage (optionnel)...';
                    } else {
                        // Si le message n'est pas masqué, on affiche les options normales
                        hideOption.style.display = 'block';
                        warnOption.style.display = 'block';
                        editRequestOption.style.display = 'block';
                        unhideOption.style.display = 'none';
                        
                        // Sélectionner l'avertissement par défaut
                        document.getElementById('warn').checked = true;
                        
                        // Restaurer le texte d'aide normal
                        const reasonLabel = document.querySelector('label[for="moderation_reason"]');
                        const reasonHelp = reasonLabel.nextElementSibling.nextElementSibling;
                        reasonLabel.textContent = 'Motif de la modération';
                        reasonHelp.textContent = 'Ce message sera visible par l\'auteur du post et les autres modérateurs.';
                        
                        // Rendre le champ motif obligatoire
                        document.getElementById('moderation_reason').required = true;
                        document.getElementById('moderation_reason').placeholder = 'Expliquez le motif de cette action de modération...';
                    }
                    
                    // Affichage du contenu du message
                    const previewContent = document.getElementById('postPreviewContent');
                    
                    // Indicateur de chargement
                    previewContent.innerHTML = '<div class="text-center"><i class="fas fa-spinner fa-spin me-2"></i>Chargement du contenu...</div>';
                    
                    // Petit délai pour montrer le chargement
                    setTimeout(() => {
                        // Rechercher le post à partir de l'ancre et récupérer le container suivant
                        const postAnchor = document.querySelector('#post-' + postId);
                        const originalPost = postAnchor ? postAnchor.nextElementSibling : null;
                        
                        if (previewContent && originalPost && originalPost.classList.contains('post-container')) {
                            // Récupérer le contenu du message original
                            const postContent = originalPost.querySelector('.post-content');
                            if (postContent) {
                                // Cloner le contenu pour l'aperçu
                                previewContent.innerHTML = postContent.innerHTML;
                                
                                // Récupérer l'auteur du message
                                const authorElement = originalPost.querySelector('.name-label');
                                const authorName = authorElement ? authorElement.textContent.trim() : 'Utilisateur inconnu';
                                previewContent.setAttribute('data-author', authorName);
                                
                                console.log('Contenu du message chargé pour le post #' + postId);
                            } else {
                                previewContent.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>Impossible de charger le contenu du message.</div>';
                            }
                        } else {
                            previewContent.innerHTML = '<div class="alert alert-danger"><i class="fas fa-times me-2"></i>Message introuvable (ID: ' + postId + ').</div>';
                        }
                    }, 100);
                    
                    
                    // Réinitialiser la sélection
                    clearQuotedText();
                    
                    // Activer l'event listener de sélection uniquement dans ce modal
                    selectionListener = function() {
                        updateSelectedText();
                    };
                    document.addEventListener('selectionchange', selectionListener);
                });
                
                // Gestion de la sélection de texte
                function updateSelectedText() {
                    // Ne s'exécuter que si le modal de modération est ouvert
                    if (!moderatePostModal.classList.contains('show')) {
                        return;
                    }
                    
                    const selection = window.getSelection();
                    const previewContent = document.getElementById('postPreviewContent');
                    
                    if (selection.rangeCount > 0 && previewContent && previewContent.contains(selection.anchorNode)) {
                        selectedText = selection.toString().trim();
                        const quoteBtn = document.getElementById('quoteSelectedBtn');
                        
                        if (selectedText.length > 0) {
                            quoteBtn.disabled = false;
                            quoteBtn.classList.remove('btn-outline-secondary');
                            quoteBtn.classList.add('btn-outline-success');
                            previewContent.classList.add('selecting');
                            
                            // Mettre à jour le texte du bouton avec la longueur
                            const originalText = quoteBtn.innerHTML;
                            quoteBtn.innerHTML = `<i class="fas fa-quote-right me-1"></i>Quoter (${selectedText.length} car.)`;
                        } else {
                            quoteBtn.disabled = true;
                            quoteBtn.classList.remove('btn-outline-success');
                            quoteBtn.classList.add('btn-outline-secondary');
                            previewContent.classList.remove('selecting');
                            quoteBtn.innerHTML = '<i class="fas fa-quote-right me-1"></i>Quoter la sélection';
                        }
                    } else {
                        const quoteBtn = document.getElementById('quoteSelectedBtn');
                        if (quoteBtn) {
                            quoteBtn.disabled = true;
                            quoteBtn.classList.remove('btn-outline-success');
                            quoteBtn.classList.add('btn-outline-secondary');
                            if (previewContent) {
                                previewContent.classList.remove('selecting');
                            }
                            quoteBtn.innerHTML = '<i class="fas fa-quote-right me-1"></i>Quoter la sélection';
                        }
                    }
                }
                
                function showQuotedText(text) {
                    const quotedTextContainer = document.getElementById('quotedTextContainer');
                    const quotedText = document.getElementById('quotedText');
                    const quotedTextInput = document.getElementById('quotedTextInput');
                    
                    if (text && text.trim().length > 0) {
                        quotedText.textContent = text;
                        quotedTextInput.value = text;
                        quotedTextContainer.style.display = 'block';
                    }
                }
                
                function clearQuotedText() {
                    const quotedTextContainer = document.getElementById('quotedTextContainer');
                    const quotedTextInput = document.getElementById('quotedTextInput');
                    const quoteBtn = document.getElementById('quoteSelectedBtn');
                    const previewContent = document.getElementById('postPreviewContent');
                    
                    quotedTextContainer.style.display = 'none';
                    quotedTextInput.value = '';
                    selectedText = '';
                    
                    quoteBtn.disabled = true;
                    quoteBtn.classList.remove('btn-outline-success');
                    quoteBtn.classList.add('btn-outline-secondary');
                    quoteBtn.innerHTML = '<i class="fas fa-quote-right me-1"></i>Quoter la sélection';
                    
                    // Enlever l'état visuel de sélection
                    previewContent.classList.remove('selecting');
                    
                    // Effacer la sélection
                    window.getSelection().removeAllRanges();
                }
                
                // Event listeners pour la sélection (uniquement dans le modal)
                let selectionListener = null;
                
                // Bouton "Tout sélectionner"
                document.getElementById('selectAllBtn').addEventListener('click', function() {
                    const previewContent = document.getElementById('postPreviewContent');
                    const range = document.createRange();
                    range.selectNodeContents(previewContent);
                    
                    const selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                    
                    updateSelectedText();
                });
                
                // Bouton "Quoter la sélection"
                document.getElementById('quoteSelectedBtn').addEventListener('click', function() {
                    if (selectedText) {
                        showQuotedText(selectedText);
                    }
                });
                
                // Bouton "Effacer la sélection"
                document.getElementById('clearQuoteBtn').addEventListener('click', clearQuotedText);
                
                // Nettoyer à la fermeture du modal
                moderatePostModal.addEventListener('hidden.bs.modal', function() {
                    clearQuotedText();
                    currentPostId = null;
                    
                    // Réinitialiser les options de modération
                    document.getElementById('unhideOption').style.display = 'none';
                    document.getElementById('hide').parentElement.style.display = 'block';
                    document.getElementById('warn').parentElement.style.display = 'block';
                    document.getElementById('edit_request').parentElement.style.display = 'block';
                    
                    // Restaurer les textes par défaut
                    const reasonLabel = document.querySelector('label[for="moderation_reason"]');
                    const reasonHelp = reasonLabel.nextElementSibling.nextElementSibling;
                    reasonLabel.textContent = 'Motif de la modération';
                    reasonHelp.textContent = 'Ce message sera visible par l\'auteur du post et les autres modérateurs.';
                    
                    // Restaurer l'obligation du champ
                    document.getElementById('moderation_reason').required = true;
                    document.getElementById('moderation_reason').placeholder = 'Expliquez le motif de cette action de modération...';
                    document.getElementById('moderation_reason').value = '';
                    
                    // Désactiver l'event listener de sélection
                    if (selectionListener) {
                        document.removeEventListener('selectionchange', selectionListener);
                        selectionListener = null;
                    }
                });
                
                // Formulaire de modération configuré
            }
            
            // === PROTECTION POUR LES CHAMPS DE TEXTE ===
            
            // Empêcher toute interférence avec les champs de texte et formulaires
            document.addEventListener('click', function(e) {
                // Si c'est un champ de texte, textarea, input ou tout élément de formulaire
                if (e.target.matches('input, textarea, select, button[type="submit"], .form-control, .btn')) {
                    e.stopPropagation();
                    console.log('Clic protégé sur:', e.target.tagName, e.target.type || 'N/A');
                }
            }, true); // Use capture phase
            
            // Protection spécifique pour les focus sur les champs
            document.addEventListener('focus', function(e) {
                if (e.target.matches('input, textarea, select, .form-control')) {
                    e.stopPropagation();
                    console.log('Focus protégé sur:', e.target.tagName);
                }
            }, true);
            
            // Les formulaires de modals devraient maintenant fonctionner normalement
            
            // === AMÉLIORATIONS INTERACTIONS ===
            
            // Animation des avatars au hover
            const avatars = document.querySelectorAll('.avatar-container, .thread-author-avatar, .npc-avatar');
            avatars.forEach(avatar => {
                avatar.addEventListener('mouseenter', function() {
                    this.style.transform = 'scale(1.05) rotateZ(2deg)';
                });
                
                avatar.addEventListener('mouseleave', function() {
                    this.style.transform = 'scale(1) rotateZ(0deg)';
                });
            });
            
            // Smooth scroll temporairement désactivé
            
            // === ANIMATIONS SEQUENTIELLES ===
            
          
            
            // Définir la fonction createRipple si elle n'existe pas
            if (typeof createRipple === 'undefined') {
                window.createRipple = function(event) {
                    const button = event.currentTarget;
                    
                    // Créer l'élément ripple
                    const ripple = document.createElement('span');
                    const rect = button.getBoundingClientRect();
                    const size = Math.max(rect.width, rect.height);
                    const x = event.clientX - rect.left - size / 2;
                    const y = event.clientY - rect.top - size / 2;
                    
                    ripple.className = 'ripple';
                    ripple.style.cssText = `
                        width: ${size}px;
                        height: ${size}px;
                        left: ${x}px;
                        top: ${y}px;
                    `;
                    
                    // S'assurer que le bouton a position relative
                    if (getComputedStyle(button).position === 'static') {
                        button.style.position = 'relative';
                    }
                    
                    // Assurer overflow hidden pour contenir l'effet
                    button.style.overflow = 'hidden';
                    
                    // Ajouter l'effet ripple
                    button.appendChild(ripple);
                    
                    // Supprimer l'effet après l'animation
                    setTimeout(() => {
                        if (ripple.parentNode) {
                            ripple.parentNode.removeChild(ripple);
                        }
                    }, 600);
                };
            }
            
            // Ajouter l'effet ripple aux boutons
            document.querySelectorAll('.btn, .faction-tag, .thread-stat-item').forEach(btn => {
                btn.addEventListener('click', createRipple);
            });
            
            // === NAVIGATION RAPIDE ===
            
            // Bouton "Retour en haut" dynamique
            let backToTopBtn = document.createElement('button');
            backToTopBtn.innerHTML = '<i class="fas fa-arrow-up"></i>';
            backToTopBtn.className = 'back-to-top';
            backToTopBtn.style.cssText = `
                position: fixed;
                bottom: 2rem;
                right: 2rem;
                width: 50px;
                height: 50px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--primary-medium), var(--primary-dark));
                border: none;
                color: white;
                cursor: pointer;
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s ease;
                z-index: 1000;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            `;
            
            document.body.appendChild(backToTopBtn);
            
            // Gestion de l'affichage du bouton
            window.addEventListener('scroll', () => {
                if (window.pageYOffset > 300) {
                    backToTopBtn.style.opacity = '1';
                    backToTopBtn.style.visibility = 'visible';
                } else {
                    backToTopBtn.style.opacity = '0';
                    backToTopBtn.style.visibility = 'hidden';
                }
            });
            
            // Action du bouton
            backToTopBtn.addEventListener('click', () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            });
            
            // Effet hover sur le bouton
            backToTopBtn.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-2px) scale(1.1)';
                this.style.boxShadow = '0 6px 20px rgba(0, 0, 0, 0.3)';
            });
            
            backToTopBtn.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
                this.style.boxShadow = '0 4px 15px rgba(0, 0, 0, 0.2)';
            });
            
            // === STYLE POUR L'EFFET RIPPLE ===
            const rippleStyle = document.createElement('style');
            rippleStyle.textContent = `
                .ripple {
                    position: absolute;
                    border-radius: 50%;
                    background-color: rgba(255, 255, 255, 0.4);
                    transform: scale(0);
                    animation: ripple-animation 0.6s linear;
                }
                
                @keyframes ripple-animation {
                    to {
                        transform: scale(4);
                        opacity: 0;
                    }
                }
                
                .back-to-top:hover {
                    background: linear-gradient(135deg, var(--primary-light), var(--primary-medium)) !important;
                }
            `;
            document.head.appendChild(rippleStyle);

            // === PROTECTION CONTRE LES ANCRES DANS LES MODALES ===
            
            let modalIsOpen = false;
            let originalHash = window.location.hash;
            
            // Surveiller l'ouverture/fermeture des modales
            document.addEventListener('show.bs.modal', function(e) {
                modalIsOpen = true;
                originalHash = window.location.hash; // Sauvegarder l'état actuel
            });
            
            document.addEventListener('hidden.bs.modal', function(e) {
                modalIsOpen = false;
                // Restaurer l'URL sans ancre si elle a été modifiée
                if (window.location.hash && !originalHash) {
                    history.replaceState(null, '', window.location.pathname + window.location.search);
                } else if (originalHash && window.location.hash !== originalHash) {
                    history.replaceState(null, '', window.location.pathname + window.location.search + originalHash);
                }
            });
            
            // Bloquer les clics sur les ancres dans les modales
            document.addEventListener('click', function (e) {
                const openedModal = e.target.closest('.modal.show');
                const link = e.target.closest('a[href^="#"]');
                if (openedModal && link) {
                    e.preventDefault();
                    e.stopPropagation();
                    console.log('Clic sur ancre bloqué dans la modale:', link.getAttribute('href'));
                }
            }, true);
            
            // Empêcher les changements de hash pendant qu'une modale est ouverte
            window.addEventListener('hashchange', function(e) {
                if (modalIsOpen) {
                    e.preventDefault();
                    // Restaurer l'état précédent
                    history.replaceState(null, '', window.location.pathname + window.location.search + (originalHash || ''));
                    console.log('Changement de hash bloqué pendant l\'ouverture de modale');
                }
            });
            
            // Protection spécifique pour les messages de modération
            document.addEventListener('DOMContentLoaded', function() {
                // Désactiver tous les liens d'ancres dans les messages de modération
                document.querySelectorAll('.moderation-notice a[href^="#post-"]').forEach(function(link) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        console.log('Clic sur lien de modération neutralisé');
                    });
                });
            });
        });
    </script>
{% endblock %}