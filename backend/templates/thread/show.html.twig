{% extends 'base.html.twig' %}

{% block title %}{{ thread.title }} - DC Earth{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/editor.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/posts.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/moderation-modal.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/subcomponents/quick-nav.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/subcomponents/moral-badge.css') }}">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="thread-show container my-4" data-univers-slug="{{ univers.slug }}" data-thread-id="{{ thread.id }}">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

        {# En-tête du thread avec accordéons #}
    <div class="thread-header {% if thread.type == 'roleplay' %}roleplay-bg{% else %}hrp-bg{% endif %} mb-4">
        {# Titre principal et badges - toujours visibles #}
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div class="thread-title-container">
                <h1 class="thread-title mb-2">{{ thread.title }}</h1>
                {% if thread.location %}
                    <div class="thread-location mb-2">
                        <i class="fas fa-map-marker-alt me-1 text-primary"></i>
                        <span class="location-name">{{ thread.location.name }}</span>
                    </div>
                {% endif %}
            </div>
            <div class="thread-badges">
                {% if thread.sticky %}
                    <span class="badge bg-warning" title="Épinglé">
                        <i class="fas fa-thumbtack me-1"></i> Épinglé
                    </span>
                {% endif %}
                
                {% if thread.status == 'closed' %}
                    <span class="badge bg-secondary" title="Fermé">
                        <i class="fas fa-lock me-1"></i> Fermé
                    </span>
                {% endif %}
                
                <span class="badge {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %}" title="Type de discussion">
                    {% if thread.type == 'roleplay' %}
                        <i class="fa-solid fa-dice-d20 me-1"></i> RP
                    {% else %}
                        <i class="fas fa-comments me-1"></i> HRP
                    {% endif %}
                </span>
                
                {% if thread.participants|length > 0 %}
                    <span class="badge bg-info" title="Participants">
                        <i class="fas fa-users me-1"></i> {{ thread.participants|length }}
                    </span>
                {% endif %}
            </div>
        </div>
        
        {# Accordéons pour les détails #}
        <div class="thread-accordion">
            {# Accordéon Informations de base #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadInfoAccordion" aria-expanded="true">
                    <span class="accordion-title">
                        <i class="fas fa-info-circle me-2"></i>
                        Informations de base
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadInfoAccordion" class="collapse show">
                    <div class="thread-accordion-content">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="thread-author-info d-flex align-items-center">
                                    {% if thread.author.avatar %}
                                        <img src="{{ thread.author.avatar }}" alt="{{ thread.author.pseudo }}" class="thread-author-avatar me-2">
                                    {% else %}
                                        <div class="thread-author-avatar-placeholder me-2">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <div class="thread-author-details">
                                            <i class="fas fa-user me-1 text-muted"></i> Créée par : 
                                            {% if thread.type == 'roleplay' and thread.characterCreator %}
                                                <span class="thread-show--character-name text-primary">{{ thread.characterCreator.name }}</span> 
                                                <span class="text-muted">({{ thread.author.pseudo }})</span>
                                            {% else %}
                                                <span class="thread-author-name">{{ thread.author.pseudo }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="thread-date text-muted">
                                            <i class="fas fa-calendar me-1"></i> {{ thread.createdAt|date('d/m/Y à H:i') }}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <div class="thread-header-stats">
                                    <div class="thread-stat-item">
                                        <i class="fas fa-comments me-1 text-primary"></i> 
                                        <span class="thread-stat-value">{{ thread.posts|length }}</span>
                                        <span class="thread-stat-label">réponses</span>
                                    </div>
                                    <div class="thread-stat-item">
                                        <i class="fas fa-eye me-1 text-info"></i> 
                                        <span class="thread-stat-value">{{ thread.viewCount ?? 0 }}</span>
                                        <span class="thread-stat-label">vues</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if thread.description %}
            {# Accordéon Description #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadDescAccordion" aria-expanded="false">
                    <span class="accordion-title">
                        <i class="fas fa-align-left me-2"></i>
                        Description
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadDescAccordion" class="collapse">
                    <div class="thread-accordion-content">
                        <div class="thread-description">
                            {{ thread.description|raw }}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
            
            {% if thread.factions is not empty or (thread.type == 'roleplay' and thread.visibleToCharactersOnly) %}
            {# Accordéon Détails avancés #}
            <div class="thread-accordion-item">
                <button class="thread-accordion-header" type="button" data-bs-toggle="collapse" data-bs-target="#threadDetailsAccordion" aria-expanded="false">
                    <span class="accordion-title">
                        <i class="fas fa-cogs me-2"></i>
                        Détails avancés
                    </span>
                    <i class="fas fa-chevron-down accordion-icon"></i>
                </button>
                <div id="threadDetailsAccordion" class="collapse">
                    <div class="thread-accordion-content">
            {% if thread.factions is not empty %}
                            <div class="thread-factions mb-2">
                                <span class="detail-label">
                                    <i class="fas fa-users me-1 text-primary"></i> Factions :
                                </span>
                                <div class="faction-tags">
                    {% for faction in thread.factions %}
                                        <a href="{{ path('app_faction_show', {'universeSlug': faction.universe.slug, 'factionSlug': faction.slug}) }}" 
                                           class="faction-tag">
                                            {{ faction.name }}
                                        </a>
                    {% endfor %}
                                </div>
                            </div>
            {% endif %}
            
            {% if thread.type == 'roleplay' and thread.visibleToCharactersOnly %}
                            <div class="visibility-notice">
                                <i class="fas fa-user-shield me-1 text-warning"></i> 
                                <span class="text-warning">Visible uniquement par les personnages participants</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    
    {# Actions rapides #}
    <div class="thread-actions d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_forum_show', {'universeSlug': univers.slug, 'id': thread.forum.id}) }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Retour au forum
            </a>
            
            {% if canReply %}
                <a href="#replyForm" class="btn {% if thread.type == 'roleplay' %}bg-roleplay{% else %}bg-hrp{% endif %} text-white ms-2">
                    <i class="fas fa-reply me-1"></i> Répondre
                </a>
                
                <a href="{{ path('app_post_new', {'universeSlug': univers.slug, 'threadId': thread.id}) }}" class="btn btn-outline-primary ms-2">
                    <i class="fas fa-edit me-1"></i> Rédaction complète
                </a>
            {% endif %}
            
            {% if app.user %}
                <a href="{{ path('app_my_drafts', {'universeSlug': univers.slug}) }}" class="btn btn-outline-secondary ms-2">
                    <i class="fas fa-save me-1"></i> Mes brouillons
                </a>
            {% endif %}
        </div>
        
        <div class="btn-group">
            {% if is_granted('EDIT', thread) %}
                <a href="{{ path('app_thread_edit', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
            {% endif %}
            
            {% if is_granted('DELETE', thread) %}
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteThreadModal">
                    <i class="fas fa-trash-alt me-1"></i> Supprimer
                </button>
            {% endif %}
            
            {% if is_granted('MANAGE', thread) %}
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-cog me-1"></i> Gérer
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if thread.status == 'open' %}
                            <li>
                                <a href="{{ path('app_thread_close', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock me-1"></i> Fermer la discussion
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_open', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-lock-open me-1"></i> Rouvrir la discussion
                                </a>
                            </li>
                        {% endif %}
                        
                        {% if thread.sticky %}
                            <li>
                                <a href="{{ path('app_thread_unsticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack fa-rotate-90 me-1"></i> Désépingler
                                </a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path('app_thread_sticky', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                    <i class="fas fa-thumbtack me-1"></i> Épingler
                                </a>
                            </li>
                        {% endif %}
                        
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="{{ path('app_thread_move', {'universeSlug': univers.slug, 'id': thread.id}) }}" class="dropdown-item">
                                <i class="fas fa-exchange-alt me-1"></i> Déplacer
                            </a>
                        </li>
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    {# Navigation rapide pour les posts #}
    {% if posts|length > 0 %}
        <div class="quick-nav visible" id="posts-quick-nav">
            <a href="#posts" class="quick-nav-item" data-tooltip="Premier message" title="Premier message">
                <i class="fas fa-angle-double-up"></i>
            </a>
            {% if thread.type == 'roleplay' %}
                <a href="#posts" class="quick-nav-item character-nav-prev" data-tooltip="Personnage précédent" title="Personnage précédent" style="display: none;">
                    <i class="fas fa-chevron-left"></i>
                </a>
                <a href="#posts" class="quick-nav-item character-filter" data-tooltip="Filtrer par personnage" title="Filtrer par personnage">
                    <i class="fas fa-user-friends"></i>
                </a>
                <a href="#posts" class="quick-nav-item character-nav-next" data-tooltip="Personnage suivant" title="Personnage suivant" style="display: none;">
                    <i class="fas fa-chevron-right"></i>
                </a>
            {% endif %}
            <a href="#posts" class="quick-nav-item last-post" data-tooltip="Dernier message" title="Dernier message">
                <i class="fas fa-angle-double-down"></i>
            </a>
            {% if canReply %}
                <a href="#replyForm" class="quick-nav-item" data-tooltip="Répondre" title="Répondre">
                    <i class="fas fa-reply"></i>
                </a>
            {% endif %}
            <a href="{{ path('app_forum_show', {'universeSlug': univers.slug, 'id': thread.forum.id}) }}" class="quick-nav-item" data-tooltip="Retour au forum" title="Retour au forum">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>
    {% endif %}

    {# Afficher le message de restriction si l'utilisateur est sanctionné #}
    {% if app.user and postingRestriction is defined and postingRestriction is not null %}
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle me-2"></i> {{ postingRestriction.message }}
            {% if postingRestriction.type == 'ban_posting' %}
                Vous pouvez consulter l'<a href="{{ path('app_user_my_sanctions') }}">historique de vos sanctions</a> pour plus d'informations.
            {% endif %}
        </div>
    {% endif %}

    {# Liste des posts #}
    <div class="posts-container" id="posts">
        {# Affichage du premier post (message initial) #}
        {% for post in posts %}
            <div class="post-anchor" id="post-{{ post.id }}"></div>
            <div class="post-container {% if post.isRoleplay %}roleplay-theme{% else %}hrp-theme{% endif %} mb-4 {% if app.request.get('highlight') == post.id %}highlighted-post{% endif %} {% if post.isDraft %}draft-post{% endif %}" data-post-id="{{ post.id }}" data-is-hidden="{{ post.isHidden ? 'true' : 'false' }}">
                {% if post.isDraft %}
                    <div class="draft-badge">
                        <span class="badge bg-warning">Brouillon</span>
                    </div>
                {% endif %}
                
                <div class="post-sidebar">
                    {% if post.isRoleplay and post.character %}
                        <div class="avatar-container">
                            {% if post.character.avatar %}
                                <img src="{{ post.character.avatarPortraitUrl }}" alt="{{ post.character.name }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user-astronaut"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="post-character-info">
                            {# Nom du personnage #}
                            <div class="name-label">
                                <a href="{{ path('app_roleplay_character_show', {'id': post.character.id}) }}" class="character-link">
                                    {{ post.character.name }}
                                </a>
                            </div>
                            
                            {# Affiliation morale après le nom #}
                            {% if post.character.moralAffiliation %}
                                <div class="character-affiliation">
                                    <span class="moral-badge moral-badge--{{ post.character.moralAffiliation|lower|replace({' ': '-'}) }}">
                                        {{ post.character.moralAffiliation }}
                                    </span>
                                </div>
                            {% endif %}
                            
                            {% if post.character.actualPseudo %}
                                <div class="character-alias">{{ post.character.actualPseudo }}</div>
                            {% endif %}
                            <div class="player-name">Joueur: {{ post.author.pseudo }}</div>
                        </div>
                        
                        {# Accordéons pour les détails du personnage #}
                        <div class="post-character-accordions mt-3">
                            {# Accordéon des factions #}
                            {% if post.character.factionsRelation|length > 0 %}
                                <div class="post-character-accordion-item">
                                    <button class="post-character-accordion-header" 
                                            type="button" 
                                            onclick="togglePostCharacterAccordion(event, 'post-factions-{{ post.id }}')">
                                        <span class="post-character-accordion-title">
                                            <i class="fas fa-users me-1"></i>
                                            Factions
                                        </span>
                                        <i class="fas fa-chevron-down post-character-accordion-icon"></i>
                                    </button>
                                    <div class="post-character-accordion-content" id="post-factions-{{ post.id }}">
                                        <div class="post-character-accordion-body">
                                            <div class="faction-list">
                                                {% for faction in post.character.factionsRelation %}
                                                    <div class="faction-item">
                                                        <a href="{{ path('app_faction_show', {'universeSlug': faction.universe.slug, 'factionSlug': faction.slug}) }}" 
                                                           class="faction-link">
                                                            {% if faction.icon %}
                                                                <img src="{{ faction.icon }}" alt="{{ faction.name }}" class="faction-icon">
                                                            {% else %}
                                                                <i class="fas fa-users faction-icon-placeholder"></i>
                                                            {% endif %}
                                                            <span class="faction-name">{{ faction.name }}</span>
                                                        </a>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            
                            {% if post.character.abilities %}
                                <div class="post-character-accordion-item">
                                    <button class="post-character-accordion-header" 
                                            type="button" 
                                            onclick="togglePostCharacterAccordion(event, 'post-abilities-{{ post.id }}')">
                                        <span class="post-character-accordion-title">
                                            <i class="fas fa-bolt me-1"></i>
                                            Capacités
                                        </span>
                                        <i class="fas fa-chevron-down post-character-accordion-icon"></i>
                                    </button>
                                    <div class="post-character-accordion-content" id="post-abilities-{{ post.id }}">
                                        <div class="post-character-accordion-body">
                                            {{ post.character.abilities|striptags }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            
                            {% if post.character.equipment %}
                                <div class="post-character-accordion-item">
                                    <button class="post-character-accordion-header" 
                                            type="button" 
                                            onclick="togglePostCharacterAccordion(event, 'post-equipment-{{ post.id }}')">
                                        <span class="post-character-accordion-title">
                                            <i class="fas fa-shield-alt me-1"></i>
                                            Équipement
                                        </span>
                                        <i class="fas fa-chevron-down post-character-accordion-icon"></i>
                                    </button>
                                    <div class="post-character-accordion-content" id="post-equipment-{{ post.id }}">
                                        <div class="post-character-accordion-body">
                                            {{ post.character.equipment|striptags }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                            
                            {# Lien vers la fiche complète du personnage #}
                            <div class="post-character-link mt-2">
                                <a href="{{ path('app_roleplay_character_show', {'id': post.character.id}) }}" 
                                   class="character-sheet-link" 
                                   title="Voir la fiche complète de {{ post.character.name }}">
                                    <i class="fas fa-id-card me-1"></i>
                                    Fiche personnage
                                </a>
                            </div>
                        </div>
                    {% else %}
                        <div class="avatar-container">
                            {% if post.author.avatar %}
                                <img src="{{ post.author.avatarUrl }}" alt="{{ post.author.pseudo }}" class="img-fluid rounded">
                            {% else %}
                                <div class="default-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="post-user-info">
                            <div class="name-label">{{ post.author.pseudo }}</div>
                            <div class="player-since">Membre depuis {{ post.author.createdAt|date('d/m/Y') }}</div>
                        </div>
                    {% endif %}

                    {# Affichage des PNJ associés au post #}
                    {% if post.npcs|length > 0 %}
                        <div class="post-npcs-info mt-3">
                            <div class="post-npcs-label">
                                <i class="fas fa-users me-1"></i> PNJ présents
                            </div>
                            <div class="post-npcs-list">
                                {% for npc in post.npcs %}
                                    <div class="npc-item">
                                        <div class="npc-avatar">
                                            {% if npc.avatar %}
                                                <img src="{{ npc.avatar }}" alt="{{ npc.name }}" class="img-fluid rounded">
                                            {% else %}
                                                <div class="default-avatar">
                                                    <i class="fas fa-user-tie"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="npc-name">
                                            <a href="{{ path('app_npc_show', {'id': npc.id}) }}" class="npc-link">
                                                {{ npc.name }}
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
                
                <div class="post-main">
                    <div class="post-header">
                        <div class="post-meta">
                            <span class="post-date">
                                <i class="fas fa-calendar-alt me-1"></i>
                                {{ post.createdAt|date('d/m/Y à H:i') }}
                                {% if post.editedAt and post.editedAt != post.createdAt %}
                                    <span class="post-edited-indicator">
                                        <i class="fas fa-edit me-1 text-warning"></i>
                                        <small class="text-muted">Édité le {{ post.editedAt|date('d/m/Y à H:i') }}</small>
                                    </span>
                                {% endif %}
                            </span>
                            <span class="post-id">
                                <a href="#post-{{ post.id }}" class="text-reset">#{{ post.id }}</a>
                            </span>
                        </div>
                        
                        <div class="post-actions">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#post-{{ post.id }}">
                                            <i class="fas fa-link me-2"></i> Lien permanent
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_post_quote', {'universeSlug': univers.slug, 'id': post.id}) }}">
                                            <i class="fas fa-quote-right me-2"></i> Citer
                                        </a>
                                    </li>
                                    {% if is_granted('EDIT', post) %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_post_edit', {'universeSlug': univers.slug, 'id': post.id}) }}">
                                            <i class="fas fa-edit me-2"></i> Modifier
                                        </a>
                                    </li>
                                    {% endif %}
                                    {% if is_granted('DELETE', post) %}
                                    <li>
                                        <button type="button" class="dropdown-item text-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deletePostModal" 
                                                data-post-id="{{ post.id }}">
                                            <i class="fas fa-trash-alt me-2"></i> Supprimer
                                        </button>
                                    </li>
                                    {% endif %}
                                    {% if is_granted('ROLE_MODERATOR') %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" 
                                                    class="dropdown-item text-warning" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#moderatePostModal"
                                                    data-post-id="{{ post.id }}">
                                                <i class="fas fa-exclamation-triangle me-2"></i> Modérer
                                            </button>
                                        </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="post-content">
                        {{ post.content|decode_html|raw }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Formulaire de réponse (si l'utilisateur peut répondre) #}
    {% if canReply %}
        <div id="replyForm">
            {% if is_granted('ROLE_ANIMATEUR_AI') %}
                <div class="ai-assistant">
                    <div class="ai-assistant__accordion">
                        <button class="ai-assistant__header" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#aiAssistantAccordion" 
                                aria-expanded="false">
                            <span class="ai-assistant__title">
                                <i class="fas fa-robot me-2"></i>
                                Assistant IA pour Personas
                            </span>
                            <i class="fas fa-chevron-down ai-assistant__icon"></i>
                        </button>
                        
                        <div id="aiAssistantAccordion" class="collapse">
                            <div class="ai-assistant__content">
                                
                                {# Sélection du persona avec cartes #}
                                <div class="ai-persona-selector">
                                    <div class="ai-persona-selector__header">
                                        <h5 class="ai-persona-selector__title">
                                            <i class="fas fa-user-astronaut me-2"></i>
                                            Choisir un Persona IA
                                        </h5>
                                        <small class="ai-persona-selector__subtitle">
                                            Personas IA actifs dans cet univers
                                        </small>
                                    </div>
                                    
                                    {# Galerie de cartes de personas IA #}
                                    <div class="ai-persona-gallery" id="ai-persona-gallery">
                                        {# Les personas seront chargés dynamiquement via JavaScript #}
                                    </div>
                                    
                                    {# Message si aucun persona disponible #}
                                    <div class="ai-persona-selector__empty" id="ai-personas-empty" style="display: none;">
                                        <div class="alert alert-warning">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            Aucun persona IA actif disponible.
                                            <br>
                                            <a href="{{ path('app_ai_persona_new') }}" class="alert-link">
                                                Créer un nouveau persona
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                {# Choix du modèle IA #}
                                <div class="ai-model-selector" id="ai-model-section" style="display: none;">
                                    <label class="ai-context__label">
                                        <i class="fas fa-brain me-2"></i>
                                        Modèle d'IA
                                    </label>
                                    <div class="ai-model-options">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ai-model" id="gpt4-model" value="gpt4" checked>
                                            <label class="form-check-label" for="gpt4-model">
                                                <strong>GPT-4 Turbo</strong> - Rapide et efficace
                                                <small class="d-block text-muted">Excellent pour les réponses cohérentes</small>
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="ai-model" id="claude-model" value="claude">
                                            <label class="form-check-label" for="claude-model">
                                                <strong>Claude 3 Opus</strong> - Créativité littéraire
                                                <small class="d-block text-muted">Spécialisé dans la fiction et le roleplay</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                {# Contexte supplémentaire #}
                                <div class="ai-context" id="ai-context-section" style="display: none;">
                                    <label class="ai-context__label" for="ai-context">
                                        <i class="fas fa-comment-dots me-2"></i>
                                        Contexte supplémentaire (optionnel)
                                    </label>
                                    <textarea id="ai-context" class="ai-context__textarea form-control" rows="3" 
                                        placeholder="Ajoutez des instructions ou du contexte supplémentaire pour influencer la génération de la réponse..."></textarea>
                                </div>

                                {# Actions #}
                                <div class="ai-actions" id="ai-actions-section" style="display: none;">
                                    <button id="generate-ai-response" class="ai-actions__btn ai-actions__btn--generate" disabled>
                                        <i class="fas fa-magic"></i>
                                        Générer une réponse
                                    </button>
                                    <button id="reset-ai-selection" class="ai-actions__btn ai-actions__btn--reset">
                                        <i class="fas fa-undo"></i>
                                        Recommencer
                                    </button>
                                </div>
                                
                                {# Animation de génération #}
                                <div class="ai-generating" id="ai-generating">
                                    <div class="ai-generating__spinner">
                                        <i class="fas fa-cog"></i>
                                    </div>
                                    <div class="ai-generating__text">
                                        Génération de la réponse en cours...
                                    </div>
                                </div>
                                
                                {# Éditeur de réponse générée #}
                                <div class="ai-response-editor" id="ai-response-editor">
                                    <div class="ai-response-editor__header">
                                        <h5 class="ai-response-editor__title">
                                            <i class="fas fa-feather-alt"></i>
                                            Réponse générée
                                        </h5>
                                        <div class="ai-response-editor__persona-info" id="ai-response-persona-info">
                                            <span id="ai-response-persona-name"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="ai-response-editor__content">
                                        <div id="ai-response-content" class="ai-response-editor__wysiwyg"></div>
                                    </div>
                                    
                                    <div class="ai-response-editor__actions">
                                        <div class="ai-response-editor__actions-row">
                                            <button id="publish-ai-response" class="ai-response-editor__btn ai-response-editor__btn--publish" disabled>
                                                <i class="fas fa-paper-plane"></i>
                                                Publier la réponse
                                            </button>
                                            <button id="save-draft-ai-response" class="ai-response-editor__btn ai-response-editor__btn--draft" disabled>
                                                <i class="fas fa-save"></i>
                                                Sauvegarder en brouillon
                                            </button>
                                            <button id="regenerate-ai-response" class="ai-response-editor__btn ai-response-editor__btn--regenerate" disabled>
                                                <i class="fas fa-redo"></i>
                                                Régénérer
                                            </button>
                                        </div>
                                        <div class="ai-response-editor__note">
                                            <i class="fas fa-info-circle"></i>
                                            Vous pouvez modifier le texte avant de publier ou sauvegarder.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if thread.type == 'roleplay' %}
                {{ render(controller('App\\Controller\\PostController::replyForm', { 'universeSlug': univers.slug, 'threadId': thread.id })) }}
            {% else %}
                {{ render(controller('App\\Controller\\PostController::replyHrpForm', { 'universeSlug': univers.slug, 'threadId': thread.id })) }}
            {% endif %}
        </div>
    {% elseif not app.user %}
        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour participer à cette discussion.
        </div>
    {% elseif thread.status == 'closed' %}
        <div class="alert alert-warning mt-4">
            <i class="fas fa-lock me-2"></i>
            Cette discussion est fermée et n'accepte plus de nouvelles réponses.
        </div>
    {% endif %}
</div>

