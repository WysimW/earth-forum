                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <input type="hidden" name="_token" id="moderatePostToken">
                    <input type="hidden" name="quoted_text" id="quotedTextInput">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-gavel me-2"></i>
                        Appliquer la modération
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    
    {# Scripts organisés par fonctionnalité #}
    <script src="{{ asset('js/thread/effects.js') }}"></script>
    <script src="{{ asset('js/thread/character-filter.js') }}"></script>
    <script src="{{ asset('js/thread/quick-nav.js') }}"></script>
    <script src="{{ asset('js/thread/modals.js') }}"></script>
    
    {# Données pour les scripts JavaScript #}
    <script type="application/json" id="csrf-tokens">
        {
                    {% for post in posts %}
            "{{ post.id }}": "{{ csrf_token('delete_post_' ~ post.id) }}"{% if not loop.last %},{% endif %}
                    {% endfor %}
        }
    </script>
    
    <script type="application/json" id="moderation-tokens">
        {
                    {% for post in posts %}
            "{{ post.id }}": "{{ csrf_token('moderate_post_' ~ post.id) }}"{% if not loop.last %},{% endif %}
                    {% endfor %}
        }
    </script>
    
    <script>
        // Configuration globale pour les scripts
        document.addEventListener('DOMContentLoaded', function() {
            // Ajouter les attributs de données nécessaires pour les scripts
            document.body.dataset.universSlug = '{{ univers.slug }}';
            document.body.dataset.threadId = '{{ thread.id }}';
            
            // Initialiser l'assistant IA si présent
            {% if is_granted('ROLE_ANIMATEUR_AI') %}
                initializeAIAssistant();
            {% endif %}
            
            console.log('✅ Scripts thread chargés et initialisés');
        });
        
        {% if is_granted('ROLE_ANIMATEUR_AI') %}
        // === ASSISTANT IA ===
        let aiPersonas = [];
        let selectedPersonaId = null;
        let aiResponseQuill = null;
        
        async function initializeAIAssistant() {
            try {
                // Charger les personas IA
                await loadAIPersonas();
                
                // Initialiser les événements
                setupAIEventListeners();
                
                // Initialiser l'accordéon
                setupAIAccordion();
                
                console.log('✅ Assistant IA initialisé');
            } catch (error) {
                console.error('❌ Erreur lors de l\'initialisation de l\'assistant IA:', error);
            }
        }
        
        async function loadAIPersonas() {
            try {
                const response = await fetch('{{ path('app_ai_persona_list') }}');
                if (!response.ok) {
                    throw new Error('Erreur lors du chargement des personas');
                }
                
                aiPersonas = await response.json();
                renderAIPersonaCards();
                
                console.log('✅ Personas IA chargés:', aiPersonas.length);
            } catch (error) {
                console.error('❌ Erreur lors du chargement des personas:', error);
                showAIError('Impossible de charger les personas IA');
            }
        }
        
        function renderAIPersonaCards() {
            const gallery = document.getElementById('ai-persona-gallery');
            const emptyMessage = document.getElementById('ai-personas-empty');
            
            if (!gallery) return;
            
            if (aiPersonas.length === 0) {
                gallery.style.display = 'none';
                emptyMessage.style.display = 'block';
                return;
            }
            
            gallery.innerHTML = '';
            emptyMessage.style.display = 'none';
            gallery.style.display = 'grid';
            
            aiPersonas.forEach(persona => {
                const card = createAIPersonaCard(persona);
                gallery.appendChild(card);
            });
        }
        
        function createAIPersonaCard(persona) {
            const card = document.createElement('div');
            card.className = 'ai-persona-card';
            card.dataset.personaId = persona.id;
            card.onclick = () => selectAIPersona(persona.id);
            
            const traitsHTML = persona.personalityTraits && persona.personalityTraits.length > 0 
                ? `<div class="ai-persona-card__traits">
                     <div class="ai-persona-card__traits-title">Traits</div>
                     <div class="ai-persona-card__traits-list">
                       ${persona.personalityTraits.slice(0, 3).map(trait => 
                         `<span class="ai-persona-card__trait">${trait}</span>`
                       ).join('')}
                     </div>
                   </div>`
                : '';
            
            card.innerHTML = `
                <div class="ai-persona-card__inner">
                    <div class="ai-persona-card__header">
                        <div class="ai-persona-card__avatar">
                            ${persona.character && persona.character.avatar 
                                ? `<img src="${persona.character.avatar}" alt="${persona.name}" class="ai-persona-card__avatar-img">`
                                : `<div class="ai-persona-card__avatar-placeholder"><i class="fas fa-robot"></i></div>`
                            }
                        </div>
                        <div class="ai-persona-card__basic-info">
                            <h6 class="ai-persona-card__name">${persona.name}</h6>
                            ${persona.character 
                                ? `<div class="ai-persona-card__character">Personnage: ${persona.character.name}</div>`
                                : '<div class="ai-persona-card__character">Persona générique</div>'
                            }
                        </div>
                    </div>
                    
                    <div class="ai-persona-card__body">
                        <div class="ai-persona-card__description">
                            ${persona.description || 'Aucune description disponible'}
                        </div>
                        ${traitsHTML}
                    </div>
                    
                    <div class="ai-persona-card__footer">
                        <div class="ai-persona-card__action-hint">
                            <i class="fas fa-hand-pointer"></i>
                            Cliquer pour sélectionner
                        </div>
                    </div>
                    
                    <div class="ai-persona-card__selection-overlay">
                        <div class="ai-persona-card__selection-content">
                            <div class="ai-persona-card__selection-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="ai-persona-card__selection-text">Persona ${persona.character.name} Sélectionné</div>
                            <div class="ai-persona-card__selection-subtext">Prêt à générer</div>
                        </div>
                    </div>
                </div>
            `;
            
            return card;
        }
        
        function selectAIPersona(personaId) {
            selectedPersonaId = personaId;
            
            // Mettre à jour la sélection visuelle
            document.querySelectorAll('.ai-persona-card').forEach(card => {
                card.classList.remove('ai-persona-card--selected');
            });
            
            const selectedCard = document.querySelector(`[data-persona-id="${personaId}"]`);
            if (selectedCard) {
                selectedCard.classList.add('ai-persona-card--selected');
                
                // Animation de sélection
                selectedCard.style.transform = 'translateY(-6px) scale(1.03)';
                setTimeout(() => {
                    selectedCard.style.transform = '';
                }, 300);
            }
            
            // Afficher les sections suivantes
            showAIContextAndActions();
            
            console.log('✅ Persona IA sélectionné:', personaId);
        }
        
        function showAIContextAndActions() {
            const modelSection = document.getElementById('ai-model-section');
            const contextSection = document.getElementById('ai-context-section');
            const actionsSection = document.getElementById('ai-actions-section');
            const generateBtn = document.getElementById('generate-ai-response');
            
            if (modelSection) {
                modelSection.style.display = 'block';
            }
            
            if (contextSection) {
                contextSection.style.display = 'block';
            }
            
            if (actionsSection) {
                actionsSection.style.display = 'flex';
            }
            
            if (generateBtn) {
                generateBtn.disabled = false;
            }
        }
        
        function setupAIEventListeners() {
            // Bouton de génération
            const generateBtn = document.getElementById('generate-ai-response');
            if (generateBtn) {
                generateBtn.addEventListener('click', generateAIResponse);
            }
            
            // Bouton de reset
            const resetBtn = document.getElementById('reset-ai-selection');
            if (resetBtn) {
                resetBtn.addEventListener('click', resetAISelection);
            }
            
            // Animation de l'accordéon
            const accordion = document.getElementById('aiAssistantAccordion');
            if (accordion) {
                accordion.addEventListener('shown.bs.collapse', function() {
                    const gallery = document.getElementById('ai-persona-gallery');
                    if (gallery) {
                        gallery.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }
        }
        
        function setupAIAccordion() {
            const accordionHeader = document.querySelector('.ai-assistant__header');
            const accordionIcon = document.querySelector('.ai-assistant__icon');
            
            if (accordionHeader && accordionIcon) {
                accordionHeader.addEventListener('click', function() {
                    setTimeout(() => {
                        const isExpanded = this.getAttribute('aria-expanded') === 'true';
                        accordionIcon.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
                    }, 10);
                });
            }
        }
        
        async function generateAIResponse() {
            if (!selectedPersonaId) {
                alert('Veuillez sélectionner un persona IA');
                return;
            }
            
            const contextTextarea = document.getElementById('ai-context');
            const additionalContext = contextTextarea ? contextTextarea.value : '';
            
            // Récupérer le modèle sélectionné
            const selectedModel = document.querySelector('input[name="ai-model"]:checked');
            const useClaudeModel = selectedModel ? selectedModel.value === 'claude' : false;
            
            // Afficher l'animation de chargement
            showAIGenerating(true);
            
            try {
                const response = await fetch(`{{ path('app_ai_persona_generate_response', {'postId': '__POST_ID__'}) }}`.replace('__POST_ID__', '{{ posts|last.id }}'), {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        personaId: selectedPersonaId,
                        additionalContext: additionalContext,
                        useClaudeModel: useClaudeModel
                    })
                });
                
                if (!response.ok) {
                    throw new Error('Erreur lors de la génération');
                }
                
                const data = await response.json();
                displayAIResponse(data.response);
                
            } catch (error) {
                console.error('❌ Erreur lors de la génération:', error);
                showAIError('Erreur lors de la génération de la réponse');
            } finally {
                showAIGenerating(false);
            }
        }
        
        function showAIGenerating(show) {
            const generatingDiv = document.getElementById('ai-generating');
            if (generatingDiv) {
                if (show) {
                    generatingDiv.classList.add('show');
                } else {
                    generatingDiv.classList.remove('show');
                }
            }
        }
        
        function displayAIResponse(responseText) {
            const responseEditor = document.getElementById('ai-response-editor');
            const responseContent = document.getElementById('ai-response-content');
            const personaName = document.getElementById('ai-response-persona-name');
            
            if (!responseEditor || !responseContent) return;
            
            // Afficher les informations du persona
            const selectedPersona = aiPersonas.find(p => p.id == selectedPersonaId);
            if (personaName && selectedPersona) {
                personaName.textContent = `Réponse générée par ${selectedPersona.name}`;
            }
            
            // Initialiser Quill si pas encore fait
            if (!aiResponseQuill) {
                aiResponseQuill = new Quill(responseContent, {
                    theme: 'snow',
                    modules: {
                        toolbar: [
                            ['bold', 'italic', 'underline'],
                            [{ 'color': [] }, { 'background': [] }],
                            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                            ['blockquote', 'link'],
                            ['clean']
                        ]
                    },
                    placeholder: 'La réponse générée apparaîtra ici...'
                });
            }
            
            // Insérer le contenu généré
            aiResponseQuill.root.innerHTML = responseText;
            
            // Afficher l'éditeur
            responseEditor.classList.add('show');
            
            // Scroll vers l'éditeur
            responseEditor.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            console.log('✅ Réponse IA affichée');
        }
        
        function resetAISelection() {
            selectedPersonaId = null;
            
            // Réinitialiser les cartes
            document.querySelectorAll('.ai-persona-card').forEach(card => {
                card.classList.remove('ai-persona-card--selected');
            });
            
            // Masquer les sections
            const modelSection = document.getElementById('ai-model-section');
            const contextSection = document.getElementById('ai-context-section');
            const actionsSection = document.getElementById('ai-actions-section');
            const responseEditor = document.getElementById('ai-response-editor');
            const contextTextarea = document.getElementById('ai-context');
            const generateBtn = document.getElementById('generate-ai-response');
            
            if (modelSection) modelSection.style.display = 'none';
            if (contextSection) contextSection.style.display = 'none';
            if (actionsSection) actionsSection.style.display = 'none';
            if (responseEditor) responseEditor.classList.remove('show');
            if (contextTextarea) contextTextarea.value = '';
            if (generateBtn) generateBtn.disabled = true;
            
            // Réinitialiser le choix du modèle
            const gpt4Radio = document.getElementById('gpt4-model');
            if (gpt4Radio) gpt4Radio.checked = true;
            
            // Réinitialiser Quill
            if (aiResponseQuill) {
                aiResponseQuill.root.innerHTML = '';
            }
            
            console.log('✅ Sélection IA réinitialisée');
        }
        
        function showAIError(message) {
            // Vous pouvez implémenter une notification d'erreur ici
            alert(message);
        }
        {% endif %}
        
        // Fonction pour gérer les accordéons des personnages dans les posts
        function togglePostCharacterAccordion(event, contentId) {
            event.preventDefault();
            event.stopPropagation();
            
            const button = event.currentTarget;
            const content = document.getElementById(contentId);
            const icon = button.querySelector('.post-character-accordion-icon');
            
            if (!content) return false;
            
            const isExpanded = content.classList.contains('show');
            
            // Fermer tous les autres accordéons de ce post
            const postContainer = button.closest('.post-container');
            if (postContainer) {
                const allContents = postContainer.querySelectorAll('.post-character-accordion-content');
                const allButtons = postContainer.querySelectorAll('.post-character-accordion-header');
                const allIcons = postContainer.querySelectorAll('.post-character-accordion-icon');
                
                allContents.forEach(c => c.classList.remove('show'));
                allButtons.forEach(b => b.setAttribute('aria-expanded', 'false'));
                allIcons.forEach(i => i.style.transform = 'rotate(0deg)');
            }
            
            if (!isExpanded) {
                // Ouvrir cet accordéon
                content.classList.add('show');
                button.setAttribute('aria-expanded', 'true');
                icon.style.transform = 'rotate(180deg)';
            }
            
            return false;
        }
    </script>
{% endblock %}