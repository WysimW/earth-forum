{% extends 'base.html.twig' %}

{% block title %}Mes fiches de personnage{% endblock %}

{% block body %}
<div class="container mt-4">
    {{ breadcrumbs|raw }}
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="character-sheets-title">Mes fiches de personnage</h1>
        <a href="{{ path('app_roleplay_character_new') }}" class="btn btn-primary btn-create-character">
            <i class="fas fa-plus"></i> Créer un nouveau personnage
        </a>
    </div>
    
    {% if characterSheets|length > 0 %}
        <div class="character-sheets-grid">
            {% for thread in characterSheets %}
                {% set character = thread.characterSheet %}
                {% set statusClasses = {
                    'draft': 'status-draft',
                    'pending': 'status-pending',
                    'validated': 'status-validated',
                    'rejected': 'status-rejected',
                    'abandoned': 'status-abandoned',
                    'editing': 'status-editing'
                } %}
                
                <div class="character-card glass-panel">
                    <div class="character-card-header {{ statusClasses[character.status] }}">
                        <div class="character-card-header-content">
                            {% if character.avatar %}
                                <div class="character-avatar">
                                    <img src="{{ character.avatar }}" alt="{{ character.name }}">
                                </div>
                            {% else %}
                                <div class="character-avatar character-avatar-placeholder">
                                    <i class="fas fa-user-circle"></i>
                                </div>
                            {% endif %}
                            
                            <div class="character-card-title">
                                <h3>{{ thread.title }}</h3>
                                <div class="character-card-badges">
                                    <span class="character-status-badge {{ statusClasses[character.status] }}">
                                        <i class="fas {% if character.status == 'validated' %}fa-check-circle
                                        {% elseif character.status == 'rejected' %}fa-times-circle
                                        {% elseif character.status == 'abandoned' %}fa-trash-alt
                                        {% elseif character.status == 'editing' %}fa-pencil-alt
                                        {% else %}fa-clock{% endif %}"></i>
                                        {{ {
                                            'draft': 'Brouillon',
                                            'pending': 'En attente',
                                            'validated': 'Validé',
                                            'rejected': 'Refusé',
                                            'abandoned': 'Abandonné',
                                            'editing': 'En édition'
                                        }[character.status] }}
                                    </span>
                                    {% if character.universe %}
                                        <span class="universe-badge">
                                            <i class="fas fa-globe-americas"></i> {{ character.universe.name }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="character-card-body">
                        <div class="character-card-info">
                            <div class="character-card-info-item">
                                <i class="fas fa-calendar-alt"></i>
                                <span>Créé le {{ character.createdAt|date('d/m/Y') }}</span>
                            </div>
                            
                            {% if character.moralAffiliation %}
                            <div class="character-card-info-item">
                                <i class="fas fa-mask"></i>
                                <span>{{ character.moralAffiliation }}</span>
                            </div>
                            {% endif %}
                            
                            {% if character.validatedAt %}
                                <div class="character-card-info-item text-success">
                                    <i class="fas fa-check-circle"></i>
                                    <span>Validé le {{ character.validatedAt|date('d/m/Y') }}</span>
                                </div>
                            {% endif %}
                            
                            {% if character.statusMessage %}
                                <div class="character-card-info-item">
                                    <i class="fas fa-info-circle"></i>
                                    <span>{{ character.statusMessage }}</span>
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="character-card-actions">
                            <a href="{{ path('app_thread_show', {'id': thread.id}) }}" class="btn btn-primary btn-view">
                                <i class="fas fa-eye"></i> Voir la fiche
                            </a>
                            {% if character.status != 'validated' and character.status != 'abandoned' %}
                                <a href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}" class="btn btn-outline-primary btn-edit">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="character-empty-state glass-panel">
            <div class="character-empty-state-icon">
                <i class="fas fa-user-circle"></i>
            </div>
            <h3>Vous n'avez pas encore créé de fiche de personnage</h3>
            <p>Commencez par créer votre premier personnage pour participer aux scènes de roleplay</p>
            <a href="{{ path('app_roleplay_character_new') }}" class="btn btn-primary btn-lg">
                <i class="fas fa-plus"></i> Créer mon premier personnage
            </a>
        </div>
    {% endif %}
</div>

<style>
    /* Styles pour les fiches de personnages */
    .character-sheets-title {
        font-family: var(--font-title);
        color: var(--text-white);
        margin-bottom: 1rem;
        font-size: 2.2rem;
    }
    
    .btn-create-character {
        background: linear-gradient(135deg, var(--roleplay-primary), var(--roleplay-secondary));
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: var(--border-radius-lg);
        transition: all 0.3s ease;
        font-weight: 500;
        box-shadow: 0 4px 15px rgba(156, 85, 211, 0.3);
    }
    
    .btn-create-character:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(156, 85, 211, 0.4);
    }
    
    .character-sheets-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        grid-gap: 1.5rem;
    }
    
    .character-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 100%;
    }
    
    .character-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    
    .character-card-header {
        padding: 1.5rem;
        position: relative;
        background-position: center;
        background-size: cover;
    }
    
    .character-card-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.3) 100%);
        z-index: 1;
    }
    
    .character-card-header.status-draft::before {
        background: linear-gradient(45deg, rgba(108, 117, 125, 0.8) 0%, rgba(108, 117, 125, 0.5) 100%);
    }
    
    .character-card-header.status-pending::before {
        background: linear-gradient(45deg, rgba(255, 193, 7, 0.8) 0%, rgba(255, 193, 7, 0.5) 100%);
    }
    
    .character-card-header.status-validated::before {
        background: linear-gradient(45deg, rgba(40, 167, 69, 0.8) 0%, rgba(40, 167, 69, 0.5) 100%);
    }
    
    .character-card-header.status-rejected::before {
        background: linear-gradient(45deg, rgba(220, 53, 69, 0.8) 0%, rgba(220, 53, 69, 0.5) 100%);
    }
    
    .character-card-header.status-abandoned::before {
        background: linear-gradient(45deg, rgba(108, 117, 125, 0.8) 0%, rgba(108, 117, 125, 0.5) 100%);
    }
    
    .character-card-header.status-editing::before {
        background: linear-gradient(45deg, rgba(23, 162, 184, 0.8) 0%, rgba(23, 162, 184, 0.5) 100%);
    }
    
    .character-card-header-content {
        display: flex;
        position: relative;
        z-index: 2;
    }
    
    .character-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        overflow: hidden;
        margin-right: 1rem;
        border: 3px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        background: rgba(255, 255, 255, 0.1);
        flex-shrink: 0;
    }
    
    .character-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .character-avatar-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
    }
    
    .character-avatar-placeholder i {
        font-size: 2.5rem;
        color: rgba(255, 255, 255, 0.8);
    }
    
    .character-card-title {
        color: white;
    }
    
    .character-card-title h3 {
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
        font-weight: 600;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
    }
    
    .character-card-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    .character-status-badge {
        font-size: 0.8rem;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        background: rgba(0, 0, 0, 0.2);
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    
    .character-status-badge.status-draft {
        background-color: rgba(108, 117, 125, 0.7);
    }
    
    .character-status-badge.status-pending {
        background-color: rgba(255, 193, 7, 0.7);
        color: rgba(0, 0, 0, 0.8);
    }
    
    .character-status-badge.status-validated {
        background-color: rgba(40, 167, 69, 0.7);
    }
    
    .character-status-badge.status-rejected {
        background-color: rgba(220, 53, 69, 0.7);
    }
    
    .character-status-badge.status-abandoned {
        background-color: rgba(108, 117, 125, 0.7);
    }
    
    .character-status-badge.status-editing {
        background-color: rgba(23, 162, 184, 0.7);
    }
    
    .universe-badge {
        font-size: 0.8rem;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        background: rgba(13, 110, 253, 0.7);
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }
    
    .character-card-body {
        padding: 1.5rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    
    .character-card-info {
        margin-bottom: 1rem;
    }
    
    .character-card-info-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }
    
    .character-card-info-item i {
        width: 20px;
        margin-right: 10px;
        color: var(--roleplay-light);
    }
    
    .character-card-actions {
        display: flex;
        gap: 0.5rem;
    }
    
    .btn-view, .btn-edit {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    
    .btn-view {
        background: linear-gradient(135deg, var(--roleplay-primary), var(--roleplay-secondary));
        border: none;
    }
    
    .btn-edit {
        border-color: var(--roleplay-primary);
        color: var(--roleplay-primary);
    }
    
    .character-empty-state {
        text-align: center;
        padding: 5rem 2rem;
        margin-top: 3rem;
    }
    
    .character-empty-state-icon {
        font-size: 5rem;
        color: var(--roleplay-primary);
        margin-bottom: 2rem;
        opacity: 0.7;
    }
    
    .character-empty-state h3 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
        color: var(--text-white);
    }
    
    .character-empty-state p {
        font-size: 1.1rem;
        margin-bottom: 2rem;
        color: var(--text-light);
    }
    
    @media (max-width: 768px) {
        .character-sheets-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        }
    }
    
    @media (max-width: 576px) {
        .character-card-header-content {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        
        .character-avatar {
            margin-right: 0;
            margin-bottom: 1rem;
        }
        
        .character-card-badges {
            justify-content: center;
        }
        
        .character-card-info-item {
            justify-content: center;
        }
        
        .character-card-actions {
            flex-direction: column;
            gap: 0.8rem;
        }
    }
</style>
{% endblock %}