{% extends 'base.html.twig' %}

{% block title %}Fiche de
	{{ character.name }}
{% endblock %}

{% block body %}
	<div class="container mt-4">
		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				{% for item in breadcrumbs %}
					{% if item.url is defined %}
						<li class="breadcrumb-item">
							<a href="{{ item.url }}">{{ item.name }}</a>
						</li>
					{% else %}
						<li class="breadcrumb-item active" aria-current="page">{{ item }}</li>
					{% endif %}
				{% endfor %}
			</ol>
		</nav>

		<div
			class="character-sheet-container">
			{# En-tête améliorée #}
			<div class="character-sheet-header">
				<div class="character-sheet-status-badge {% if character.status == 'validated' %}badge bg-success{% elseif character.status == 'rejected' %}badge bg-danger{% elseif character.status == 'abandoned' %}badge bg-secondary{% else %}badge bg-warning{% endif %} mb-3">
					<i class="fas {% if character.status == 'validated' %}fa-check-circle{% elseif character.status == 'rejected' %}fa-times-circle{% elseif character.status == 'abandoned' %}fa-trash-alt{% elseif character.status == 'editing' %}fa-pencil-alt{% else %}fa-clock{% endif %}"></i>
			{{ {
                    'draft': 'Brouillon',
                    'pending': 'En attente de validation',
                    'validated': 'Validé',
                    'rejected': 'Refusé',
                    'abandoned': 'Abandonné',
                    'editing': 'En cours d\'édition'
                }[character.status] }}
                {% if character.statusMessage %}{% endif %}
            </div>

            <div class="character-profile-header">
                <div class="character-avatar-banner">
                    {% if character.avatar %}
                        <div class="character-avatar-large">
                            <img src="{{ character.avatar }}" alt="{{ character.name }}">
                        </div>
                    {% else %}
                        <div class="character-avatar-large character-avatar-placeholder">
                            <i class="fas fa-user-circle"></i>
                        </div>
                    {% endif %}
                </div>
                
                <div class="character-header-content">
                    <h1 class="character-name-title">{{ character.name }}</h1>
                    
                    <div class="character-quick-info">
                        {% if character.firstName or character.lastName %}
                            <div class="character-info-badge">
                                <i class="fas fa-id-card"></i>
                                {{ [character.firstName, character.lastName]|filter(v => v)|join(' ') }}
                            </div>
                        {% endif %}
                        
                        {% if character.moralAffiliation %}
                            <div class="character-info-badge">
                                <span class="badge {% if character.moralAffiliation == 'Super-héros' %}bg-primary{% elseif character.moralAffiliation == 'Super-vilain' %}bg-danger{% elseif character.moralAffiliation == 'Anti-héros' %}bg-warning{% elseif character.moralAffiliation == 'Vigilante' %}bg-info{% else %}bg-secondary{% endif %}">
                                    {{ character.moralAffiliation }}
                                </span>
                            </div>
                        {% endif %}
                        
                        {% if character.universe %}
                            <div class="character-info-badge">
                                <i class="fas fa-globe-americas"></i>
                                {{ character.universe.name }}
                            </div>
                        {% endif %}
                        
                        <div class="character-info-badge">
                            <i class="fas fa-user"></i>
                            {{ character.user.pseudo }}
                        </div>
                    </div>
                </div>
            </div>
            
            {% if isOwner or isModerator %}
                <div class="character-sheet-header-actions">
                    <div class="dropdown">
                        <button class="btn btn-outline-light dropdown-toggle" type="button" id="threadActionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-cog"></i> Actions
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="threadActionsDropdown">
                            {% if isOwner and character.status != 'validated' and character.status != 'abandoned' %}
                                <li>
                                    <a href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}" class="dropdown-item">
                                        <i class="fas fa-edit"></i> Modifier la fiche
                                    </a>
                                </li>
                            {% endif %}
                            
                            {% if isModerator %}
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#characterValidationModal">
                                        <i class="fas fa-check-circle text-success"></i> Valider le personnage
                                    </button>
                                </li>
                                 <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#characterRejectionModal">
                                        <i class="fas fa-times-circle text-danger"></i> Demander une modification
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#characterRejectionModal">
                                        <i class="fas fa-times-circle text-danger"></i> Refuser le personnage
                                    </button>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>
        
        {# Section d'informations #}
        <div class="character-info-section glass-panel">
            <div class="character-sheet-info-grid">
                {% if character.pseudonyms %}
                <div class="character-sheet-info-item">
                    <div class="character-sheet-info-label">Pseudonymes</div>
                    <div class="character-sheet-info-value">{{ character.pseudonyms }}
				</div>
			</div>
		{% endif %}

		{% if character.factions %}
			<div class="character-sheet-info-item">
				<div class="character-sheet-info-label">Factions</div>
				<div class="character-sheet-info-value">{{ character.factions }}</div>
			</div>
		{% endif %}

		{% if character.gender or character.sexualOrientation %}
			<div class="character-sheet-info-item">
				<div class="character-sheet-info-label">Identité</div>
				<div class="character-sheet-info-value">
					{% if character.gender %}
						{{ character.gender }}
					{% endif %}
					{% if character.gender and character.sexualOrientation %}
						•
					{% endif %}
					{% if character.sexualOrientation %}
						{{ character.sexualOrientation }}
					{% endif %}
				</div>
			</div>
		{% endif %}

		{% if character.civilStatus %}
			<div class="character-sheet-info-item">
				<div class="character-sheet-info-label">Statut civil</div>
				<div class="character-sheet-info-value">{{ character.civilStatus }}</div>
			</div>
		{% endif %}

		{% if character.occupation %}
			<div class="character-sheet-info-item">
				<div class="character-sheet-info-label">Occupation</div>
				<div class="character-sheet-info-value">{{ character.occupation }}</div>
			</div>
		{% endif %}

		{% if character.alias %}
			<div class="character-sheet-info-item">
				<div class="character-sheet-info-label">Alias</div>
				<div class="character-sheet-info-value">{{ character.alias }}</div>
			</div>
		{% endif %}
	</div>
</div>

{# Si l'utilisateur est le propriétaire et que la fiche n'est pas validée/abandonnée, afficher les actions de statut #}
{% if isOwner and character.status != 'validated' and character.status != 'abandoned' %}
	<div class="character-sheet-status-actions glass-panel mt-4">
		<h5>
			<i class="fas fa-tasks"></i>
			Modifier le statut</h5>
		<form action="{{ path('app_thread_update_character_status', {'id': thread.id}) }}" method="post">
			<div class="row g-3">
				<div class="col-md-4">
					<label for="status" class="form-label">Statut</label>
					<select name="status" id="status" class="form-select">
						{% if character.status == 'draft' %}
							<option value="pending">Soumettre pour validation</option>

						{% endif %}
						{% if character.status == 'rejected' or character.status == 'editing' %}
							<option value="pending">Soumettre à nouveau</option>
						{% endif %}
						<option value="abandoned">Abandonner la fiche</option>
						<option value="draft">Retoucher ma fiche</option>

					</select>
				</div>

				<div class="col-md-8">
					<label for="status_message" class="form-label">Message de statut (facultatif)</label>
					<input type="text" name="status_message" id="status_message" class="form-control" placeholder="Ex: En attente de validation">
				</div>
			</div>

			<div class="mt-3">
				<button type="submit" class="btn btn-primary">
					<i class="fas fa-save"></i>
					Mettre à jour le statut
				</button>
			</div>
		</form>
	</div>
{% endif %}

{# Si c'est un modérateur, afficher les contrôles de modération #}
{% if isModerator and character.status != 'validated' and character.status != 'abandoned' %}
	<div class="character-sheet-validation-controls glass-panel mt-4">
		<h5>
			<i class="fas fa-shield-alt"></i>
			Actions de modération</h5>
		<div class="character-sheet-moderation-actions">
			<button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#characterValidationModal">
				<i class="fas fa-check-circle"></i>
				Valider
			</button>
			<button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#characterRejectionModal">
				<i class="fas fa-times-circle"></i>
				Refuser
			</button>

			<button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#characterModified">
				<i class="fas fa-times-circle text-danger"></i>
				Demander une modification
			</button>

		</div>
	</div>
{% endif %}

{# Tabs pour la navigation générale #}
<div class="character-content-tabs glass-panel mt-4">
	<ul class="nav nav-tabs" id="mainCharacterTabs" role="tablist">
		<li class="nav-item" role="presentation">
			<button class="nav-link active" id="character-content-tab" data-bs-toggle="tab" data-bs-target="#character-content" type="button" role="tab">
				<i class="fas fa-file-alt"></i>
				Fiche du personnage
			</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="comments-tab" data-bs-toggle="tab" data-bs-target="#comments" type="button" role="tab">
				<i class="fas fa-comments"></i>
				Commentaires
				<span class="badge bg-secondary">{{ posts|length > 1 ? posts|length - 1 : 0 }}</span>
			</button>
		</li>
		{% if character.moderationNote and (isModerator or isOwner) %}
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="moderation-tab" data-bs-toggle="tab" data-bs-target="#moderation" type="button" role="tab">
					<i class="fas fa-info-circle"></i>
					Notes de modération
				</button>
			</li>
		{% endif %}
	</ul>

	<div
		class="tab-content p-4" id="mainCharacterTabContent">
		{# Tab Fiche du personnage avec sous-onglets #}
		<div class="tab-pane fade show active" id="character-content" role="tabpanel" aria-labelledby="character-content-tab">
			{% if thread.posts.first %}
				<div class="character-content-inner-tabs">
					<ul class="nav nav-pills mb-3" id="characterSheetContentTabs" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="bio-tab" data-bs-toggle="tab" data-bs-target="#bio" type="button" role="tab">
								<i class="fas fa-book-open"></i>
								Biographie
							</button>
						</li>
						{% if character.personality %}
							<li class="nav-item" role="presentation">
								<button class="nav-link" id="personality-tab" data-bs-toggle="tab" data-bs-target="#personality" type="button" role="tab">
									<i class="fas fa-brain"></i>
									Personnalité
								</button>
							</li>
						{% endif %}
						{% if character.appearance %}
							<li class="nav-item" role="presentation">
								<button class="nav-link" id="appearance-tab" data-bs-toggle="tab" data-bs-target="#appearance" type="button" role="tab">
									<i class="fas fa-user"></i>
									Apparence
								</button>
							</li>
						{% endif %}
						{% if character.abilities %}
							<li class="nav-item" role="presentation">
								<button class="nav-link" id="abilities-tab" data-bs-toggle="tab" data-bs-target="#abilities" type="button" role="tab">
									<i class="fas fa-bolt"></i>
									Capacités
								</button>
							</li>
						{% endif %}
						{% if character.equipment %}
							<li class="nav-item" role="presentation">
								<button class="nav-link" id="equipment-tab" data-bs-toggle="tab" data-bs-target="#equipment" type="button" role="tab">
									<i class="fas fa-toolbox"></i>
									Équipement
								</button>
							</li>
						{% endif %}
						{% if character.weaknesses %}
							<li class="nav-item" role="presentation">
								<button class="nav-link" id="weaknesses-tab" data-bs-toggle="tab" data-bs-target="#weaknesses" type="button" role="tab">
									<i class="fas fa-skull-crossbones"></i>
									Faiblesses
								</button>
							</li>
						{% endif %}
					</ul>

					<div class="tab-content character-sheet-content-area" id="characterSheetTabContent">
						<div class="tab-pane fade show active" id="bio" role="tabpanel" aria-labelledby="bio-tab">
							<div class="character-sheet-description">
								{% if character.biography %}
									{{ character.biography|raw }}
								{% else %}
									<p class="text-muted fst-italic">Aucune biographie n'a été rédigée pour ce personnage.</p>
								{% endif %}
							</div>
						</div>

						{% if character.personality %}
							<div class="tab-pane fade" id="personality" role="tabpanel" aria-labelledby="personality-tab">
								<div class="character-sheet-description">
									{{ character.personality|raw }}
								</div>
							</div>
						{% endif %}

						{% if character.appearance %}
							<div class="tab-pane fade" id="appearance" role="tabpanel" aria-labelledby="appearance-tab">
								<div class="character-sheet-description">
									{{ character.appearance|raw }}
								</div>
							</div>
						{% endif %}

						{% if character.abilities %}
							<div class="tab-pane fade" id="abilities" role="tabpanel" aria-labelledby="abilities-tab">
								<div class="character-sheet-description">
									{{ character.abilities|raw }}
								</div>
							</div>
						{% endif %}

						{% if character.equipment %}
							<div class="tab-pane fade" id="equipment" role="tabpanel" aria-labelledby="equipment-tab">
								<div class="character-sheet-description">
									{{ character.equipment|raw }}
								</div>
							</div>
						{% endif %}

						{% if character.weaknesses %}
							<div class="tab-pane fade" id="weaknesses" role="tabpanel" aria-labelledby="weaknesses-tab">
								<div class="character-sheet-description">
									{{ character.weaknesses|raw }}
								</div>
							</div>
						{% endif %}
					</div>
				</div>
			{% else %}
				<div class="character-content-empty text-center">
					<p class="text-muted fst-italic">Cette fiche ne contient pas encore de contenu.</p>
				</div>
			{% endif %}
		</div>

		<div class="tab-pane fade" id="comments" role="tabpanel" aria-labelledby="comments-tab">
			<div class="character-sheet-comments">
				{% if posts|length > 1 %}
					{% for post in posts %}
						{% if not loop.first %}
							<div class="character-sheet-comment-item">
								<div class="character-sheet-comment-header">
									<div class="character-sheet-comment-author">
										<strong>{{ post.author.pseudo }}</strong>
										<small class="text-muted ms-2">{{ post.createdAt|date('d/m/Y H:i') }}</small>
									</div>
								</div>
								<div class="character-sheet-comment-content">
									{{ post.content|raw }}
								</div>
							</div>
						{% endif %}
					{% endfor %}
				{% else %}
					<div class="character-sheet-no-comments">
						<p class="text-muted fst-italic">Aucun commentaire pour le moment.</p>
					</div>
				{% endif %}

				{% if canReply and app.user %}
					<div class="character-sheet-comment-form mt-4">
						<h5>
							<i class="fas fa-reply"></i>
							Ajouter un commentaire</h5>
						{{ form_start(form) }}
						{{ form_widget(form) }}
						<button type="submit" class="btn btn-primary mt-3">
							<i class="fas fa-paper-plane"></i>
							Envoyer
						</button>
						{{ form_end(form) }}
					</div>
				{% endif %}
			</div>
		</div>

		{% if character.moderationNote and (isModerator or isOwner) %}
			<div class="tab-pane fade" id="moderation" role="tabpanel" aria-labelledby="moderation-tab">
				<div class="character-sheet-moderation-note">
					<div class="moderation-note-header">
						<i class="fas fa-info-circle text-primary"></i>
						Note(s) de modération
					</div>
					<div class="moderation-note-content">
						{{ character.moderationNote|nl2br }}
					</div>
				</div>
			</div>
		{% endif %}
	</div>
</div>

{% if character.validatedAt %}
	<div class="character-sheet-validation-info text-end mt-3">
		<small class="text-muted">
			<i class="fas fa-check-circle text-success"></i>
			Validé le
			{{ character.validatedAt|date('d/m/Y') }}
		</small>
	</div>
{% endif %}</div></div><!-- Modal de validation du personnage -->{% if isModerator %}<div class="modal fade" id="characterValidationModal" tabindex="-1" aria-labelledby="characterValidationModalLabel" aria-hidden="true">
<div class="modal-dialog">
	<div class="modal-content">
		<div class="modal-header">
			<h5 class="modal-title" id="characterValidationModalLabel">Valider le personnage</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
		</div>
		<form action="{{ path('app_thread_update_character_status', {'id': thread.id}) }}" method="post">
			<div class="modal-body">
				<p>Vous êtes sur le point de valider le personnage "<strong>{{ character.name }}</strong>".</p>
				<div class="mb-3">
					<label for="moderation_note" class="form-label">Note de modération (facultatif)</label>
					<textarea name="moderation_note" id="moderation_note" class="form-control" rows="3" placeholder="Ajoutez une note ou des commentaires..."></textarea>
				</div>
				<input type="hidden" name="status" value="validated">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
				<button type="submit" class="btn btn-success">Valider</button>
			</div>
		</form>
	</div>
</div></div><div class="modal fade" id="characterRejectionModal" tabindex="-1" aria-labelledby="characterRejectionModalLabel" aria-hidden="true">
<div class="modal-dialog">
	<div class="modal-content">
		<div class="modal-header">
			<h5 class="modal-title" id="characterRejectionModalLabel">Refuser le personnage</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
		</div>
		<form action="{{ path('app_thread_update_character_status', {'id': thread.id}) }}" method="post">
			<div class="modal-body">
				<p>Vous êtes sur le point de refuser le personnage "<strong>{{ character.name }}</strong>".</p>
				<div class="mb-3">
					<label for="moderation_note" class="form-label">Raison du refus</label>
					<textarea name="moderation_note" id="moderation_note" class="form-control" rows="3" placeholder="Expliquez pourquoi la fiche est refusée..." required></textarea>
				</div>
				<input type="hidden" name="status" value="rejected">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
				<button type="submit" class="btn btn-danger">Refuser</button>
			</div>
		</form>
	</div>
</div></div>

<div class="modal fade" id="characterModified" tabindex="-1" aria-labelledby="characterModifiedLabel" aria-hidden="true">
<div class="modal-dialog">
	<div class="modal-content">
		<div class="modal-header">
			<h5 class="modal-title" id="characterModifiedLabel">Demander une modification</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
		</div>
		<form action="{{ path('app_thread_update_character_status', {'id': thread.id}) }}" method="post">
			<div class="modal-body">
				<p>Vous êtes sur le point de demander des modifications pour le personnage "<strong>{{ character.name }}</strong>".</p>
				<div class="mb-3">
					<label for="moderation_note" class="form-label">Modifications demandées</label>
					<textarea name="moderation_note" id="moderation_note" class="form-control" rows="3" placeholder="Détaillez les modifications demandées..." required></textarea>
				</div>
				<input type="hidden" name="status" value="editing">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
				<button type="submit" class="btn btn-warning">Demander des modifications</button>
			</div>
		</form>
	</div>
</div></div>{% endif %}<style>/* Nouvelles styles pour la fiche de personnage */
.character-sheet-container {
	font-family: var(--font-main);
	max-width: 1200px;
	margin: 0 auto;
}

.character-sheet-header {
	background: linear-gradient(135deg, var(--roleplay-primary), var(--roleplay-secondary));
	border-radius: var(--border-radius-lg);
	padding: 2rem;
	margin-bottom: 1.5rem;
	position: relative;
	box-shadow: 0 10px 25px rgba(92, 45, 145, 0.3);
	overflow: hidden;
}

.character-sheet-header::before {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.1), transparent 70%);
	pointer-events: none;
}

.character-profile-header {
	display: flex;
	align-items: center;
	gap: 2rem;
	position: relative;
	z-index: 2;
}

.character-avatar-banner {
	flex-shrink: 0;
}

.character-avatar-large {
	width: 150px;
	height: 150px;
	border-radius: 50%;
	overflow: hidden;
	border: 4px solid rgba(255, 255, 255, 0.8);
	box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
}

.character-avatar-placeholder {
	background: rgba(10, 10, 10, 0.5);
	display: flex;
	align-items: center;
	justify-content: center;
}

.character-avatar-placeholder i {
	font-size: 4rem;
	color: rgba(255, 255, 255, 0.5);
}

.character-avatar-large img {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.character-header-content {
	flex: 1;
}

.character-name-title {
	color: white;
	font-family: var(--font-title);
	font-size: 2.5rem;
	margin-bottom: 0.5rem;
	text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}

.character-quick-info {
	display: flex;
	flex-wrap: wrap;
	gap: 1rem;
	margin-top: 1rem;
}

.character-info-badge {
	background: rgba(0, 0, 0, 0.3);
	padding: 0.5rem 1rem;
	border-radius: 20px;
	color: white;
	font-size: 0.9rem;
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
	backdrop-filter: blur(5px);
	-webkit-backdrop-filter: blur(5px);
	border: 1px solid rgba(255, 255, 255, 0.1);
}

.character-info-badge i {
	color: var(--roleplay-light);
}

.character-sheet-status-badge {
	position: absolute;
	top: 1rem;
	right: 1rem;
	z-index: 10;
	padding: 0.5rem 1rem;
	border-radius: 20px;
	box-shadow: 0 3px 10px rgba(0, 0, 0, 0.2);
	font-family: var(--font-special);
	text-transform: uppercase;
	letter-spacing: 1px;
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.character-sheet-header-actions {
	position: absolute;
	bottom: 1rem;
	right: 1rem;
	z-index: 10;
}

.character-info-section {
	padding: 1.5rem;
	margin-bottom: 1.5rem;
}

.character-sheet-info-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
	grid-gap: 1.5rem;
}

.character-sheet-info-item {
	display: flex;
	flex-direction: column;
}

.character-sheet-info-label {
	font-size: 0.9rem;
	color: var(--light-gray);
	margin-bottom: 0.3rem;
}

.character-sheet-info-value {
	font-size: 1.05rem;
	color: var(--text-white);
}

.character-content-tabs {
	overflow: hidden;
}

.character-content-tabs .nav-tabs {
	background-color: rgba(10, 10, 10, 0.3);
	border-bottom: 1px solid rgba(156, 85, 211, 0.2);
}

.character-content-tabs .nav-link {
	color: var(--light-gray) !important;
	border: none;
	padding: 1rem 1.5rem !important;
	font-family: var(--font-special);
	letter-spacing: 1px;
	border-bottom: 3px solid transparent;
	transition: all 0.3s ease;
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.character-content-tabs .nav-link i {
	color: var(--roleplay-accent);
}

.character-content-tabs .nav-link:hover {
	background-color: rgba(156, 85, 211, 0.1);
	border-bottom: 3px solid var(--roleplay-secondary);
}

.character-content-tabs .nav-link.active {
	background-color: rgba(156, 85, 211, 0.2);
	color: white !important;
	border-bottom: 3px solid var(--roleplay-accent);
	font-weight: 500;
}

/* Styles pour les sous-onglets de la fiche */
.character-content-inner-tabs {
	padding: 0.5rem 0 1.5rem;
}

.character-content-inner-tabs .nav-pills {
	margin-bottom: 1.5rem;
	border-radius: var(--border-radius);
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
}

.character-content-inner-tabs .nav-pills .nav-link {
	background-color: rgba(30, 30, 30, 0.6);
	color: var(--light-gray) !important;
	border-radius: var(--border-radius);
	padding: 0.6rem 1rem;
	transition: all 0.3s ease;
	margin-right: 0.5rem;
	margin-bottom: 0.5rem;
	display: flex;
	align-items: center;
	gap: 0.5rem;
}

.character-content-inner-tabs .nav-pills .nav-link i {
	color: var(--roleplay-light);
	font-size: 0.9rem;
}

.character-content-inner-tabs .nav-pills .nav-link:hover {
	background-color: rgba(156, 85, 211, 0.2);
}

.character-content-inner-tabs .nav-pills .nav-link.active {
	background: linear-gradient(135deg, var(--roleplay-primary), var(--roleplay-secondary));
	color: white !important;
	box-shadow: 0 4px 10px rgba(92, 45, 145, 0.3);
}

.character-content-inner-tabs .nav-pills .nav-link.active i {
	color: white;
}

.character-sheet-content-area {
	background: rgba(15, 15, 15, 0.2);
	padding: 1.5rem;
	border-radius: var(--border-radius);
	min-height: 300px;
}

.character-sheet-description {
	line-height: 1.8;
	font-size: 1.05rem;
	color: var(--text-white);
}

.character-content-empty {
	padding: 3rem 1rem;
}

.character-sheet-validation-info {
	font-family: var(--font-special);
	letter-spacing: 1px;
}

/* Commentaires */
.character-sheet-comment-item {
	background: rgba(30, 30, 30, 0.3);
	border-radius: var(--border-radius);
	margin-bottom: 1.5rem;
	border-left: 3px solid var(--roleplay-secondary);
}

.character-sheet-comment-header {
	padding: 0.75rem 1rem;
	background: rgba(20, 20, 20, 0.3);
	border-radius: var(--border-radius) var(--border-radius) 0 0;
	border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.character-sheet-comment-content {
	padding: 1.25rem;
}

.character-sheet-no-comments {
	text-align: center;
	padding: 3rem 1rem;
	background: rgba(30, 30, 30, 0.2);
	border-radius: var(--border-radius);
}

.character-sheet-comment-form {
	background: rgba(30, 30, 30, 0.3);
	border-radius: var(--border-radius);
	padding: 1.5rem;
}

.character-sheet-comment-form h5 {
	margin-bottom: 1.5rem;
	color: var(--text-white);
	font-family: var(--font-special);
}

/* Status controls */
.character-sheet-status-actions {
	padding: 1.5rem;
}

.character-sheet-status-actions h5 {
	margin-bottom: 1.5rem;
	color: var(--text-white);
	font-family: var(--font-special);
}

.character-sheet-validation-controls {
	padding: 1.5rem;
}

.character-sheet-validation-controls h5 {
	margin-bottom: 1.5rem;
	color: var(--text-white);
	font-family: var(--font-special);
}

.character-sheet-moderation-actions {
	display: flex;
	gap: 1rem;
}

/* Moderation notes */
.character-sheet-moderation-note {
	background: rgba(30, 30, 30, 0.3);
	border-radius: var(--border-radius);
}

.moderation-note-header {
	padding: 1rem;
	background: rgba(13, 110, 253, 0.1);
	border-radius: var(--border-radius) var(--border-radius) 0 0;
	font-family: var(--font-special);
	border-bottom: 1px solid rgba(13, 110, 253, 0.2);
	color: var(--text-white);
}

.moderation-note-content {
	padding: 1.5rem;
	white-space: pre-line;
}

@media(max-width: 768px) {
	.character-profile-header {
		flex-direction: column;
		text-align: center;
	}

	.character-name-title {
		font-size: 2rem;
	}

	.character-quick-info {
		justify-content: center;
	}

	.character-sheet-status-badge {
		position: relative;
		top: 0;
		right: 0;
		margin: 0 auto 1rem;
		display: flex;
		justify-content: center;
	}

	.character-sheet-header-actions {
		position: relative;
		text-align: center;
		bottom: auto;
		right: auto;
		margin-top: 1.5rem;
	}

	.character-content-tabs .nav-tabs {
		flex-wrap: nowrap;
		overflow-x: auto;
	}

	.character-content-tabs .nav-link {
		white-space: nowrap;
		padding: 0.75rem 1rem !important;
	}

	.character-sheet-info-grid {
		grid-template-columns: 1fr;
	}

	.character-content-inner-tabs .nav-pills {
		overflow-x: auto;
		flex-wrap: nowrap;
		padding-bottom: 0.5rem;
	}

	.character-content-inner-tabs .nav-pills .nav-link {
		white-space: nowrap;
	}
}</style> <script>
		document.addEventListener('DOMContentLoaded', function() {
		    // Activer le premier onglet principal
		    var mainFirstTabTrigger = document.querySelector('#mainCharacterTabs button:first-child');
		    if (mainFirstTabTrigger) {
		        var mainTab = new bootstrap.Tab(mainFirstTabTrigger);
		        mainTab.show();
		    }
		    
		    // Activer le premier sous-onglet de la fiche
		    var contentFirstTabTrigger = document.querySelector('#characterSheetContentTabs button:first-child');
		    if (contentFirstTabTrigger) {
		        var contentTab = new bootstrap.Tab(contentFirstTabTrigger);
		        contentTab.show();
		    }
		});
		</script>{% endblock %}
