{% extends 'base.html.twig' %}

{% block title %}Toutes mes participations - DC Earth{% endblock %}

{% block body %}
<div class="container my-4">
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}

    <div class="row">
        {# Sidebar avec les filtres #}
        <div class="col-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h3 class="h5 mb-0">Filtres</h3>
                </div>
                <div class="card-body">
                    <div class="filter-nav flex-column">
                        <a href="{{ path('app_all_my_participations') }}" 
                           class="filter-item {% if status is empty %}active{% endif %}">
                            <i class="fas fa-globe me-2"></i>Toutes
                        </a>
                        <a href="{{ path('app_all_my_participations', {'status': 'open'}) }}" 
                           class="filter-item {% if status == 'open' %}active{% endif %}">
                            <i class="fas fa-door-open me-2"></i>Ouvertes
                        </a>
                        <a href="{{ path('app_all_my_participations', {'status': 'closed'}) }}" 
                           class="filter-item {% if status == 'closed' %}active{% endif %}">
                            <i class="fas fa-lock me-2"></i>Fermées
                        </a>
                        <a href="{{ path('app_all_my_participations', {'status': 'archived'}) }}" 
                           class="filter-item {% if status == 'archived' %}active{% endif %}">
                            <i class="fas fa-archive me-2"></i>Archivées
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Liste des discussions #}
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="row align-items-center">
                        <div class="col">
                            <h1 class="h3 mb-0">{{ title }}</h1>
                            <small class="text-muted">{{ threads|length }} participation{% if threads|length > 1 %}s{% endif %} trouvée{% if threads|length > 1 %}s{% endif %}</small>
                        </div>
                    </div>
                </div>

                <div class="list-group list-group-flush">
                    {% for thread in threads %}
                        <a href="{{ path('app_thread_show', {'universeSlug': thread.forum.universe ? thread.forum.universe.slug : thread.forum.elseworld.parentUniverse.slug, 'id': thread.id}) }}" 
                           class="list-group-item list-group-item-action p-3">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="thread-main flex-grow-1">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        {% if thread.sticky %}
                                            <i class="fas fa-thumbtack text-warning" title="Épinglé"></i>
                                        {% endif %}
                                        
                                        <h5 class="mb-0">{{ thread.title }}</h5>

                                        <span class="badge bg-roleplay">RP</span>

                                        {% if thread.status != 'open' %}
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-lock me-1"></i>{{ thread.status|title }}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <p class="text-muted mb-2">
                                        {{ thread.description|striptags|u.truncate(150, '...') }}
                                    </p>

                                    <div class="thread-meta small text-muted">
                                        <span class="me-3">
                                            <i class="fas fa-user me-1"></i>
                                            {% if thread.characterCreator %}
                                                <span class="character-name">{{ thread.characterCreator.name }}</span>
                                            {% else %}
                                                {{ thread.author.pseudo }}
                                            {% endif %}
                                        </span>

                                        <span class="me-3">
                                            <i class="fas fa-folder me-1"></i>{{ thread.forum.name }}
                                        </span>

                                        <span class="me-3">
                                            <i class="fas fa-globe me-1"></i>
                                            {% if thread.forum.universe %}
                                                {{ thread.forum.universe.name }}
                                            {% else %}
                                                {{ thread.forum.elseworld.parentUniverse.name }} > {{ thread.forum.elseworld.name }}
                                            {% endif %}
                                        </span>

                                        {% if thread.location %}
                                            <span class="me-3">
                                                <i class="fas fa-map-marker-alt me-1"></i>{{ thread.location.name }}
                                            </span>
                                        {% endif %}
                                        
                                        <span class="me-3">
                                            <i class="fas fa-clock me-1"></i>{{ thread.updatedAt|date('d/m/Y H:i') }}
                                        </span>
                                    </div>
                                </div>

                                <div class="thread-stats text-end ms-3">
                                    <div class="mb-1">
                                        <span class="badge bg-light text-dark" title="Réponses">
                                            <i class="fas fa-comments me-1"></i>{{ thread.posts|length - 1 }}
                                        </span>
                                    </div>

                                    <div>
                                        <span class="badge bg-light text-dark" title="Participants">
                                            <i class="fas fa-users me-1"></i>
                                            {% if thread.maxParticipants %}
                                                {{ thread.participants|length }}/{{ thread.maxParticipants }}
                                            {% else %}
                                                {{ thread.participants|length }}
                                            {% endif %}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <div class="text-center py-5">
                            <div class="empty-state">
                                <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                                <h3>Aucune participation trouvée</h3>
                                <p class="text-muted mb-3">
                                    Vous ne participez à aucune discussion
                                    {% if status %}avec le statut "{{ status }}"{% endif %}.
                                </p>
                                <p class="text-muted">
                                    <strong>Debug info:</strong> Cette page montre toutes vos participations dans tous les univers.
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.h3, .h5 {
    color: rgb(0, 0, 0);
}

.character-name {
    color: var(--roleplay-primary);
    font-weight: 600;
}

.thread-stats {
    min-width: 100px;
}

.empty-state {
    color: rgb(188, 194, 199);
}

.filter-nav {
    display: flex;
    gap: 0.5rem;
}

.filter-item {
    display: block;
    padding: 0.75rem 1rem;
    color: rgb(179, 179, 179);
    text-decoration: none;
    border-radius: 0.375rem;
    font-weight: 500;
    border-left: 3px solid transparent;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: 0.25rem;
}

.filter-item.active {
    background-color: var(--roleplay-primary);
    color: white;
    border-left-color: var(--roleplay-accent);
    box-shadow: 0 2px 8px rgba(4, 118, 242, 0.3);
}

.filter-item:not(.active):hover {
    background-color: rgba(79, 156, 247, 0.1);
    color: var(--roleplay-primary);
    border-left-color: var(--roleplay-light);
}

.filter-item i {
    width: 1.25rem;
    text-align: center;
    transition: transform 0.2s ease;
}
</style>
{% endblock %} 