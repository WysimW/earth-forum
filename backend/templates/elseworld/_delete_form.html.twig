<form method="post" action="{{ path('app_elseworld_delete', {'id': elseworld.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet Elseworld ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ elseworld.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form> 