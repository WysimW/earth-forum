{% extends 'base.html.twig' %}

{% block title %}Factions{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    {# Header principal avec bouton pour créer une faction #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Factions</h1>
        <div>
            {% if is_granted('ROLE_USER') and app.user.canCreateFaction() %}
                <a href="{{ path('app_faction_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Nouvelle faction
                </a>
            {% endif %}
        </div>
    </div>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {% if universes|length > 0 %}
        {% for universe in universes %}
            {% set universeFactions = factions|filter(faction => faction.universe.id == universe.id) %}
            {% if universeFactions|length > 0 %}
                <div class="universe-section">
                    <div class="universe-header">
                        <h2><i class="fas fa-globe-americas me-2"></i>{{ universe.name }}</h2>
                        <div>
                            <a href="{{ path('app_factions_by_universe', {'universeSlug': universe.slug}) }}" class="btn btn-sm btn-light">
                                <i class="fas fa-eye me-1"></i> Voir tout
                            </a>
                        </div>
                    </div>
                    
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                        {% for faction in universeFactions %}
                            <div class="col">
                                <div class="card faction-card shadow-sm h-100">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        {% if faction.icon %}
                                        <div class="faction-icon me-2">
                                            <img src="{{ faction.icon }}" alt="Icône {{ faction.name }}" style="height: 24px; width: auto;">
                                        </div>
                                        {% endif %}
                                        <h5 class="mb-0">{{ faction.name }}</h5>
                                        {% if faction.alignment %}
                                            <span class="faction-badge alignment-{{ faction.alignment }}">
                                                {% if faction.alignment == 'hero' %}Super-héros
                                                {% elseif faction.alignment == 'villain' %}Super-vilain
                                                {% elseif faction.alignment == 'antihero' %}Anti-héros
                                                {% elseif faction.alignment == 'vigilante' %}Vigilante
                                                {% elseif faction.alignment == 'neutral' %}Neutre
                                                {% else %}Autre{% endif %}
                                            </span>
                                        {% endif %}
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text">
                                            {% if faction.description %}
                                                {{ faction.description|striptags|length > 150 ? faction.description|striptags|slice(0, 150) ~ '...' : faction.description|striptags }}
                                            {% else %}
                                                <em class="text-muted">Aucune description disponible</em>
                                            {% endif %}
                                        </p>
                                        
                                        <div class="mt-2">
                                            {% if faction.characters|length > 0 %}
                                                <div class="mb-1">
                                                    <i class="fas fa-users me-1 text-primary"></i> 
                                                    <small>{{ faction.characters|length }} membre(s)</small>
                                                </div>
                                            {% endif %}
                                            
                                            {% if faction.npcs|length > 0 %}
                                                <div>
                                                    <i class="fas fa-user-tie me-1 text-secondary"></i> 
                                                    <small>{{ faction.npcs|length }} PNJ(s)</small>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="card-footer">
                                        <span class="faction-badge status-{{ faction.status }}">
                                            {{ faction.status == 'open' ? 'Ouvert' : 'Fermé' }}
                                        </span>
                                        <a href="{{ path('app_faction_show', {'universeSlug': faction.universe.slug, 'factionSlug': faction.slug}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-eye me-1"></i> Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="mb-3">Aucun univers disponible</h3>
                <p class="text-muted">Les administrateurs doivent d'abord créer des univers avant que des factions puissent être créées.</p>
            </div>
        </div>
    {% endif %}
    
    {% if factions|length == 0 %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="mb-3">Aucune faction n'a encore été créée</h3>
                <p class="text-muted mb-4">Soyez le premier à créer une faction !</p>
                {% if is_granted('ROLE_USER') and app.user.canCreateFaction() %}
                    <a href="{{ path('app_faction_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Créer une faction
                    </a>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %} 