{% extends 'base.html.twig' %}

{% block title %}{{ faction.name }} - Faction{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {# En-tête de la faction #}
    <div class="faction-header" 
    {% if faction.headquarters and faction.headquarters.image %}
         style="background-image: url('{{ asset(faction.headquarters.image) }}');"
    {% else %}
         style="background-image: url('{{ asset('images/default-faction-banner.jpg') }}');"
    {% endif %}
    >
        <div class="faction-header-content">
            <div class="faction-header-main">
                <h1>{{ faction.name }}</h1>
                <div class="d-flex align-items-center mb-3">
                    {% if faction.alignment %}
                        <span class="faction-badge alignment-{{ faction.alignment }}">
                            {% if faction.alignment == 'hero' %}Super-héros
                            {% elseif faction.alignment == 'villain' %}Super-vilain
                            {% elseif faction.alignment == 'antihero' %}Anti-héros
                            {% elseif faction.alignment == 'vigilante' %}Vigilante
                            {% elseif faction.alignment == 'neutral' %}Neutre
                            {% else %}Autre{% endif %}
                        </span>
                    {% endif %}
                    
                    <span class="faction-badge status-{{ faction.status }}">
                        {{ faction.status == 'open' ? 'Ouvert aux recrutements' : 'Fermé aux recrutements' }}
                    </span>
                    
                    {% if faction.scope %}
                        <span class="faction-badge">
                            {% if faction.scope == 'galaxy' %}Portée galactique
                            {% elseif faction.scope == 'international' %}Portée internationale
                            {% elseif faction.scope == 'national' %}Portée nationale
                            {% elseif faction.scope == 'regional' %}Portée régionale
                            {% elseif faction.scope == 'local' %}Portée locale
                            {% endif %}
                        </span>
                    {% endif %}
                </div>
                
                <div class="faction-info mb-1">
                    <i class="fas fa-globe"></i> Univers: <a href="{{ path('app_univers_show', {'slug': faction.universe.slug}) }}" class="text-white">{{ faction.universe.name }}</a>
                </div>
                
                <div class="faction-info">
                    <i class="fas fa-user"></i> Fondateur: {{ faction.founder.pseudo }}
                </div>
                
                {% if faction.characters|length > 0 or faction.npcs|length > 0 %}
                    <div class="faction-info mt-2">
                        <i class="fas fa-users"></i> {{ faction.characters|length }} membre(s)
                        {% if faction.npcs|length > 0 %}
                            et {{ faction.npcs|length }} PNJ(s)
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            
            {% if faction.logo %}
            <div class="faction-logo">
                <img src="{{ faction.logo }}" alt="Logo {{ faction.name }}" class="img-fluid" style="max-height: 120px;">
            </div>
            {% endif %}
        </div>
    </div>
    
    <div class="row">
        <div class="col-lg-8">
            {# Membres et PNJ #}
            <div class="members-section mb-4">
                <ul class="nav nav-tabs members-tabs" id="membersTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="characters-tab" data-bs-toggle="tab" data-bs-target="#characters-tab-pane" type="button" role="tab" aria-controls="characters-tab-pane" aria-selected="true">
                            <i class="fas fa-users me-1"></i> Membres ({{ faction.characters|length }})
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="npcs-tab" data-bs-toggle="tab" data-bs-target="#npcs-tab-pane" type="button" role="tab" aria-controls="npcs-tab-pane" aria-selected="false">
                            <i class="fas fa-user-tie me-1"></i> PNJ ({{ faction.npcs|length }})
                        </button>
                    </li>
                    {% if faction.scenes|length > 0 %}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="scenes-tab" data-bs-toggle="tab" data-bs-target="#scenes-tab-pane" type="button" role="tab" aria-controls="scenes-tab-pane" aria-selected="false">
                                <i class="fas fa-theater-masks me-1"></i> Scènes ({{ faction.scenes|length }})
                            </button>
                        </li>
                    {% endif %}
                </ul>
                <div class="tab-content" id="membersTabContent">
                    <div class="tab-pane fade show active" id="characters-tab-pane" role="tabpanel" aria-labelledby="characters-tab" tabindex="0">
                        {% if faction.characters|length > 0 %}
                            <div class="row">
                                {% for character in faction.characters %}
                                    <div class="col-md-6">
                                        <div class="member-card d-flex align-items-center">
                                            <img src="{{ character.avatar ? character.avatar : asset('images/default-avatar.png') }}" alt="{{ character.name }}" class="member-avatar">
                                            <div class="member-info">
                                                <div class="member-name">{{ character.name }}</div>
                                                <div class="member-role">{{ character.actualPseudo }}</div>
                                            </div>
                                            <a href="{{ path('app_character_show', {'id': character.id, 'slug': character.slug}) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="placeholder-message">
                                <i class="fas fa-users fa-3x mb-3 text-muted"></i>
                                <h4>Aucun membre pour le moment</h4>
                                <p class="text-muted">Cette faction n'a pas encore de personnages comme membres.</p>
                            </div>
                        {% endif %}
                    </div>
                    <div class="tab-pane fade" id="npcs-tab-pane" role="tabpanel" aria-labelledby="npcs-tab" tabindex="0">
                        {% if faction.npcs|length > 0 %}
                            <div class="row">
                                {% for npc in faction.npcs %}
                                    <div class="col-md-6">
                                        <div class="member-card d-flex align-items-center">
                                            <img src="{{ npc.avatar ? npc.avatar : asset('images/default-avatar.png') }}" alt="{{ npc.name }}" class="member-avatar">
                                            <div class="member-info">
                                                <div class="member-name">{{ npc.name }}</div>
                                                <div class="member-role">{{ npc.occupation }}</div>
                                            </div>
                                            <a href="{{ path('app_npc_show', {'id': npc.id, 'slug': npc.slug}) }}" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="placeholder-message">
                                <i class="fas fa-user-tie fa-3x mb-3 text-muted"></i>
                                <h4>Aucun PNJ pour le moment</h4>
                                <p class="text-muted">Cette faction n'a pas encore de PNJ comme membres.</p>
                            </div>
                        {% endif %}
                    </div>
                    {% if faction.scenes|length > 0 %}
                        <div class="tab-pane fade" id="scenes-tab-pane" role="tabpanel" aria-labelledby="scenes-tab" tabindex="0">
                            <div class="list-group">
                                {% for scene in faction.scenes %}
                                    <a href="{{ path('app_thread_show', {'id': scene.id, 'slug': scene.slug, 'universeSlug': faction.universe.slug}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1">{{ scene.title }}</h6>
                                            <small class="text-muted">{{ scene.createdAt|date('d/m/Y') }}</small>
                                        </div>
                                        <span class="badge bg-primary rounded-pill">{{ scene.postsCount }} message(s)</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {# Description et Objectifs dans des tabs #}
            <div class="members-section mb-4">
                <ul class="nav nav-tabs members-tabs" id="factionInfoTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description-tab-pane" type="button" role="tab" aria-controls="description-tab-pane" aria-selected="true">
                            <i class="fas fa-file-alt me-1"></i> Description
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="objectives-tab" data-bs-toggle="tab" data-bs-target="#objectives-tab-pane" type="button" role="tab" aria-controls="objectives-tab-pane" aria-selected="false">
                            <i class="fas fa-bullseye me-1"></i> Objectifs
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="factionInfoTabContent">
                    <div class="tab-pane fade show active" id="description-tab-pane" role="tabpanel" aria-labelledby="description-tab" tabindex="0">
                        {% if faction.description %}
                            {{ faction.description|raw }}
                        {% else %}
                            <p class="text-muted">Aucune description disponible.</p>
                        {% endif %}
                    </div>
                    <div class="tab-pane fade" id="objectives-tab-pane" role="tabpanel" aria-labelledby="objectives-tab" tabindex="0">
                        {% if faction.objectives %}
                            {{ faction.objectives|raw }}
                        {% else %}
                            <p class="text-muted">Aucun objectif défini.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            {# Quartier général #}
            <div class="faction-card">
                <div class="faction-card-header">
                    <i class="fas fa-building"></i> Quartier général
                </div>
                <div class="faction-card-body">
                    {% if faction.headquarters %}
                        <h5>{{ faction.headquarters.name }}</h5>
                        {% if faction.headquartersDescription %}
                            <p>{{ faction.headquartersDescription|raw }}</p>
                        {% endif %}
                        <a href="{{ path('app_location_show', {'id': faction.headquarters.id, 'slug': faction.headquarters.slug}) }}" class="btn btn-sm btn-outline-primary mt-2">
                            <i class="fas fa-map-marker-alt me-1"></i> Voir le lieu
                        </a>
                    {% else %}
                        <p class="text-muted">Aucun quartier général défini.</p>
                    {% endif %}
                </div>
            </div>
            
            {# Rejoindre / Quitter la faction #}
            {% if is_granted('ROLE_USER') %}
                <div class="faction-card">
                    <div class="faction-card-header">
                        <i class="fas fa-user-plus"></i> Actions
                    </div>
                    <div class="faction-card-body">
                        {% if faction.status == 'open' or is_granted('ROLE_ADMIN') %}
                            {# Personnages qui peuvent rejoindre la faction #}
                            {% set availableCharacters = [] %}
                            {% for character in app.user.characters %}
                                {% if not faction.characters.contains(character) and character.universe.id == faction.universe.id %}
                                    {% set availableCharacters = availableCharacters|merge([character]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if availableCharacters|length > 0 %}
                                <form method="post" action="{{ path('app_faction_join', {'id': faction.id}) }}" class="mb-3">
                                    <h6>Rejoindre la faction</h6>
                                    <div class="mb-3">
                                        <select name="character_id" class="form-select">
                                            <option value="">Sélectionner un personnage</option>
                                            {% for character in availableCharacters %}
                                                <option value="{{ character.id }}">{{ character.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <input type="hidden" name="_token" value="{{ csrf_token('join' ~ faction.id) }}">
                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                        <i class="fas fa-sign-in-alt me-1"></i> Rejoindre
                                    </button>
                                </form>
                            {% endif %}
                            
                            {# Personnages qui peuvent quitter la faction #}
                            {% set userCharactersInFaction = [] %}
                            {% for character in app.user.characters %}
                                {% if faction.characters.contains(character) %}
                                    {% set userCharactersInFaction = userCharactersInFaction|merge([character]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if userCharactersInFaction|length > 0 %}
                                <form method="post" action="{{ path('app_faction_leave', {'id': faction.id}) }}">
                                    <h6>Quitter la faction</h6>
                                    <div class="mb-3">
                                        <select name="character_id" class="form-select">
                                            <option value="">Sélectionner un personnage</option>
                                            {% for character in userCharactersInFaction %}
                                                <option value="{{ character.id }}">{{ character.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ faction.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm w-100">
                                        <i class="fas fa-sign-out-alt me-1"></i> Quitter
                                    </button>
                                </form>
                            {% endif %}
                            
                            {% if availableCharacters|length == 0 and userCharactersInFaction|length == 0 %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle me-1"></i> Vous n'avez pas de personnages disponibles pour rejoindre ou quitter cette faction.
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="alert alert-warning mb-0">
                                <i class="fas fa-lock me-1"></i> Cette faction est actuellement fermée aux inscriptions.
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            
            {# Actions administratives #}
            {% if is_granted('ROLE_USER') and (is_granted('ROLE_ADMIN') or app.user == faction.founder) %}
                <div class="faction-card">
                    <div class="faction-card-header">
                        <i class="fas fa-cog"></i> Administration
                    </div>
                    <div class="faction-card-body">
                        <div class="d-grid gap-2">
                            <a href="{{ path('app_faction_edit', {'id': faction.id}) }}" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit me-1"></i> Modifier la faction
                            </a>
                            
                            <a href="{{ path('app_npc_new_faction', {'faction_id': faction.id}) }}" class="btn btn-success btn-sm">
                                <i class="fas fa-user-plus me-1"></i> Créer un PNJ
                            </a>
                            
                            <form method="post" action="{{ path('app_faction_toggle_status', {'id': faction.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ faction.id) }}">
                                <button type="submit" class="btn btn-outline-{{ faction.status == 'open' ? 'danger' : 'success' }} btn-sm w-100">
                                    <i class="fas fa-{{ faction.status == 'open' ? 'lock' : 'lock-open' }} me-1"></i> 
                                    {{ faction.status == 'open' ? 'Fermer' : 'Ouvrir' }} aux inscriptions
                                </button>
                            </form>
                            
                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash me-1"></i> Supprimer la faction
                            </button>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    
    {# Modal de confirmation de suppression #}
    {% if is_granted('ROLE_ADMIN') or app.user == faction.founder %}
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Êtes-vous sûr de vouloir supprimer la faction <strong>{{ faction.name }}</strong> ?</p>
                        <p class="text-danger">Cette action est irréversible et supprimera tous les liens vers cette faction.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <form method="post" action="{{ path('app_faction_delete', {'id': faction.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ faction.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer définitivement</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %} 