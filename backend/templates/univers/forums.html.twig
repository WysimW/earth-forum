{% extends 'base.html.twig' %}

{% block title %}Forums de l'univers {{ univers.name }}{% endblock %}

{% block body %}
    <div class="roleplay-index">
        <div class="hero-section glass-panel mb-4">
            <h1 class="main-title">Forums de l'univers {{ univers.name }}</h1>
            <p class="lead">Explorez les forums de cet univers et de ses réalités alternatives (Elseworlds).</p>
            
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a href="{{ path('app_univers_show', {'slug': univers.slug}) }}" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-2"></i> Retour à l'univers
                </a>
                <a href="{{ path('app_univers_elseworlds', {'slug': univers.slug}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-globe-americas me-2"></i> Voir les Elseworlds
                </a>
            </div>
        </div>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_roleplay') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_univers_index') }}">Univers</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_univers_show', {'slug': univers.slug}) }}">{{ univers.name }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">Forums</li>
            </ol>
        </nav>

        <div class="forums-container">
            <!-- Forums importants de l'univers principal -->
            <div id="important-forums" class="forum-section mb-5">
                <h2 class="section-title important-gradient">
                    <i class="fas fa-thumbtack text-important"></i> Forums Importants
                    <small class="text-muted">Annonces et informations essentielles de {{ univers.name }}</small>
                </h2>

                <div class="forums-list">
                    {% set displayedImportantForums = false %}
                    {% for forum in universeForums %}
                        {% if forum.isImportant() %}
                            {% set displayedImportantForums = true %}
                            <div class="col-md-12 mb-4">
                                {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                            </div>
                        {% endif %}
                    {% endfor %}
                    
                    {% if not displayedImportantForums %}
                        <div class="empty-state">
                            <i class="fas fa-thumbtack fa-3x"></i>
                            <p>Aucun forum important n'est disponible pour cet univers.</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Forums RP de l'univers principal -->
            <div id="rp-forums" class="forum-section mb-5">
                <h2 class="section-title rp-gradient">
                    <i class="fa-solid fa-dice-d20 text-roleplay"></i> Forums Roleplay
                    <small class="text-muted">Incarnez vos personnages dans l'univers {{ univers.name }}</small>
                </h2>

                <div class="forums-list">
                    {% set displayedRpForums = false %}
                    {% for forum in universeForums %}
                        {% if forum.isRoleplay() %}
                            {% set displayedRpForums = true %}
                            <div class="col-md-12 mb-4">
                                {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                            </div>
                        {% endif %}
                    {% endfor %}
                    
                    {% if not displayedRpForums %}
                        <div class="empty-state">
                            <i class="fa-solid fa-dice-d20 fa-3x"></i>
                            <p>Aucun forum roleplay n'est disponible pour cet univers.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Forums HRP de l'univers principal -->
            <div id="hrp-forums" class="forum-section mb-5">
                <h2 class="section-title hrp-gradient">
                    <i class="fas fa-comments text-hrp"></i> Forums Hors-Roleplay
                    <small class="text-muted">Discussions et informations sur l'univers {{ univers.name }}</small>
                </h2>

                <div class="forums-list">
                    {% set displayedHrpForums = false %}
                    {% for forum in universeForums %}
                        {% if forum.isHrp() %}
                            {% set displayedHrpForums = true %}
                            <div class="col-md-12 mb-4">
                                {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                            </div>
                        {% endif %}
                    {% endfor %}
                    
                    {% if not displayedHrpForums %}
                        <div class="empty-state">
                            <i class="fas fa-comments fa-3x"></i>
                            <p>Aucun forum hors-roleplay n'est disponible pour cet univers.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Section des Elseworlds -->
            {% if elseworlds|length > 0 %}
                <h2 class="section-title mt-5 mb-4">
                    <i class="fas fa-globe-americas"></i> Forums des Elseworlds
                </h2>
                
                {% if elseworldsForums is defined and elseworldsForums|length > 0 %}
                    {% for elseworldId, elseworldData in elseworldsForums %}
                        <div class="elseworld-section mb-5">
                            <div class="elseworld-header d-flex align-items-center mb-3">
                                {% if elseworldData.elseworld.logo %}
                                    <img src="{{ elseworldData.elseworld.logo }}" alt="Logo" class="me-2" style="height: 40px; width: auto;">
                                {% else %}
                                    <i class="fas fa-globe-americas me-2 fs-4"></i>
                                {% endif %}
                                <h3 class="h4 mb-0">{{ elseworldData.elseworld.name }}</h3>
                                <a href="{{ path('app_elseworld_show', {'universeSlug': univers.slug, 'elseworldSlug': elseworldData.elseworld.slug}) }}" class="btn btn-sm btn-outline-secondary ms-3">
                                    <i class="fas fa-external-link-alt"></i> Voir l'Elseworld
                                </a>
                            </div>
                            
                            <!-- Forums RP de l'Elseworld -->
                            {% set hasRpForums = false %}
                            {% for forum in elseworldData.forums %}
                                {% if forum.isRoleplay() %}
                                    {% set hasRpForums = true %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasRpForums %}
                                <div id="elseworld-rp-forums-{{ elseworldData.elseworld.id }}" class="forum-section mb-4 ms-4">
                                    <h4 class="section-title rp-gradient h5">
                                        <i class="fa-solid fa-dice-d20 text-roleplay"></i> Forums Roleplay
                                    </h4>
                                    <div class="forums-list">
                                        {% for forum in elseworldData.forums %}
                                            {% if forum.isRoleplay() %}
                                                <div class="col-md-12 mb-3">
                                                    {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            
                            <!-- Forums HRP de l'Elseworld -->
                            {% set hasHrpForums = false %}
                            {% for forum in elseworldData.forums %}
                                {% if forum.isHrp() %}
                                    {% set hasHrpForums = true %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasHrpForums %}
                                <div id="elseworld-hrp-forums-{{ elseworldData.elseworld.id }}" class="forum-section mb-4 ms-4">
                                    <h4 class="section-title hrp-gradient h5">
                                        <i class="fas fa-comments text-hrp"></i> Forums Hors-Roleplay
                                    </h4>
                                    <div class="forums-list">
                                        {% for forum in elseworldData.forums %}
                                            {% if forum.isHrp() %}
                                                <div class="col-md-12 mb-3">
                                                    {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            
                            <!-- Forums importants de l'Elseworld -->
                            {% set hasImportantForums = false %}
                            {% for forum in elseworldData.forums %}
                                {% if forum.isImportant() %}
                                    {% set hasImportantForums = true %}
                                {% endif %}
                            {% endfor %}
                            
                            {% if hasImportantForums %}
                                <div id="elseworld-important-forums-{{ elseworldData.elseworld.id }}" class="forum-section mb-4 ms-4">
                                    <h4 class="section-title important-gradient h5">
                                        <i class="fas fa-thumbtack text-important"></i> Forums Importants
                                    </h4>
                                    <div class="forums-list">
                                        {% for forum in elseworldData.forums %}
                                            {% if forum.isImportant() %}
                                                <div class="col-md-12 mb-3">
                                                    {% include 'components/_forum_card.html.twig' with {'forum': forum} %}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-state mt-5">
                        <i class="fas fa-globe-americas fa-3x"></i>
                        <p>Aucun forum n'est disponible dans les Elseworlds de cet univers.</p>
                    </div>
                {% endif %}
            {% endif %}
        </div>
        
        <div class="quick-actions mt-5">
            <h3><i class="fas fa-bolt"></i> Actions rapides</h3>
            <div class="action-buttons">
                <a href="{{ path('app_univers_show', {'slug': univers.slug}) }}" class="btn btn-outline-primary">
                    <i class="fas fa-globe"></i> Détails de l'univers
                </a>
                <a href="{{ path('app_univers_elseworlds', {'slug': univers.slug}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-globe-americas"></i> Elseworlds ({{ elseworlds|length }})
                </a>
                <a href="{{ path('app_univers_index') }}" class="btn btn-outline-info">
                    <i class="fas fa-list"></i> Tous les univers
                </a>
                <a href="{{ path('app_roleplay') }}" class="btn btn-outline-dark">
                    <i class="fas fa-home"></i> Accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %} 