{% extends 'base.html.twig' %}

{% block title %}Historique de mes sanctions - DC Earth{% endblock %}

{% block body %}
<div class="container my-4">
    <h1 class="mb-4">Historique de mes sanctions</h1>
    
    {% if activeSanctions|length > 0 %}
        <div class="card border-danger mb-4">
            <div class="card-header bg-danger text-white">
                <h2 class="h5 mb-0">Sanctions actives</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Raison</th>
                                <th>Date de début</th>
                                <th>Expire le</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for sanction in activeSanctions %}
                                <tr>
                                    <td>{{ sanction.typeLabel }}</td>
                                    <td>{{ sanction.reason }}</td>
                                    <td>{{ sanction.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if sanction.expiresAt %}
                                            {{ sanction.expiresAt|date('d/m/Y H:i') }}
                                        {% else %}
                                            <span class="badge bg-danger">Permanent</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">Active</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-success mb-4">
            <i class="fas fa-check-circle me-2"></i> Vous n'avez aucune sanction active.
        </div>
    {% endif %}
    
    {% if historySanctions|length > 0 %}
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h2 class="h5 mb-0">Historique des sanctions passées</h2>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Raison</th>
                                <th>Date de début</th>
                                <th>Expiration</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for sanction in historySanctions %}
                                <tr>
                                    <td>{{ sanction.typeLabel }}</td>
                                    <td>{{ sanction.reason }}</td>
                                    <td>{{ sanction.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if sanction.expiresAt %}
                                            {{ sanction.expiresAt|date('d/m/Y H:i') }}
                                        {% else %}
                                            <span class="badge bg-danger">Permanent</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if sanction.isRevoked %}
                                            <span class="badge bg-warning text-dark">Révoquée</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Expirée</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i> Vous n'avez aucune sanction passée.
        </div>
    {% endif %}
    
    {% if activeSanctions|length == 0 and historySanctions|length == 0 %}
        <div class="text-center my-5">
            <i class="fas fa-medal fa-4x text-success mb-3"></i>
            <h3>Félicitations !</h3>
            <p class="lead">Vous n'avez jamais reçu de sanction sur le forum.</p>
        </div>
    {% endif %}
    
    <div class="mt-4">
        <a href="{{ path('app_roleplay_dashboard') }}" class="btn btn-primary">
            <i class="fas fa-arrow-left me-2"></i> Retour au tableau de bord
        </a>
    </div>
</div>
{% endblock %} 