{% extends 'base.html.twig' %}

{% block title %}Nouveau Personnage{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    <div class="character-creation-header mb-4">
        <h1 class="text-roleplay">Créer un nouveau personnage</h1>
        <p class="subtitle">Donnez vie à votre histoire</p>
    </div>
    
    {{ form_start(form, {'attr': {'class': 'character-form'}}) }}
    <div class="character-grid">
        {# Section Identité #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-id-card"></i> Identité
            </h2>
            <div class="character-info-grid">
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.name) }}</div>
                    {{ form_widget(form.name, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.universe) }}</div>
                    {{ form_widget(form.universe, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.universe) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.firstName) }}</div>
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.firstName) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.lastName) }}</div>
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.lastName) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.age) }}</div>
                    {{ form_widget(form.age, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.age) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.pseudonyms) }}</div>
                    {{ form_widget(form.pseudonyms, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.pseudonyms) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.actualPseudo) }}</div>
                    {{ form_widget(form.actualPseudo, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.actualPseudo) }}
                </div>
            </div>
        </div>

        {# Section Avatar #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-portrait"></i> Avatar
            </h2>
            <div class="character-avatar-editor">
                {# Onglets pour choisir la méthode #}
                <div class="avatar-tabs">
                    <button type="button" class="avatar-tab active" data-tab="url">
                        <i class="fas fa-link"></i> Lien externe
                    </button>
                    <button type="button" class="avatar-tab" data-tab="upload">
                        <i class="fas fa-upload"></i> Upload (max 5MB)
                    </button>
                </div>

                {# Contenu des onglets #}
                <div class="avatar-tab-content">
                    {# Onglet URL #}
                    <div class="avatar-tab-pane active" id="tab-url">
                        <div class="avatar-url-section">
                            {{ form_widget(form.avatar, {'attr': {'class': 'form-control character-input', 'placeholder': 'URL de votre avatar'}}) }}
                            {{ form_errors(form.avatar) }}
                            <small class="form-text text-muted">Collez l'URL d'une image pour votre personnage</small>
                        </div>
                    </div>

                    {# Onglet Upload #}
                    <div class="avatar-tab-pane" id="tab-upload">
                        <div class="avatar-upload-section">
                            <div class="upload-dropzone" id="avatarDropzone">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <p>Glissez votre image ici ou cliquez pour sélectionner</p>
                                <small>Formats acceptés : JPEG, PNG, GIF, WebP (max 5MB)</small>
                                <input type="file" id="avatarFileInput" accept="image/*" style="display: none;">
                            </div>
                            <div class="upload-progress" id="uploadProgress" style="display: none;">
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Prévisualisation et éditeur #}
                <div class="avatar-preview-section">
                    <div class="preview-container" id="avatarPreview">
                        <i class="fas fa-user-circle"></i>
                    </div>
                    
                    {# Éditeur de recadrage (masqué par défaut) #}
                    <div class="avatar-crop-editor" id="avatarCropEditor" style="display: none;">
                        <h4>Recadrer votre avatar</h4>
                        <div class="crop-container">
                            <div class="crop-preview-grid">
                                <div class="crop-preview">
                                    <h5>Format portrait</h5>
                                    <div class="crop-preview-portrait" id="cropPreviewPortrait"></div>
                                </div>
                                <div class="crop-preview">
                                    <h5>Format circulaire</h5>
                                    <div class="crop-preview-circle" id="cropPreviewCircle"></div>
                                </div>
                            </div>
                            <div class="crop-image-container">
                                <img id="cropImage" style="max-width: 100%;">
                            </div>
                            <div class="crop-controls">
                                <button type="button" class="btn btn-primary" id="confirmCrop">
                                    <i class="fas fa-check"></i> Confirmer le recadrage
                                </button>
                                <button type="button" class="btn btn-secondary" id="cancelCrop">
                                    <i class="fas fa-times"></i> Annuler
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# Champs cachés pour stocker les données #}
                <input type="hidden" id="avatarFilename" name="avatarFilename">
                <input type="hidden" id="avatarCropData" name="avatarCropData">
            </div>
        </div>

        {# Section Caractéristiques personnelles #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-user-tag"></i> Caractéristiques personnelles
            </h2>
            <div class="character-info-grid">
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.gender) }}</div>
                    {{ form_widget(form.gender, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.gender) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.sexualOrientation) }}</div>
                    {{ form_widget(form.sexualOrientation, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.sexualOrientation) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.civilStatus) }}</div>
                    {{ form_widget(form.civilStatus, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.civilStatus) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.occupation) }}</div>
                    {{ form_widget(form.occupation, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.occupation) }}
                </div>
            </div>
        </div>
        
        {# Section Affiliation #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-users"></i> Affiliation
            </h2>
            <div class="character-info-grid">
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.moralAffiliation) }}</div>
                    {{ form_widget(form.moralAffiliation, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.moralAffiliation) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.factions) }}</div>
                    {{ form_widget(form.factions, {'attr': {'class': 'form-control character-textarea', 'rows': '2'}}) }}
                    {{ form_errors(form.factions) }}
                </div>
            </div>
        </div>

        {# Section Biographie #}
        <div class="character-section full-width">
            <h2 class="character-section-title">
                <i class="fas fa-book-open"></i> Histoire
            </h2>
            <div class="character-bio">
                {{ form_widget(form.biography, {'attr': {
                    'class': 'form-control character-textarea wysiwyg-editor-full',
                    'rows': '8',
                    'placeholder': 'Racontez l\'histoire de votre personnage...',
                    'data-mode': 'roleplay'
                }}) }}
                {{ form_errors(form.biography) }}
            </div>
        </div>

        {# Section Caractéristiques #}
        <div class="character-section full-width">
            <h2 class="character-section-title">
                <i class="fas fa-user-tag"></i> Caractéristiques
            </h2>
            <div class="character-traits-grid">
                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fa-solid fa-dice-d20"></i> {{ form_label(form.personality) }}
                    </div>
                    {{ form_widget(form.personality, {'attr': {
                        'class': 'form-control character-textarea wysiwyg-editor',
                        'rows': '4',
                        'placeholder': 'Décrivez la personnalité de votre personnage...',
                        'data-mode': 'roleplay'
                    }}) }}
                    {{ form_errors(form.personality) }}
                </div>

                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-eye"></i> {{ form_label(form.appearance) }}
                    </div>
                    {{ form_widget(form.appearance, {'attr': {
                        'class': 'form-control character-textarea wysiwyg-editor',
                        'rows': '4',
                        'placeholder': 'Décrivez l\'apparence de votre personnage...',
                        'data-mode': 'roleplay'
                    }}) }}
                    {{ form_errors(form.appearance) }}
                </div>

                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-bolt"></i> {{ form_label(form.abilities) }}
                    </div>
                    {{ form_widget(form.abilities, {'attr': {
                        'class': 'form-control character-textarea wysiwyg-editor',
                        'rows': '4',
                        'placeholder': 'Listez les capacités de votre personnage...',
                        'data-mode': 'roleplay'
                    }}) }}
                    {{ form_errors(form.abilities) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-toolbox"></i> {{ form_label(form.equipment) }}
                    </div>
                    {{ form_widget(form.equipment, {'attr': {
                        'class': 'form-control character-textarea wysiwyg-editor',
                        'rows': '4',
                        'placeholder': 'Décrivez les équipements de votre personnage...',
                        'data-mode': 'roleplay'
                    }}) }}
                    {{ form_errors(form.equipment) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-skull-crossbones"></i> {{ form_label(form.weaknesses) }}
                    </div>
                    {{ form_widget(form.weaknesses, {'attr': {
                        'class': 'form-control character-textarea wysiwyg-editor',
                        'rows': '4',
                        'placeholder': 'Listez les faiblesses de votre personnage...',
                        'data-mode': 'roleplay'
                    }}) }}
                    {{ form_errors(form.weaknesses) }}
                </div>
            </div>
        </div>
    </div>

    <div class="character-form-actions mt-4">
        <a href="{{ path('app_roleplay_characters') }}" class="btn btn-outline-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
        <button type="submit" class="btn bg-roleplay text-white">
            <i class="fas fa-save"></i> Créer le personnage
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/avatar-editor.css') }}">
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="{{ asset('js/avatar-editor.js') }}"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialisation des éditeurs Quill.js si nécessaire
    if (typeof window.initWysiwygEditors === 'function') {
        window.initWysiwygEditors();
    }
});
</script>
{% endblock %}