{% extends 'base.html.twig' %}

{% block title %}Nouveau Personnage{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/tinymce@6/skins/ui/oxide-dark/skin.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    <div class="character-creation-header mb-4">
        <h1 class="text-roleplay">Créer un nouveau personnage</h1>
        <p class="subtitle">Donnez vie à votre histoire</p>
    </div>
    
    {{ form_start(form, {'attr': {'class': 'character-form'}}) }}
    <div class="character-grid">
        {# Section Identité #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-id-card"></i> Identité
            </h2>
            <div class="character-info-grid">
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.name) }}</div>
                    {{ form_widget(form.name, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.name) }}
                </div>
                
                <div class="character-info-item">
                    <div class="character-info-label">{{ form_label(form.universe) }}</div>
                    {{ form_widget(form.universe, {'attr': {'class': 'form-control character-input'}}) }}
                    {{ form_errors(form.universe) }}
                </div>
            </div>
        </div>

        {# Section Avatar #}
        <div class="character-section">
            <h2 class="character-section-title">
                <i class="fas fa-portrait"></i> Avatar
            </h2>
            <div class="character-avatar-preview">
                <div class="preview-container" id="avatarPreview">
                    <i class="fas fa-user-circle"></i>
                </div>
                {{ form_widget(form.avatar, {'attr': {'class': 'form-control character-input', 'placeholder': 'URL de votre avatar'}}) }}
                {{ form_errors(form.avatar) }}
                <small class="form-text text-muted">Collez l'URL d'une image pour votre personnage</small>
            </div>
        </div>

        {# Section Biographie #}
        <div class="character-section full-width">
            <h2 class="character-section-title">
                <i class="fas fa-book-open"></i> Histoire
            </h2>
            <div class="character-bio">
                {{ form_widget(form.biography, {'attr': {
                    'class': 'form-control character-textarea wysiwyg-editor',
                    'rows': '8',
                    'placeholder': 'Racontez l\'histoire de votre personnage...'
                }}) }}
                {{ form_errors(form.biography) }}
            </div>
        </div>

        {# Section Caractéristiques #}
        <div class="character-section full-width">
            <h2 class="character-section-title">
                <i class="fas fa-user-tag"></i> Caractéristiques
            </h2>
            <div class="character-traits-grid">
                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-theater-masks"></i> {{ form_label(form.personality) }}
                    </div>
                    {{ form_widget(form.personality, {'attr': {
                        'class': 'form-control character-textarea',
                        'rows': '4',
                        'placeholder': 'Décrivez la personnalité de votre personnage...'
                    }}) }}
                    {{ form_errors(form.personality) }}
                </div>

                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-eye"></i> {{ form_label(form.appearance) }}
                    </div>
                    {{ form_widget(form.appearance, {'attr': {
                        'class': 'form-control character-textarea',
                        'rows': '4',
                        'placeholder': 'Décrivez l\'apparence de votre personnage...'
                    }}) }}
                    {{ form_errors(form.appearance) }}
                </div>

                <div class="character-info-item">
                    <div class="character-info-label">
                        <i class="fas fa-bolt"></i> {{ form_label(form.abilities) }}
                    </div>
                    {{ form_widget(form.abilities, {'attr': {
                        'class': 'form-control character-textarea',
                        'rows': '4',
                        'placeholder': 'Listez les capacités de votre personnage...'
                    }}) }}
                    {{ form_errors(form.abilities) }}
                </div>
            </div>
        </div>
    </div>

    <div class="character-form-actions mt-4">
        <a href="{{ path('app_roleplay_characters') }}" class="btn btn-outline-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
        <button type="submit" class="btn bg-roleplay text-white">
            <i class="fas fa-save"></i> Créer le personnage
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Prévisualisation de l'avatar
    const avatarInput = document.querySelector('#{{ form.avatar.vars.id }}');
    const previewContainer = document.getElementById('avatarPreview');

    if (avatarInput && previewContainer) {
        avatarInput.addEventListener('input', function() {
            const url = this.value.trim();
            if (url) {
                const img = new Image();
                img.onload = function() {
                    previewContainer.innerHTML = '';
                    previewContainer.appendChild(img);
                }
                img.onerror = function() {
                    previewContainer.innerHTML = '<i class="fas fa-user-circle"></i>';
                }
                img.src = url;
            } else {
                previewContainer.innerHTML = '<i class="fas fa-user-circle"></i>';
            }
        });
    }

    // Configuration TinyMCE
    const editorConfig = {
        skin: 'oxide-dark',
        content_css: 'dark',
        height: 300,
        menubar: false,
        plugins: [
            'advlist', 'autolink', 'lists', 'link', 'image', 'charmap', 'preview',
            'anchor', 'searchreplace', 'visualblocks', 'code', 'fullscreen',
            'insertdatetime', 'media', 'table', 'help', 'wordcount', 'emoticons'
        ],
        toolbar: 'undo redo | blocks | ' +
                'bold italic forecolor | alignleft aligncenter ' +
                'alignright alignjustify | bullist numlist outdent indent | ' +
                'removeformat | emoticons | help',
        content_style: 'body { font-family:Helvetica,Arial,sans-serif; font-size:16px }',
        browser_spellcheck: true,
        contextmenu: false,
        language: 'fr_FR'
    };

    // Initialisation des éditeurs
    tinymce.init({
        ...editorConfig,
        selector: '#{{ form.biography.vars.id }}',
        placeholder: 'Racontez l\'histoire de votre personnage...',
    });

    tinymce.init({
        ...editorConfig,
        selector: '#{{ form.personality.vars.id }}',
        height: 200,
        placeholder: 'Décrivez la personnalité de votre personnage...',
    });

    tinymce.init({
        ...editorConfig,
        selector: '#{{ form.appearance.vars.id }}',
        height: 200,
        placeholder: 'Décrivez l\'apparence de votre personnage...',
    });

    tinymce.init({
        ...editorConfig,
        selector: '#{{ form.abilities.vars.id }}',
        height: 200,
        placeholder: 'Listez les capacités de votre personnage...',
    });
});
</script>
{% endblock %}