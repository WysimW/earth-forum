{% extends 'base.html.twig' %}

{% block title %}Mes Personnages et PNJ{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.status-badge {
    padding: 0.35em 0.65em;
    font-size: 0.75em;
    font-weight: 500;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    vertical-align: baseline;
    border-radius: 0.25rem;
    margin-left: 0.5rem;
}

.status-badge.status-draft {
    background-color: #6c757d;
    color: white;
}

.status-badge.status-pending {
    background-color: #ffc107;
    color: #000;
}

.status-badge.status-validated {
    background-color: #198754;
    color: white;
}

.status-badge.status-rejected {
    background-color: #dc3545;
    color: white;
}

.status-badge.status-abandoned {
    background-color: #6c757d;
    color: white;
}

.status-badge.status-editing {
    background-color: #0dcaf0;
    color: #000;
}

.status-badge.status-draft {
    background-color: #0dcaf0;
    color: #000;
}
</style>
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    {# Section Personnages #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mes Personnages</h1>
        <a href="{{ path('app_roleplay_character_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Créer un personnage
        </a>
    </div>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    
    {% if characters|length > 0 %}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            {% for character in characters %}
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">{{ character.name }}</h5>
                            <div class="d-flex align-items-center">
                                <span class="status-badge status-{{ character.status }}">
                                    {% if character.status == 'pending' %}
                                        En attente
                                    {% elseif character.status == 'validated' %}
                                        Validé
                                     {% elseif character.status == 'draft' %}
                                        Brouillon
                                    {% else %}
                                        Refusé
                                    {% endif %}
                                </span>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton{{ character.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton{{ character.id }}">
                                        <li><a class="dropdown-item" href="{{ path('app_roleplay_character_show', {'id': character.id}) }}">Voir</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}">Modifier</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_roleplay_character_relationships', {'id': character.id}) }}">Relations</a></li>
                                        <li><a class="dropdown-item" href="{{ path('app_dialogue_style_character', {'id': character.id}) }}">Style de dialogue</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('app_roleplay_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                                                <button class="dropdown-item text-danger">Supprimer</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-auto">
                                    {% if character.avatar %}
                                        <img src="{{ character.avatar }}" alt="{{ character.name }}" class="img-thumbnail" style="width: 64px; height: 64px; object-fit: cover;">
                                    {% else %}
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                            <i class="fas fa-user fa-2x"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="col">
                                    {% if character.universe %}
                                        <div class="mb-2">
                                            <span class="badge bg-primary">{{ character.universe.name }}</span>
                                        </div>
                                    {% endif %}
                                    <div class="card-text small">
                                        {% if character.biography %}
                                            {{ character.biography|striptags|u.truncate(100, '...') }}
                                        {% else %}
                                            <span class="text-muted">Aucune biographie disponible</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <div class="btn-group btn-group-sm w-100">
                                <a href="{{ path('app_roleplay_character_show', {'id': character.id}) }}" class="btn btn-outline-primary">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-pen"></i> Éditer
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="mb-3">Vous n'avez pas encore créé de personnage</h3>
                <p class="text-muted mb-4">Créez votre premier personnage pour participer aux scènes de roleplay</p>
                <a href="{{ path('app_roleplay_character_new') }}" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus"></i> Créer mon premier personnage
                </a>
            </div>
        </div>
    {% endif %}

    {# Section PNJ #}
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Mes PNJ</h1>
            <a href="{{ path('app_npc_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Créer un PNJ
            </a>
        </div>
        
        {% if npcs|length > 0 %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for npc in npcs %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">{{ npc.name }}</h5>
                                <div class="d-flex align-items-center">
                                    <span class="status-badge status-{{ npc.status }}">
                                        {% if npc.status == 'draft' %}
                                            Brouillon
                                        {% elseif npc.status == 'pending' %}
                                            En attente
                                        {% elseif npc.status == 'validated' %}
                                            Validé
                                        {% elseif npc.status == 'rejected' %}
                                            Refusé
                                        {% elseif npc.status == 'abandoned' %}
                                            Abandonné
                                        {% elseif npc.status == 'editing' %}
                                            En édition
                                        {% endif %}
                                    </span>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButtonNpc{{ npc.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButtonNpc{{ npc.id }}">
                                            <li><a class="dropdown-item" href="{{ path('app_npc_show', {'id': npc.id}) }}">Voir</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_npc_edit', {'id': npc.id}) }}">Modifier</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_dialogue_style_npc', {'id': npc.id}) }}">Style de dialogue</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form method="post" action="{{ path('app_npc_delete', {'id': npc.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce PNJ ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ npc.id) }}">
                                                    <button class="dropdown-item text-danger">Supprimer</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-auto">
                                        {% if npc.avatar %}
                                            <img src="{{ npc.avatar }}" alt="{{ npc.name }}" class="img-thumbnail" style="width: 64px; height: 64px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                                                <i class="fas fa-user fa-2x"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col">
                                        {% if npc.universe %}
                                            <div class="mb-2">
                                                <span class="badge bg-primary">{{ npc.universe.name }}</span>
                                            </div>
                                        {% endif %}
                                        <div class="card-text small">
                                            {% if npc.biography %}
                                                {{ npc.biography|striptags|u.truncate(100, '...') }}
                                            {% else %}
                                                <span class="text-muted">Aucune biographie disponible</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <div class="btn-group btn-group-sm w-100">
                                    <a href="{{ path('app_npc_show', {'id': npc.id}) }}" class="btn btn-outline-primary">
                                        <i class="fas fa-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('app_npc_edit', {'id': npc.id}) }}" class="btn btn-outline-secondary">
                                        <i class="fas fa-pen"></i> Éditer
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="mb-3">Vous n'avez pas encore créé de PNJ</h3>
                    <p class="text-muted mb-4">Créez votre premier PNJ pour enrichir vos univers</p>
                    <a href="{{ path('app_npc_new') }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus"></i> Créer mon premier PNJ
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}