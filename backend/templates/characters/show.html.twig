{% extends 'base.html.twig' %}

{% block title %}{{ character.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/character-cards.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/character-profile.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/subcomponents/moral-badge.css') }}">
    <link rel="stylesheet" href="{{ asset('css/components/subcomponents/faction-list.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/character-profile.js') }}"></script>
    <script>
        // Script de debug simple pour tester les onglets
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔧 Script de debug des onglets chargé');
            
            // Vérifications de base
            const tabs = document.querySelectorAll('.character-tabs__tab');
            const panels = document.querySelectorAll('.character-tabs__panel');
            
            console.log('Onglets trouvés:', tabs.length);
            console.log('Panneaux trouvés:', panels.length);
            
            // Si le script principal ne fonctionne pas, utiliser une version simple
            setTimeout(() => {
                // Vérifier si les onglets ont des événements
                if (tabs.length > 0) {
                    tabs.forEach((tab, index) => {
                        console.log(`Onglet ${index}:`, tab.dataset.tab, tab.classList.contains('active'));
                    });
                    
                    panels.forEach((panel, index) => {
                        console.log(`Panneau ${index}:`, panel.id, panel.classList.contains('active'));
                    });
                    
                    // Test manuel d'un clic
                    console.log('🎯 Test de clic sur le second onglet...');
                    if (tabs[1]) {
                        tabs[1].addEventListener('click', function(e) {
                            console.log('Clic détecté sur:', this.dataset.tab);
                        });
                    }
                }
            }, 1000);
        });
    </script>
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    {# Header du profil #}
    <div class="character-profile">
        <div class="character-profile__header">
            <div class="character-profile__avatar">
                {% if character.avatar %}
                    <img src="{{ character.avatar }}" alt="{{ character.name }}" class="character-profile__avatar-img">
                {% else %}
                    <div class="character-profile__avatar-placeholder">
                        <i class="fas fa-user-astronaut"></i>
                    </div>
                {% endif %}
                
                <div class="character-profile__status-badge status-{{ character.status }}">
                    {% if character.status == 'validated' %}
                        <i class="fas fa-check-circle" title="Validé"></i>
                    {% elseif character.status == 'pending' %}
                        <i class="fas fa-clock" title="En attente"></i>
                    {% elseif character.status == 'draft' %}
                        <i class="fas fa-file-alt" title="Brouillon"></i>
                    {% else %}
                        <i class="fas fa-times-circle" title="Refusé"></i>
                    {% endif %}
                </div>
            </div>
            
            <div class="character-profile__info">
                <h1 class="character-profile__name">{{ character.name }}</h1>
                {% if character.firstName or character.lastName %}
                    <div class="character-profile__real-name">
                        {{ [character.firstName, character.lastName]|filter(v => v)|join(' ') }}
                    </div>
                {% endif %}
                {% if character.universe %}
                    <div class="character-profile__universe">
                        <i class="fas fa-globe me-1"></i>{{ character.universe.name }}
                    </div>
                {% endif %}
                {% if character.elseworld %}
                    <div class="character-profile__elseworld">
                        <i class="fas fa-map-marked-alt me-1"></i>{{ character.elseworld.name }}
                    </div>
                {% endif %}
                
                <div class="character-profile__status-text">
                    <span class="status-label status-label--{{ character.status }}">
                        {% if character.status == 'pending' %}
                            En attente de validation
                        {% elseif character.status == 'validated' %}
                            Personnage validé
                        {% elseif character.status == 'draft' %}
                            Brouillon
                        {% elseif character.status == 'rejected' %}
                            Refusé
                        {% else %}
                            {{ character.status|title }}
                        {% endif %}
                    </span>
                </div>
            </div>
            
            {% if isOwner %}
            <div class="character-profile__actions">
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fas fa-cog me-1"></i>Gérer
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}">
                                <i class="fas fa-edit me-2"></i>Modifier le personnage
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_character_avatar_manage', {'id': character.id}) }}">
                                <i class="fas fa-image me-2"></i>Gérer l'avatar
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_roleplay_character_relationships', {'id': character.id}) }}">
                                <i class="fas fa-heart me-2"></i>Relations
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="{{ path('app_roleplay_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage ?');" class="m-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                                <button class="dropdown-item text-danger">
                                    <i class="fas fa-trash me-2"></i>Supprimer
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
            {% endif %}
        </div>
        
        {# Métadonnées du personnage #}
        <div class="character-profile__meta">
            {% if character.age %}
                <div class="character-profile__meta-item">
                    <i class="fas fa-calendar-alt me-1"></i>
                    <span class="meta-label">Âge :</span>
                    <span class="meta-value">{{ character.age }}</span>
                </div>
            {% endif %}
            
            {% if character.gender %}
                <div class="character-profile__meta-item">
                    <i class="fas fa-user me-1"></i>
                    <span class="meta-label">Genre :</span>
                    <span class="meta-value">{{ character.gender }}</span>
                </div>
            {% endif %}
            
            {% if character.occupation %}
                <div class="character-profile__meta-item character-profile__meta-item--occupation">
                    <i class="fas fa-briefcase me-1"></i>
                    <span class="meta-label">Occupation :</span>
                    <span class="meta-value">{{ character.occupation }}</span>
                </div>
            {% endif %}
            
            {% if character.civilStatus %}
                <div class="character-profile__meta-item">
                    <i class="fas fa-ring me-1"></i>
                    <span class="meta-label">Statut civil :</span>
                    <span class="meta-value">{{ character.civilStatus }}</span>
                </div>
            {% endif %}
            
            {% if character.sexualOrientation %}
                <div class="character-profile__meta-item character-profile__meta-item--orientation">
                    <i class="fas fa-heart me-1"></i>
                    <span class="meta-label">Orientation :</span>
                    <span class="meta-value">{{ character.sexualOrientation }}</span>
                </div>
            {% endif %}
            
            {% if character.moralAffiliation %}
                <div class="character-profile__meta-item">
                    <i class="fas fa-balance-scale me-1"></i>
                    <span class="meta-label">Affiliation :</span>
                    <span class="moral-badge moral-badge--{{ character.moralAffiliation|lower|replace({' ': '-', '-': '-'}) }}">
                        {{ character.moralAffiliation }}
                    </span>
                </div>
            {% endif %}
            
            {% if character.pseudonyms %}
                <div class="character-profile__meta-item character-profile__meta-item--pseudonyms">
                    <i class="fas fa-mask me-1"></i>
                    <span class="meta-label">Pseudonymes :</span>
                    <span class="meta-value">{{ character.pseudonyms }}</span>
                </div>
            {% endif %}
            
            {% if character.factions %}
                <div class="character-profile__meta-item">
                    <i class="fas fa-users me-1"></i>
                    <span class="meta-label">Factions :</span>
                    <span class="meta-value">{{ character.factions }}</span>
                </div>
            {% endif %}
        </div>
        
        {# Créateur et dates #}
        <div class="character-profile__footer">
            <div class="character-profile__creator">
                <i class="fas fa-user-edit me-1"></i>
                Créé par <strong>{{ character.user.pseudo }}</strong> le {{ character.createdAt|date('d/m/Y') }}
            </div>
        </div>
    </div>
    
    {# Navigation par onglets moderne #}
    <div class="character-tabs">
        <div class="character-tabs__nav">
            <button class="character-tabs__tab active" data-tab="biography">
                <i class="fas fa-book-open me-2"></i>Biographie
            </button>
            <button class="character-tabs__tab" data-tab="personality">
                <i class="fas fa-brain me-2"></i>Personnalité
            </button>
            <button class="character-tabs__tab" data-tab="appearance">
                <i class="fas fa-eye me-2"></i>Apparence
            </button>
            <button class="character-tabs__tab" data-tab="abilities">
                <i class="fas fa-bolt me-2"></i>Capacités
            </button>
            {% if character.equipment %}
            <button class="character-tabs__tab" data-tab="equipment">
                <i class="fas fa-shield-alt me-2"></i>Équipement
            </button>
            {% endif %}
            {% if character.weaknesses %}
            <button class="character-tabs__tab" data-tab="weaknesses">
                <i class="fas fa-exclamation-triangle me-2"></i>Faiblesses
            </button>
            {% endif %}
        </div>
        
        <div class="character-tabs__content">
            {# Onglet Biographie #}
            <div class="character-tabs__panel active" id="biography">
                <div class="character-content">
                    {% if character.biography %}
                        {{ character.biography|raw }}
                    {% else %}
                        <div class="character-content--empty">
                            <i class="fas fa-file-alt me-2"></i>
                            Aucune biographie n'a été rédigée pour ce personnage.
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {# Onglet Personnalité #}
            <div class="character-tabs__panel" id="personality">
                <div class="character-content">
                    {% if character.personality %}
                        {{ character.personality|raw }}
                    {% else %}
                        <div class="character-content--empty">
                            <i class="fas fa-brain me-2"></i>
                            Aucune information sur la personnalité de ce personnage.
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {# Onglet Apparence #}
            <div class="character-tabs__panel" id="appearance">
                <div class="character-content">
                    {% if character.appearance %}
                        {{ character.appearance|raw }}
                    {% else %}
                        <div class="character-content--empty">
                            <i class="fas fa-eye me-2"></i>
                            Aucune description de l'apparence de ce personnage.
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {# Onglet Capacités #}
            <div class="character-tabs__panel" id="abilities">
                <div class="character-content">
                    {% if character.abilities %}
                        {{ character.abilities|raw }}
                    {% else %}
                        <div class="character-content--empty">
                            <i class="fas fa-bolt me-2"></i>
                            Aucune capacité ou compétence spécifiée pour ce personnage.
                        </div>
                    {% endif %}
                </div>
            </div>
            
            {% if character.equipment %}
            {# Onglet Équipement #}
            <div class="character-tabs__panel" id="equipment">
                <div class="character-content">
                    {{ character.equipment|raw }}
                </div>
            </div>
            {% endif %}
            
            {% if character.weaknesses %}
            {# Onglet Faiblesses #}
            <div class="character-tabs__panel" id="weaknesses">
                <div class="character-content">
                    {{ character.weaknesses|raw }}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# Factions du personnage #}
    {% if character.factionsRelation|length > 0 %}
        <div class="character-factions mb-4">
            <h3 class="character-section-title">
                <i class="fas fa-users me-2"></i>
                Factions
            </h3>
            <div class="faction-list">
                {% for faction in character.factionsRelation %}
                    <div class="faction-item">
                        <a href="{{ path('app_faction_show', {'universeSlug': faction.universe.slug, 'factionSlug': faction.slug}) }}" 
                           class="faction-link">
                            {% if faction.icon %}
                                <img src="{{ faction.icon }}" alt="{{ faction.name }}" class="faction-icon">
                            {% else %}
                                <i class="fas fa-users faction-icon-placeholder"></i>
                            {% endif %}
                            <span class="faction-name">{{ faction.name }}</span>
                        </a>
                        {% if faction.alignment %}
                            <span class="moral-badge moral-badge--{{ faction.alignment|lower|replace({' ': '-'}) }}">
                                {{ faction.alignment }}
                            </span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# Scènes de roleplay #}
    {% if threads|length > 0 %}
        <div class="character-threads">
            <h3 class="character-threads__title">
                <i class="fas fa-theater-masks me-2"></i>
                Scènes de roleplay avec ce personnage
            </h3>
            <div class="character-threads__list">
                {% for thread in threads %}
                    <a href="{{ path('app_roleplay_thread_show', {'universeSlug': thread.forum.universe.slug, 'id': thread.id}) }}" class="character-thread-card">
                        <div class="character-thread-card__header">
                            <h5 class="character-thread-card__title">{{ thread.title }}</h5>
                            <span class="thread-status-badge thread-status-badge--{{ thread.status }}">
                                {% if thread.status == 'open' %}
                                    <i class="fas fa-play me-1"></i>Ouvert
                                {% elseif thread.status == 'closed' %}
                                    <i class="fas fa-pause me-1"></i>Fermé
                                {% else %}
                                    <i class="fas fa-archive me-1"></i>Archivé
                                {% endif %}
                            </span>
                        </div>
                        <div class="character-thread-card__content">
                            {% if thread.description %}
                                <p class="character-thread-card__description">
                                    {{ thread.description|striptags|u.truncate(150, '...') }}
                                </p>
                            {% endif %}
                            <div class="character-thread-card__meta">
                                {% if thread.universe %}
                                    <span class="thread-meta-item">
                                        <i class="fas fa-globe-europe me-1"></i>{{ thread.universe.name }}
                                    </span>
                                {% endif %}
                                {% if thread.location %}
                                    <span class="thread-meta-item">
                                        <i class="fas fa-map-marker-alt me-1"></i>{{ thread.location.name }}
                                    </span>
                                {% endif %}
                                <span class="thread-meta-item">
                                    <i class="fas fa-calendar me-1"></i>{{ thread.updatedAt|date('d/m/Y') }}
                                </span>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    
    {# Actions du bas #}
    <div class="character-actions">
        <a href="{{ path('app_roleplay_characters') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour à la liste
        </a>
    </div>
</div>
{% endblock %}