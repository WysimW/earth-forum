{% extends 'base.html.twig' %}

{% block title %}{{ character.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/components/characters.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/characters.js') }}"></script>
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 mb-0">{{ character.name }}</h1>
                {% if isOwner %}
                    <div class="btn-group">
                        <a href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a href="{{ path('app_roleplay_character_relationships', {'id': character.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-users"></i> Relations
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <div class="character-profile-header mb-4">
                <div class="d-flex align-items-center gap-3">
                    <h1 class="h2 mb-0">{{ character.name }}</h1>
                    {% if character.universe %}
                        <span class="badge bg-primary">{{ character.universe.name }}</span>
                    {% endif %}
                </div>
                <div class="character-status mt-2">
                    <span class="status-badge status-{{ character.status }}">
                        {% if character.status == 'pending' %}
                            <i class="fas fa-clock me-1"></i> En attente de validation
                        {% elseif character.status == 'validated' %}
                            <i class="fas fa-check-circle me-1"></i> Personnage validé
                        {% else %}
                            <i class="fas fa-times-circle me-1"></i> Personnage refusé
                        {% endif %}
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    {% if character.avatar %}
                        <img src="{{ character.avatar }}" alt="{{ character.name }}" class="img-fluid rounded mb-3" style="max-height: 300px;">
                    {% else %}
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                            <i class="fas fa-user fa-5x"></i>
                        </div>
                    {% endif %}
                    
                    <div class="mb-3">
                        {% if character.universe %}
                            <span class="badge bg-primary fs-6 mb-2">{{ character.universe.name }}</span>
                        {% endif %}
                    </div>

                    <div class="character-info-box">
                        {% if character.firstName or character.lastName %}
                            <div class="info-row">
                                <span class="info-label">Identité:</span>
                                <span class="info-value">{{ [character.firstName, character.lastName]|filter(v => v)|join(' ') }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.age %}
                            <div class="info-row">
                                <span class="info-label">Âge:</span>
                                <span class="info-value">{{ character.age }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.pseudonyms %}
                            <div class="info-row">
                                <span class="info-label">Pseudonymes:</span>
                                <span class="info-value">{{ character.pseudonyms }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.gender %}
                            <div class="info-row">
                                <span class="info-label">Sexe:</span>
                                <span class="info-value">{{ character.gender }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.sexualOrientation %}
                            <div class="info-row">
                                <span class="info-label">Orientation:</span>
                                <span class="info-value">{{ character.sexualOrientation }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.moralAffiliation %}
                            <div class="info-row">
                                <span class="info-label">Affiliation:</span>
                                <span class="info-value">
                                    <span class="badge {% if character.moralAffiliation == 'Super-héros' %}bg-primary{% elseif character.moralAffiliation == 'Super-vilain' %}bg-danger{% elseif character.moralAffiliation == 'Anti-héros' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                                        {{ character.moralAffiliation }}
                                    </span>
                                </span>
                            </div>
                        {% endif %}
                        
                        {% if character.factions %}
                            <div class="info-row">
                                <span class="info-label">Factions:</span>
                                <span class="info-value">{{ character.factions }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.civilStatus %}
                            <div class="info-row">
                                <span class="info-label">Statut civil:</span>
                                <span class="info-value">{{ character.civilStatus }}</span>
                            </div>
                        {% endif %}
                        
                        {% if character.occupation %}
                            <div class="info-row">
                                <span class="info-label">Travail:</span>
                                <span class="info-value">{{ character.occupation }}</span>
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="text-muted small mt-3">
                        <div>Créé par: {{ character.user.pseudo }}</div>
                        <div>Créé le: {{ character.createdAt|date('d/m/Y') }}</div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="character-tabs">
                        <ul class="nav nav-tabs" id="characterTabs" role="tablist">
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link active" id="biography-tab" data-bs-toggle="tab" data-bs-target="#biography" type="button" role="tab" aria-controls="biography" aria-selected="true">
                                    <i class="fas fa-book-open me-2"></i>Biographie
                                </button>
                            </li>
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link" id="personality-tab" data-bs-toggle="tab" data-bs-target="#personality" type="button" role="tab" aria-controls="personality" aria-selected="false">
                                    <i class="fas fa-brain me-2"></i>Personnalité
                                </button>
                            </li>
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link" id="appearance-tab" data-bs-toggle="tab" data-bs-target="#appearance" type="button" role="tab" aria-controls="appearance" aria-selected="false">
                                    <i class="fas fa-user me-2"></i>Apparence
                                </button>
                            </li>
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link" id="abilities-tab" data-bs-toggle="tab" data-bs-target="#abilities" type="button" role="tab" aria-controls="abilities" aria-selected="false">
                                    <i class="fas fa-fist-raised me-2"></i>Capacités
                                </button>
                            </li>
                            {% if character.equipment %}
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link" id="equipment-tab" data-bs-toggle="tab" data-bs-target="#equipment" type="button" role="tab" aria-controls="equipment" aria-selected="false">
                                    <i class="fas fa-shield-alt me-2"></i>Équipements
                                </button>
                            </li>
                            {% endif %}
                            {% if character.weaknesses %}
                            <li class="character-tab-item" role="presentation">
                                <button class="character-tab-link" id="weaknesses-tab" data-bs-toggle="tab" data-bs-target="#weaknesses" type="button" role="tab" aria-controls="weaknesses" aria-selected="false">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Faiblesses
                                </button>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                    <div class="tab-content p-3 border border-top-0 rounded-bottom" id="characterTabContent">
                        <div class="tab-pane fade show active" id="biography" role="tabpanel" aria-labelledby="biography-tab">
                            {% if character.biography %}
                                <div class="character-biography">
                                    {{ character.biography|raw }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune biographie n'a été rédigée pour ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="personality" role="tabpanel" aria-labelledby="personality-tab">
                            {% if character.personality %}
                                <div class="character-info">
                                    {{ character.personality|raw }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune information sur la personnalité de ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="appearance" role="tabpanel" aria-labelledby="appearance-tab">
                            {% if character.appearance %}
                                <div class="character-info">
                                    {{ character.appearance|raw }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune description de l'apparence de ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="abilities" role="tabpanel" aria-labelledby="abilities-tab">
                            {% if character.abilities %}
                                <div class="character-info">
                                    {{ character.abilities|raw }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune capacité ou compétence spécifiée pour ce personnage.</p>
                            {% endif %}
                        </div>
                        {% if character.equipment %}
                        <div class="tab-pane fade" id="equipment" role="tabpanel" aria-labelledby="equipment-tab">
                            <div class="character-info">
                                {{ character.equipment|raw }}
                            </div>
                        </div>
                        {% endif %}
                        {% if character.weaknesses %}
                        <div class="tab-pane fade" id="weaknesses" role="tabpanel" aria-labelledby="weaknesses-tab">
                            <div class="character-info">
                                {{ character.weaknesses|raw }}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {% if threads|length > 0 %}
        <h3 class="mb-3">Scènes de roleplay avec ce personnage</h3>
        <div class="list-group mb-4">
            {% for thread in threads %}
                <a href="{{ path('app_roleplay_thread_show', {'id': thread.id}) }}" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">{{ thread.title }}</h5>
                        <span class="badge {% if thread.status == 'open' %}bg-success{% elseif thread.status == 'closed' %}bg-warning{% else %}bg-secondary{% endif %}">
                            {{ thread.status == 'open' ? 'Ouvert' : (thread.status == 'closed' ? 'Fermé' : 'Archivé') }}
                        </span>
                    </div>
                    <p class="mb-1 text-truncate">{{ thread.description|striptags|u.truncate(150, '...') }}</p>
                    <small class="text-muted">
                        {% if thread.universe %}
                            <span class="me-2"><i class="fas fa-globe-europe"></i> {{ thread.universe.name }}</span>
                        {% endif %}
                        {% if thread.location %}
                            <span class="me-2"><i class="fas fa-map-marker-alt"></i> {{ thread.location.name }}</span>
                        {% endif %}
                        <span><i class="fas fa-calendar"></i> {{ thread.updatedAt|date('d/m/Y') }}</span>
                    </small>
                </a>
            {% endfor %}
        </div>
    {% endif %}
    
    <div class="d-flex justify-content-between">
        <a href="{{ path('app_roleplay_characters') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste des personnages
        </a>
        {% if isOwner %}
            <form method="post" action="{{ path('app_roleplay_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                <button class="btn btn-outline-danger">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}