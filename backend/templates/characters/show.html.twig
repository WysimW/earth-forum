{% extends 'base.html.twig' %}

{% block title %}{{ character.name }}{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {'breadcrumbs': breadcrumbs} %}
    
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 mb-0">{{ character.name }}</h1>
                {% if isOwner %}
                    <div class="btn-group">
                        <a href="{{ path('app_roleplay_character_edit', {'id': character.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a href="{{ path('app_roleplay_character_relationships', {'id': character.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-users"></i> Relations
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
        <div class="card-body">
            <div class="character-header mb-4">
                <h1 class="mb-0">{{ character.name }}</h1>
                {% if character.universe %}
                    <span class="badge bg-primary me-2">{{ character.universe.name }}</span>
                {% endif %}
                <span class="character-status status-{{ character.status }}">
                    {% if character.status == 'pending' %}
                        En attente de validation
                    {% elseif character.status == 'validated' %}
                        Personnage validé
                    {% else %}
                        Personnage refusé
                    {% endif %}
                </span>
            </div>
            <div class="row">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    {% if character.avatar %}
                        <img src="{{ character.avatar }}" alt="{{ character.name }}" class="img-fluid rounded mb-3" style="max-height: 300px;">
                    {% else %}
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center mb-3" style="height: 200px;">
                            <i class="fas fa-user fa-5x"></i>
                        </div>
                    {% endif %}
                    
                    <div class="mb-3">
                        {% if character.universe %}
                            <span class="badge bg-primary fs-6 mb-2">{{ character.universe.name }}</span>
                        {% endif %}
                    </div>
                    
                    <div class="text-muted small">
                        <div>Créé par: {{ character.user.pseudo }}</div>
                        <div>Créé le: {{ character.createdAt|date('d/m/Y') }}</div>
                    </div>
                </div>
                <div class="col-md-8">
                    <ul class="nav nav-tabs" id="characterTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="bio-tab" data-bs-toggle="tab" data-bs-target="#bio" type="button" role="tab">Biographie</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="personality-tab" data-bs-toggle="tab" data-bs-target="#personality" type="button" role="tab">Personnalité</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="appearance-tab" data-bs-toggle="tab" data-bs-target="#appearance" type="button" role="tab">Apparence</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="abilities-tab" data-bs-toggle="tab" data-bs-target="#abilities" type="button" role="tab">Capacités</button>
                        </li>
                    </ul>
                    <div class="tab-content p-3 border border-top-0 rounded-bottom" id="characterTabContent">
                        <div class="tab-pane fade show active" id="bio" role="tabpanel" aria-labelledby="bio-tab">
                            {% if character.biography %}
                                <div class="character-biography">
                                    {{ character.biography|raw }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune biographie n'a été rédigée pour ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="personality" role="tabpanel" aria-labelledby="personality-tab">
                            {% if character.personality %}
                                <div class="character-info">
                                    {{ character.personality|nl2br }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune information sur la personnalité de ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="appearance" role="tabpanel" aria-labelledby="appearance-tab">
                            {% if character.appearance %}
                                <div class="character-info">
                                    {{ character.appearance|nl2br }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune description de l'apparence de ce personnage.</p>
                            {% endif %}
                        </div>
                        <div class="tab-pane fade" id="abilities" role="tabpanel" aria-labelledby="abilities-tab">
                            {% if character.abilities %}
                                <div class="character-info">
                                    {{ character.abilities|nl2br }}
                                </div>
                            {% else %}
                                <p class="text-muted fst-italic">Aucune capacité ou compétence spécifiée pour ce personnage.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {% if threads|length > 0 %}
        <h3 class="mb-3">Scènes de roleplay avec ce personnage</h3>
        <div class="list-group mb-4">
            {% for thread in threads %}
                <a href="{{ path('app_roleplay_thread_show', {'id': thread.id}) }}" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">{{ thread.title }}</h5>
                        <span class="badge {% if thread.status == 'open' %}bg-success{% elseif thread.status == 'closed' %}bg-warning{% else %}bg-secondary{% endif %}">
                            {{ thread.status == 'open' ? 'Ouvert' : (thread.status == 'closed' ? 'Fermé' : 'Archivé') }}
                        </span>
                    </div>
                    <p class="mb-1 text-truncate">{{ thread.description|striptags|u.truncate(150, '...') }}</p>
                    <small class="text-muted">
                        {% if thread.universe %}
                            <span class="me-2"><i class="fas fa-globe-europe"></i> {{ thread.universe.name }}</span>
                        {% endif %}
                        {% if thread.location %}
                            <span class="me-2"><i class="fas fa-map-marker-alt"></i> {{ thread.location.name }}</span>
                        {% endif %}
                        <span><i class="fas fa-calendar"></i> {{ thread.updatedAt|date('d/m/Y') }}</span>
                    </small>
                </a>
            {% endfor %}
        </div>
    {% endif %}
    
    <div class="d-flex justify-content-between">
        <a href="{{ path('app_roleplay_characters') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la liste des personnages
        </a>
        {% if isOwner %}
            <form method="post" action="{{ path('app_roleplay_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                <button class="btn btn-outline-danger">
                    <i class="fas fa-trash"></i> Supprimer
                </button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}