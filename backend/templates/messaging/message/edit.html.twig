{% extends 'base.html.twig' %}

{% block title %}Modifier un message - Messagerie{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/components/messaging.css') }}">
{% endblock %}

{% block body %}
<div class="container my-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {
        'breadcrumbs': [
            {'label': 'Accueil', 'path': path('app_home')},
            {'label': 'Messagerie', 'path': path('app_messaging_conversations_index')},
            {'label': message.conversation.name, 'path': path('app_messaging_conversation_show', {'id': message.conversation.id})},
            {'label': 'Modifier un message', 'path': null}
        ]
    } %}

    <div class="message-edit-container">
        <div class="card">
            <div class="card-header">
                <h2>Modifier votre message</h2>
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'id': 'messageEditForm'}}) }}
                    {{ form_widget(form.content, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                    {{ form_errors(form.content) }}
                    
                    <div class="mt-3">
                        <a href="{{ path('app_messaging_conversation_show', {'id': message.conversation.id}) }}" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Focus sur le champ de texte
        document.querySelector('textarea').focus();
    });
</script>
{% endblock %} 