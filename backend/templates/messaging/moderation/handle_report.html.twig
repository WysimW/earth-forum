{% extends 'base.html.twig' %}

{% block title %}Traiter un signalement{% endblock %}

{% block body %}
<div class="container py-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {
        'breadcrumbs': [
            {'name': 'Messagerie', 'url': path('app_messaging_conversations_index')},
            {'name': 'Modération', 'url': path('app_messaging_moderation_reports')},
            {'name': 'Traiter un signalement', 'url': null}
        ]
    } %}
    
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h2 class="card-title h5 mb-0">Traiter un signalement</h2>
                    <span class="badge bg-warning">{{ report.reasonLabel }}</span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h4 class="h6">Informations sur le signalement</h4>
                            <table class="table table-sm">
                                <tr>
                                    <th style="width: 40%">Date du signalement</th>
                                    <td>{{ report.createdAt|date('d/m/Y H:i') }}</td>
                                </tr>
                                <tr>
                                    <th>Signalé par</th>
                                    <td>{{ report.reporter.pseudo }}</td>
                                </tr>
                                <tr>
                                    <th>Conversation</th>
                                    <td>
                                        <a href="{{ path('app_messaging_conversation_show', {'id': report.message.conversation.id}) }}" class="text-decoration-none">
                                            {{ report.message.conversation.name }}
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Détails</th>
                                    <td>{{ report.details|nl2br ?: 'Aucun détail fourni' }}</td>
                                </tr>
                            </table>
                        </div>
                        
                        <div class="col-md-6">
                            <h4 class="h6">Informations sur l'auteur</h4>
                            <table class="table table-sm">
                                <tr>
                                    <th style="width: 40%">Auteur du message</th>
                                    <td>{{ report.message.author.pseudo }}</td>
                                </tr>
                                <tr>
                                    <th>Date du message</th>
                                    <td>{{ report.message.createdAt|date('d/m/Y H:i') }}</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <div class="message-preview mb-4 p-3 border rounded bg-light">
                        <div class="d-flex mb-2">
                            <div class="me-2">
                                <img src="{{ report.message.author.avatar ?: asset('images/default-avatar.png') }}" 
                                     alt="{{ report.message.author.pseudo }}" 
                                     class="rounded-circle" 
                                     width="40" height="40">
                            </div>
                            <div>
                                <strong>{{ report.message.author.pseudo }}</strong>
                                <div class="text-muted small">
                                    {{ report.message.createdAt|date('d/m/Y H:i') }}
                                </div>
                            </div>
                        </div>
                        <div class="message-content">
                            {{ report.message.content|raw }}
                        </div>
                    </div>
                    
                    <div class="moderation-actions mt-4">
                        <h4 class="h6 mb-3">Action de modération</h4>
                        
                        {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                            {{ form_errors(form) }}
                            
                            <div class="mb-3">
                                {{ form_label(form.action) }}
                                {{ form_widget(form.action) }}
                                <div class="invalid-feedback">
                                    {{ form_errors(form.action) }}
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                {{ form_label(form.moderationNotes) }}
                                {{ form_widget(form.moderationNotes, {'attr': {'class': 'form-control'}}) }}
                                <div class="form-text">
                                    Ces notes ne seront visibles que par les modérateurs.
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between">
                                <a href="{{ path('app_messaging_moderation_reports') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Retour
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-gavel me-1"></i> Appliquer la décision
                                </button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 