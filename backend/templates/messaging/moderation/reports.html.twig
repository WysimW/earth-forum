{% extends 'base.html.twig' %}

{% block title %}Modération - Signalements{% endblock %}

{% block body %}
<div class="container py-4">
    {# Fil d'Ariane #}
    {% include 'components/_breadcrumb.html.twig' with {
        'breadcrumbs': [
            {'name': 'Messagerie', 'url': path('app_messaging_conversations_index')},
            {'name': 'Modération', 'url': null}
        ]
    } %}
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Modération des messages</h1>
        <div class="badge bg-danger">{{ totalCount }} signalement(s) en attente</div>
    </div>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">
            {{ message }}
        </div>
    {% endfor %}
    
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">Signalements en attente</h5>
        </div>
        <div class="card-body p-0">
            {% if reports is empty %}
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <p class="lead">Aucun signalement en attente</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Conversation</th>
                                <th>Signalé par</th>
                                <th>Raison</th>
                                <th>Message</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for report in reports %}
                                <tr>
                                    <td>{{ report.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <a href="{{ path('app_messaging_conversation_show', {'id': report.message.conversation.id}) }}" class="text-decoration-none">
                                            {{ report.message.conversation.name }}
                                        </a>
                                    </td>
                                    <td>{{ report.reporter.pseudo }}</td>
                                    <td>
                                        <span class="badge bg-warning">{{ report.reasonLabel }}</span>
                                    </td>
                                    <td class="text-truncate" style="max-width: 250px;">
                                        {{ report.message.content|striptags|slice(0, 50) }}{% if report.message.content|length > 50 %}...{% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('app_messaging_report_handle', {'id': report.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-gavel"></i> Traiter
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                {% if totalCount > limit %}
                    <div class="d-flex justify-content-center py-3">
                        <nav>
                            <ul class="pagination mb-0">
                                {% if offset > 0 %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_messaging_moderation_reports', {'offset': max(0, offset - limit)}) }}">
                                            Précédent
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="page-item disabled">
                                        <span class="page-link">Précédent</span>
                                    </li>
                                {% endif %}
                                
                                {% for i in range(0, (totalCount - 1) // limit) %}
                                    <li class="page-item {{ i * limit == offset ? 'active' : '' }}">
                                        <a class="page-link" href="{{ path('app_messaging_moderation_reports', {'offset': i * limit}) }}">
                                            {{ i + 1 }}
                                        </a>
                                    </li>
                                {% endfor %}
                                
                                {% if offset + limit < totalCount %}
                                    <li class="page-item">
                                        <a class="page-link" href="{{ path('app_messaging_moderation_reports', {'offset': offset + limit}) }}">
                                            Suivant
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="page-item disabled">
                                        <span class="page-link">Suivant</span>
                                    </li>
                                {% endif %}
                            </ul>
                        </nav>
                    </div>
                {% endif %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 