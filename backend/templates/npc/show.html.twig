{% extends 'base.html.twig' %}

{% block title %}{{ npc.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.npc-tabs {
    display: flex;
    border-bottom: 2px solid #dee2e6;
    margin-bottom: 1rem;
}

.npc-tab {
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    border: none;
    background: none;
    font-weight: 500;
    color: #6c757d;
    position: relative;
    transition: all 0.3s ease;
}

.npc-tab:hover {
    color: #0d6efd;
}

.npc-tab.active {
    color: #0d6efd;
}

.npc-tab.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #0d6efd;
}

.npc-tab i {
    margin-right: 0.5rem;
}

.npc-tab-content {
    display: none;
}

.npc-tab-content.active {
    display: block;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.npc-content {
    margin-bottom: 1.5rem;
}

.npc-content:last-child {
    margin-bottom: 0;
}

.cursor-pointer {
    cursor: pointer;
}
</style>
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-4">
                {% if npc.avatar %}
                    <img src="{{ npc.avatar }}" class="img-fluid rounded" alt="{{ npc.name }}">
                {% endif %}
                
                <div class="card mt-3">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Informations de base</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Nom :</strong> {{ npc.name }}</p>
                        {% if npc.firstName %}<p><strong>Prénom :</strong> {{ npc.firstName }}</p>{% endif %}
                        {% if npc.lastName %}<p><strong>Nom de famille :</strong> {{ npc.lastName }}</p>{% endif %}
                        {% if npc.pseudonyms %}<p><strong>Pseudonymes :</strong> {{ npc.pseudonyms }}</p>{% endif %}
                        {% if npc.gender %}<p><strong>Genre :</strong> {{ npc.gender }}</p>{% endif %}
                        {% if npc.age %}<p><strong>Âge :</strong> {{ npc.age }}</p>{% endif %}
                        <p><strong>Univers :</strong> {{ npc.universe.name }}</p>
                        <p><strong>Statut :</strong> 
                            <span class="badge bg-{{ npc.status == 'validated' ? 'success' : (npc.status == 'pending' ? 'warning' : 'secondary') }} cursor-pointer" 
                                  data-bs-toggle="modal" 
                                  data-bs-target="#statusModal">
                                {{ npc.status }}
                            </span>
                        </p>
                    </div>
                </div>

                {% if is_granted('edit', npc) %}
                    <div class="mt-3">
                        <a href="{{ path('app_npc_edit', {'id': npc.id}) }}" class="btn btn-warning">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        {{ include('npc/_delete_form.html.twig') }}
                    </div>
                {% endif %}

                {% if is_granted('ROLE_MODERATOR') and npc.status == 'pending' %}
                    <div class="mt-3">
                        <form method="post" action="{{ path('app_npc_validate', {'id': npc.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ npc.id) }}">
                            <button class="btn btn-success">
                                <i class="fas fa-check"></i> Valider
                            </button>
                        </form>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="fas fa-times"></i> Rejeter
                        </button>
                    </div>
                {% endif %}

                {# Formulaire de changement de statut pour le propriétaire #}
                {% if is_granted('edit', npc) and npc.status != 'validated' and npc.status != 'abandoned' %}
                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-tasks"></i> Modifier le statut
                            </h5>
                        </div>
                        <div class="card-body">
                            <form action="{{ path('app_npc_update_status', {'id': npc.id}) }}" method="post">
                                <div class="mb-3">
                                    <label for="status" class="form-label">Statut</label>
                                    <select name="status" id="status" class="form-select">
                                        {% if npc.status == 'draft' %}
                                            <option value="pending">Soumettre pour validation</option>
                                        {% endif %}
                                        {% if npc.status == 'rejected' or npc.status == 'editing' %}
                                            <option value="pending">Soumettre à nouveau</option>
                                        {% endif %}
                                        <option value="abandoned">Abandonner la fiche</option>
                                        <option value="draft">Retoucher ma fiche</option>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label for="status_message" class="form-label">Message de statut (facultatif)</label>
                                    <input type="text" name="status_message" id="status_message" class="form-control" placeholder="Ex: En attente de validation">
                                </div>

                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Mettre à jour le statut
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="col-md-8">
                <div class="npc-tabs">
                    <button class="npc-tab active" data-tab="description">
                        <i class="fas fa-book-open"></i> Description
                    </button>
                    <button class="npc-tab" data-tab="characteristics">
                        <i class="fas fa-user-tag"></i> Caractéristiques
                    </button>
                </div>

                {# Onglet Description #}
                <div class="npc-tab-content active" id="description">
                    <div class="card">
                        <div class="card-body">
                            {% if npc.biography %}
                                <h6>Biographie</h6>
                                <div class="npc-content">{{ npc.biography|raw }}</div>
                            {% endif %}

                            {% if npc.personality %}
                                <h6>Personnalité</h6>
                                <div class="npc-content">{{ npc.personality|raw }}</div>
                            {% endif %}

                            {% if npc.appearance %}
                                <h6>Apparence</h6>
                                <div class="npc-content">{{ npc.appearance|raw }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {# Onglet Caractéristiques #}
                <div class="npc-tab-content" id="characteristics">
                    <div class="card">
                        <div class="card-body">
                            {% if npc.abilities %}
                                <h6>Capacités</h6>
                                <div class="npc-content">{{ npc.abilities|raw }}</div>
                            {% endif %}

                            {% if npc.equipment %}
                                <h6>Équipement</h6>
                                <div class="npc-content">{{ npc.equipment|raw }}</div>
                            {% endif %}

                            {% if npc.weaknesses %}
                                <h6>Faiblesses</h6>
                                <div class="npc-content">{{ npc.weaknesses|raw }}</div>
                            {% endif %}

                            {% if npc.moralAffiliation %}
                                <h6>Alignement moral</h6>
                                <div class="npc-content">{{ npc.moralAffiliation }}</div>
                            {% endif %}

                            {% if npc.factions %}
                                <h6>Factions</h6>
                                <div class="npc-content">{{ npc.factions|raw }}</div>
                            {% endif %}

                            {% if npc.occupation %}
                                <h6>Occupation</h6>
                                <div class="npc-content">{{ npc.occupation }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if is_granted('ROLE_MODERATOR') %}
        <!-- Modal de rejet -->
        <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="rejectModalLabel">Rejeter le PNJ</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" action="{{ path('app_npc_reject', {'id': npc.id}) }}">
                        <div class="modal-body">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ npc.id) }}">
                            <div class="mb-3">
                                <label for="rejection_reason" class="form-label">Raison du rejet</label>
                                <textarea class="form-control" id="rejection_reason" name="rejection_reason" rows="3" required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-danger">Rejeter</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Modal de modification de statut -->
    <div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="statusModalLabel">Modifier le statut</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="{{ path('app_npc_update_status', {'id': npc.id}) }}" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="status" class="form-label">Nouveau statut</label>
                            <select name="status" id="status" class="form-select">
                                {% if npc.status == 'draft' %}
                                    <option value="pending">Soumettre pour validation</option>
                                {% endif %}
                                {% if npc.status == 'rejected' or npc.status == 'editing' %}
                                    <option value="pending">Soumettre à nouveau</option>
                                {% endif %}
                                <option value="abandoned">Abandonner la fiche</option>
                                <option value="draft">Retoucher ma fiche</option>
                                {% if is_granted('ROLE_MODERATOR') %}
                                    <option value="validated">Valider</option>
                                    <option value="rejected">Refuser</option>
                                    <option value="editing">Demander une modification</option>
                                {% endif %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="status_message" class="form-label">Message de statut (facultatif)</label>
                            <input type="text" name="status_message" id="status_message" class="form-control" placeholder="Ex: En attente de validation">
                        </div>

                        {% if is_granted('ROLE_MODERATOR') %}
                            <div class="mb-3">
                                <label for="moderation_note" class="form-label">Note de modération (facultatif)</label>
                                <textarea name="moderation_note" id="moderation_note" class="form-control" rows="3" placeholder="Ajoutez une note ou des commentaires..."></textarea>
                            </div>
                        {% endif %}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary">Mettre à jour</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.npc-tab');
    const tabContents = document.querySelectorAll('.npc-tab-content');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            // Retirer la classe active de tous les onglets et contenus
            tabs.forEach(t => t.classList.remove('active'));
            tabContents.forEach(c => c.classList.remove('active'));

            // Ajouter la classe active à l'onglet cliqué
            tab.classList.add('active');

            // Afficher le contenu correspondant
            const tabId = tab.getAttribute('data-tab');
            document.getElementById(tabId).classList.add('active');
        });
    });
});
</script>
{% endblock %} 