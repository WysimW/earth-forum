<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}DC Earth{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🌍</text></svg>">
        {% block stylesheets %}
            <!-- Bootstrap CSS -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
            <!-- Quill Editor CSS -->
            <link href="https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.snow.min.css" rel="stylesheet">
            <!-- Notre thème CSS pour l'éditeur Quill -->
            <link href="/css/components/quill-editor.css" rel="stylesheet">
            <!-- Font Awesome (CDN gratuit) -->
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
            <!-- Select2 CSS -->
            <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
            <!-- Select2 Bootstrap 5 Theme CSS -->
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
            <!-- Select2 Theme personnalisé Earth Forum -->
            <style>

            </style>
            <!-- Styles généraux -->
            <link rel="stylesheet" href="/css/main.css">
            <!-- Google Fonts -->
            <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Orbitron:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
            <!-- Google Fonts pour l'éditeur -->
            <link href="https://fonts.googleapis.com/css2?family=Trebuchet+MS&family=Georgia&family=Arial&family=Verdana&display=swap" rel="stylesheet">
            <!-- Custom styles -->
            <link rel="stylesheet" href="{{ asset('css/components/variables.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/layout.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/typography.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/buttons.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/cards.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/forms.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/tables.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/forums.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/posts.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/utilities.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/animations.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/responsive.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/tinymce-theme.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/universe.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/factions.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/breadcrumbs.css') }}">
            <link rel="stylesheet" href="{{ asset('css/libraries/select2-custom.css') }}">
            
            <!-- Script pour appliquer l'état de la sidebar immédiatement -->
            <script>
                (function() {
                    // Masquer temporairement le contenu pendant le chargement
                    document.documentElement.classList.add('loading-sidebar');
                    
                    // Récupérer l'état de la sidebar depuis localStorage
                    const savedSidebarState = localStorage.getItem('sidebarState');
                    if (savedSidebarState) {
                        // Appliquer la classe appropriée au document avant le rendu initial
                        if (savedSidebarState === 'compact') {
                            document.documentElement.classList.add('sidebar-loading-compact');
                        } else if (savedSidebarState === 'closed') {
                            document.documentElement.classList.add('sidebar-loading-closed');
                        }
                    }
                    
                    // Révéler le contenu après un court délai pour permettre au CSS de s'appliquer
                    setTimeout(function() {
                        document.documentElement.classList.remove('loading-sidebar');
                    }, 50);
                })();
            </script>
            <style>
                /* Style pour masquer le contenu pendant le chargement initial */
                html.loading-sidebar .main-wrapper {
                    opacity: 0;
                }
                
                .main-wrapper {
                    transition: opacity 0.2s ease;
                }
                
                /* Styles pour éviter le flash pendant le chargement */
                html.sidebar-loading-compact .main-wrapper {
                    grid-template-columns: var(--sidebar-compact-width) 1fr !important;
                }
                html.sidebar-loading-compact .sidebar {
                    width: var(--sidebar-compact-width) !important;
                }
                html.sidebar-loading-compact .sidebar-title {
                    display: none !important;
                }
                html.sidebar-loading-compact .sidebar-menu-text {
                    display: none !important;
                }
                
                html.sidebar-loading-closed .main-wrapper {
                    grid-template-columns: 0 1fr !important;
                }
                html.sidebar-loading-closed .sidebar {
                    transform: translateX(-100%) !important;
                }
            </style>
        {% endblock %}
    </head>
    <body class="{% if app.user %}user-logged-in{% endif %}"{% if savedSidebarState is defined %} data-sidebar-state="{{ savedSidebarState }}"{% endif %}>
        <div class="main-wrapper">
            <header>
                <nav class="navbar navbar-expand-lg navbar-dark">
                    <div class="container">
                        <a class="navbar-brand" href="{{ path('app_roleplay') }}">
                            <img src="{{ asset('images/logo-dc.png') }}" alt="DC Earth Logo" class="logo">
                            DC Earth
                        </a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse" id="navbarMain">
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_roleplay') }}">Accueil</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="universDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Univers <span class="dropdown-arrow">▼</span>
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="universDropdown">
                                        <li><a class="dropdown-item" href="{{ path('app_univers_index') }}"><i class="fas fa-globe"></i> Tous les univers</a></li>
                                        
                                        {% set favorite_universes = user_favorite_universes() %}
                                        
                                        {% if favorite_universes|length > 0 %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Vos univers</h6></li>
                                            {% for univers in favorite_universes %}
                                                <li><a class="dropdown-item" href="{{ path('app_univers_forums', {'slug': univers.slug}) }}">
                                                    <i class="fas fa-star"></i> {{ univers.name }}
                                                </a></li>
                                            {% endfor %}
                                        {% endif %}
                                        
                                        {% if all_univers is defined and all_univers|length > 0 %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header">Tous les univers</h6></li>
                                            {% for univers in all_univers %}
                                                <li><a class="dropdown-item" href="{{ path('app_univers_forums', {'slug': univers.slug}) }}">
                                                    <i class="fas fa-globe-americas"></i> {{ univers.name }}
                                                </a></li>
                                            {% endfor %}
                                        {% endif %}
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_factions_index') }}">Factions</a>
                                </li>
                            </ul>
                            <div class="navbar-nav ms-auto">
                                <div class="nav-item me-2">
                                    <a class="nav-link" href="{{ path('app_roleplay_search') }}" title="Rechercher">
                                        <i class="fas fa-search"></i>
                                    </a>
                                </div>
                                {% if app.user %}
                                    <div class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                            <i class="fas fa-user-circle me-1"></i> {{ app.user.pseudo }} <span class="dropdown-arrow">▼</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="{{ path('app_roleplay_dashboard') }}"><i class="fas fa-columns"></i> Tableau de bord</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_roleplay_characters', {'universeSlug': univers.slug|default(all_univers[0].slug|default('dc'))}) }}"><i class="fas fa-user-astronaut"></i> Mes Personnages</a></li>
                                            <li><a class="dropdown-item" href="{{ path('app_my_factions_index') }}"><i class="fas fa-shield-alt"></i> Mes Factions</a></li>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}"><i class="fas fa-toolbox"></i> Administration</a></li>
                                            {% endif %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt"></i> Déconnexion</a></li>
                                        </ul>
                                    </div>
                                {% else %}
                                    <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                                    <a class="btn btn-primary ms-2" href="{{ path('app_register') }}">Inscription</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </nav>
            </header>

            <aside class="sidebar">
                <div class="sidebar-header">
                    <h3 class="sidebar-title">Navigation</h3>
                    <button class="sidebar-toggle" id="sidebarToggle" title="Réduire la sidebar">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                </div>
                
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-title">Navigation</li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_roleplay') }}" class="sidebar-menu-link" data-title="Accueil">
                            <i class="fas fa-globe"></i> <span class="sidebar-menu-text">Accueil</span>
                        </a>
                    </li>
                    
                    {% set favorite_universes = user_favorite_universes() %}
                    
                    {% if favorite_universes|length > 0 %}
                        {% for univers in favorite_universes %}
                        <li class="sidebar-menu-item">
                            <a href="{{ path('app_univers_forums', {'slug': univers.slug}) }}" class="sidebar-menu-link" data-title="{{ univers.name }}">
                                <i class="fas fa-globe-americas"></i> <span class="sidebar-menu-text">{{ univers.name }}</span>
                            </a>
                        </li>
                        {% endfor %}
                    {% else %}
                        <li class="sidebar-menu-item">
                            <a href="{{ path('app_univers_index') }}" class="sidebar-menu-link" data-title="Univers">
                                <i class="fas fa-globe-americas"></i> <span class="sidebar-menu-text">Univers</span>
                            </a>
                        </li>
                    {% endif %}
                    
                </ul>
                
                
                {% if app.user %}
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-title">Vos contenus</li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_roleplay_dashboard') }}" class="sidebar-menu-link" data-title="Tableau de bord">
                            <i class="fas fa-columns"></i> <span class="sidebar-menu-text">Tableau de bord</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_roleplay_characters', {'universeSlug': univers.slug|default(all_univers[0].slug|default('dc'))}) }}" class="sidebar-menu-link" data-title="Mes Personnages">
                            <i class="fas fa-user-astronaut"></i> <span class="sidebar-menu-text">Mes Personnages</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_my_factions_index') }}" class="sidebar-menu-link" data-title="Mes Factions">
                            <i class="fas fa-shield-alt"></i> <span class="sidebar-menu-text">Mes Factions</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug|default(all_univers[0].slug|default('dc'))}) }}?type=participating" class="sidebar-menu-link" data-title="Mes participations">
                            <i class="fas fa-users"></i> <span class="sidebar-menu-text">Mes participations</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_roleplay_threads_filter', {'universeSlug': univers.slug|default(all_univers[0].slug|default('dc'))}) }}?type=created" class="sidebar-menu-link" data-title="Mes scènes">
                            <i class="fas fa-pen-fancy"></i> <span class="sidebar-menu-text">Mes scènes</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_unread_messages_index') }}" class="sidebar-menu-link position-relative" data-title="Posts non lus">
                            <i class="fas fa-envelope"></i> <span class="sidebar-menu-text">Posts non lus</span>
                            {% if total_unread_count() > 0 %}
                                <span class="badge bg-danger rounded-pill ms-2 notification-badge" data-count="{{ total_unread_count() }}">{{ total_unread_count() }}</span>
                            {% endif %}
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_messaging_conversations_index') }}" class="sidebar-menu-link position-relative" data-title="Messagerie">
                            <i class="fas fa-comments"></i> <span class="sidebar-menu-text">Messagerie</span>
                            {% if messaging_unread_count() > 0 %}
                                <span class="badge bg-danger rounded-pill ms-2 notification-badge messaging-badge">{{ messaging_unread_count() }}</span>
                            {% else %}
                                <span class="badge bg-danger rounded-pill ms-2 notification-badge messaging-badge" style="display: none;">0</span>
                            {% endif %}
                        </a>
                    </li>
                    {% if is_granted('ROLE_USER') and app.user.canCreateFaction() %}
                    <li class="sidebar-menu-item">
                        <a href="{{ path('app_faction_new') }}" class="sidebar-menu-link" data-title="Créer une faction">
                            <i class="fas fa-plus-circle"></i> <span class="sidebar-menu-text">Créer une faction</span>
                        </a>
                    </li>
                    {% endif %}
                </ul>
                {% endif %}
                
                
                {% if is_granted('ROLE_ADMIN') %}
                <ul class="sidebar-menu">
                    <li class="sidebar-menu-title">Administration</li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_dashboard') }}" class="sidebar-menu-link" data-title="Panneau d'admin">
                            <i class="fas fa-toolbox"></i> <span class="sidebar-menu-text">Panneau d'admin</span>
                        </a>
                    </li>
                    <li class="sidebar-menu-item">
                        <a href="{{ path('admin_user_index') }}" class="sidebar-menu-link" data-title="Gestion utilisateurs">
                            <i class="fas fa-users-cog"></i> <span class="sidebar-menu-text">Gestion utilisateurs</span>
                        </a>
                    </li>
                </ul>
                {% endif %}
            </aside>
            
            <button class="sidebar-collapse" id="sidebarCollapseToggle" title="Afficher/Masquer la sidebar">
                <i class="fas fa-bars"></i>
            </button>
            
            <button class="sidebar-reopen" id="sidebarReopenButton" title="Ouvrir la sidebar">
                <i class="fas fa-chevron-right"></i>
            </button>

            <main class="content">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
                
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
                
                {% block body %}{% endblock %}
            </main>

            <footer>
                <div class="container">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="title">DC Earth</h5>
                            <p class="small">Une plateforme de roleplay textuel inspirée de l'univers DC Comics dans une vision cosmique et moderne.</p>
                        </div>
                        <div class="col-md-3">
                            <h5 class="subtitle">Liens utiles</h5>
                            <ul class="list-unstyled small">
                                <li><a href="{{ path('app_roleplay') }}">Accueil</a></li>
                                <li><a href="{{ path('app_univers_index') }}">Univers</a></li>
                                <li><a href="{{ path('app_factions_index') }}">Factions</a></li>
                                <li><a href="#" onclick="redirectToRpThreads(event)"><i class="fa-solid fa-dice-d20 text-roleplay"></i> Scènes RP</a></li>
                                <li><a href="{{ path('app_roleplay') }}#hrp-forums"><i class="fas fa-comments text-hrp"></i> Forums HRP</a></li>
                                <li><a href="{{ path('app_roleplay_search') }}">Recherche</a></li>
                            </ul>
                        </div>
                        <div class="col-md-3">
                            <h5 class="subtitle">Légal</h5>
                            <ul class="list-unstyled small">
                                <li><a href="#">Conditions d'utilisation</a></li>
                                <li><a href="#">Politique de confidentialité</a></li>
                                <li><a href="#">Crédits</a></li>
                            </ul>
                        </div>
                    </div>
                    <hr class="my-3">
                    <div class="text-center small">
                        <p class="mb-0">&copy; 2025 DC Earth. Tous droits réservés.</p>
                    </div>
                </div>
            </footer>
        </div>

        {% block javascripts %}
            <!-- jQuery (requis pour Select2) -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
            <!-- Bootstrap Bundle with Popper -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
            <!-- Select2 JS -->
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <!-- Select2 Bootstrap 5 Theme -->
            <script src="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.js"></script>
            <!-- Quill.js (éditeur WYSIWYG gratuit) -->
            <script src="https://cdn.jsdelivr.net/npm/quill@2.0.0-rc.2/dist/quill.min.js"></script>
            <!-- Notre éditeur personnalisé basé sur Quill -->
            <script src="/js/dc-editor.js"></script>
            <!-- Gestion des messages non lus -->
            <script src="/js/unread-messages.js"></script>
            <!-- Gestion des messages non lus de la messagerie -->
            <script src="/js/messaging-unread.js"></script>
            <!-- Custom JavaScript -->
            <script>
                // Fonction pour rediriger vers la page des threads RP avec l'univers par défaut
                function redirectToRpThreads(event) {
                    event.preventDefault();
                    // Rediriger vers la route d'accueil qui affiche tous les univers
                    // L'utilisateur pourra ensuite choisir un univers spécifique
                    window.location.href = "{{ path('app_univers_index') }}";
                }
                
                document.addEventListener('DOMContentLoaded', function() {
                    // Enable Bootstrap tooltips
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
                    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl)
                    });
                    
                    // S'assurer que les classes temporaires sont supprimées
                    document.documentElement.classList.remove('loading-sidebar', 'sidebar-loading-compact', 'sidebar-loading-closed');
                    
                    // Initialisation globale de Select2
                    if (document.querySelector('[data-select2], .select2')) {
                        // Initialiser les éléments qui utilisent data-select2
                        $('[data-select2]').select2({
                            width: '100%',
                            placeholder: 'Sélectionnez...',
                            allowClear: true,
                            dropdownCssClass: 'select2-dropdown-dark',
                            language: {
                                noResults: function() {
                                    return "Aucun résultat trouvé";
                                }
                            }
                        });
                        
                        // Initialiser les éléments qui utilisent la classe select2 
                        // mais pas déjà initialisés
                        $('.select2:not(.select2-hidden-accessible)').select2({
                            width: '100%',
                            placeholder: 'Sélectionnez...',
                            allowClear: true,
                            dropdownCssClass: 'select2-dropdown-dark',
                            language: {
                                noResults: function() {
                                    return "Aucun résultat trouvé";
                                }
                            }
                        });
                        
                        // Appliquer des styles spécifiques selon le contexte
                        $('.bg-roleplay, .btn-roleplay').closest('form').find('.select2-container').addClass('select2-roleplay');
                        $('.bg-hrp, .btn-hrp').closest('form').find('.select2-container').addClass('select2-hrp');
                        
                        // Ajouter l'icône de recherche de manière dynamique si le CSS ne fonctionne pas
                        $(document).on('select2:open', function() {
                            setTimeout(function() {
                                if ($('.select2-search__field-icon').length === 0) {
                                    $('.select2-search--dropdown').addClass('select2-search__field-icon-container');
                                    $('.select2-search--dropdown').append('<i class="fas fa-search select2-search__field-icon"></i>');
                                }
                            }, 0);
                        });
                        
                        // Fixer le problème de largeur du champ de recherche inline
                        $(document).on('select2:open', function() {
                            $('.select2-search__field').css('width', 'auto');
                        });
                        
                        // Corriger la largeur du champ après chaque interaction
                        $(document).on('click', '.select2-selection--multiple', function() {
                            setTimeout(function() {
                                $('.select2-search--inline textarea.select2-search__field').each(function() {
                                    $(this).css({
                                        'width': 'auto',
                                        'min-width': '150px'
                                    });
                                });
                            }, 0);
                        });
                    }
                    
                    // Mobile sidebar toggle
                    const sidebarToggle = document.getElementById('sidebarToggle');
                    const sidebarCollapseToggle = document.getElementById('sidebarCollapseToggle');
                    const sidebarReopenButton = document.getElementById('sidebarReopenButton');
                    const sidebar = document.querySelector('.sidebar');
                    const mainWrapper = document.querySelector('.main-wrapper');
                    
                    // Load saved sidebar state from localStorage
                    const savedSidebarState = localStorage.getItem('sidebarState');
                    if (savedSidebarState) {
                        if (savedSidebarState === 'compact') {
                            mainWrapper.classList.add('sidebar-compact');
                            if (sidebarToggle) {
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-right"></i>';
                                sidebarToggle.title = "Fermer la sidebar";
                            }
                        } else if (savedSidebarState === 'closed') {
                            mainWrapper.classList.add('sidebar-closed');
                            if (sidebarToggle) {
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-right"></i>';
                                sidebarToggle.title = "Ouvrir la sidebar";
                            }
                        }
                    }
                    
                    // Handle sidebar toggle button (compact/full)
                    if (sidebarToggle) {
                        sidebarToggle.addEventListener('click', function() {
                            if (mainWrapper.classList.contains('sidebar-closed')) {
                                // If closed, go to full state
                                mainWrapper.classList.remove('sidebar-closed');
                                mainWrapper.classList.remove('sidebar-compact');
                                localStorage.setItem('sidebarState', 'full');
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-left"></i>';
                                sidebarToggle.title = "Réduire la sidebar";
                            } else if (mainWrapper.classList.contains('sidebar-compact')) {
                                // If compact, go to closed state
                                mainWrapper.classList.add('sidebar-closed');
                                mainWrapper.classList.remove('sidebar-compact');
                                localStorage.setItem('sidebarState', 'closed');
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-right"></i>';
                                sidebarToggle.title = "Ouvrir la sidebar";
                            } else {
                                // If full, go to compact state
                                mainWrapper.classList.add('sidebar-compact');
                                localStorage.setItem('sidebarState', 'compact');
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-right"></i>';
                                sidebarToggle.title = "Fermer la sidebar";
                            }
                        });
                    }
                    
                    // Handle reopen button
                    if (sidebarReopenButton) {
                        sidebarReopenButton.addEventListener('click', function() {
                            // Rouvrir la sidebar en mode complet
                            mainWrapper.classList.remove('sidebar-closed');
                            localStorage.setItem('sidebarState', 'full');
                            if (sidebarToggle) {
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-left"></i>';
                                sidebarToggle.title = "Réduire la sidebar";
                            }
                        });
                    }
                    
                    // Handle sidebar collapse toggle (show/hide on mobile)
                    if (sidebarCollapseToggle && sidebar) {
                        sidebarCollapseToggle.addEventListener('click', function() {
                            // Si la sidebar est en mode fermé, la rouvrir en mode complet
                            if (mainWrapper.classList.contains('sidebar-closed')) {
                                mainWrapper.classList.remove('sidebar-closed');
                                localStorage.setItem('sidebarState', 'full');
                                if (sidebarToggle) {
                                    sidebarToggle.innerHTML = '<i class="fas fa-chevron-left"></i>';
                                    sidebarToggle.title = "Réduire la sidebar";
                                }
                            } else {
                                // Comportement normal pour le basculement mobile
                                sidebar.classList.toggle('show');
                            }
                        });
                    }
                    
                    // Add a global click handler for when sidebar is closed
                    document.addEventListener('click', function(event) {
                        // Si on clique sur le burger et que la sidebar est fermée
                        if (event.target.closest('#sidebarCollapseToggle') && mainWrapper.classList.contains('sidebar-closed')) {
                            mainWrapper.classList.remove('sidebar-closed');
                            localStorage.setItem('sidebarState', 'full');
                            if (sidebarToggle) {
                                sidebarToggle.innerHTML = '<i class="fas fa-chevron-left"></i>';
                                sidebarToggle.title = "Réduire la sidebar";
                            }
                        }
                        
                        // Close sidebar when clicking outside on mobile
                        if (sidebar.classList.contains('show') && 
                            !sidebar.contains(event.target) && 
                            event.target !== sidebarCollapseToggle &&
                            !event.target.closest('#sidebarCollapseToggle')) {
                            sidebar.classList.remove('show');
                        }
                    });
                    
                    // Add active class to current page in sidebar
                    const currentPath = window.location.pathname;
                    const sidebarLinks = document.querySelectorAll('.sidebar-menu-link');
                    
                    sidebarLinks.forEach(link => {
                        const href = link.getAttribute('href');
                        if (href === currentPath) {
                            link.closest('.sidebar-menu-item').classList.add('active');
                        }
                    });

                    // Add styles to sidebar links based on category
                    document.querySelectorAll('.rp-link').forEach(link => {
                        link.style.borderLeft = '3px solid var(--roleplay-primary)';
                    });
                    
                    document.querySelectorAll('.hrp-link').forEach(link => {
                        link.style.borderLeft = '3px solid var(--hrp-primary)';
                    });
                });
            </script>
        {% endblock %}
    </body>
</html>
