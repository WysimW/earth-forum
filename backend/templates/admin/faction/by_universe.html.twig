{% extends 'admin/base.html.twig' %}

{% block title %}Factions par univers | Administration{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Factions par univers</h1>
        <div>
            <a href="{{ path('admin_faction_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Vue standard
            </a>
            <a href="{{ path('admin_faction_permissions') }}" class="btn btn-outline-warning ms-2">
                <i class="bi bi-shield-lock"></i> Gérer les permissions
            </a>
            <a href="{{ path('admin_faction_new') }}" class="btn btn-success ms-2">
                <i class="bi bi-plus-circle"></i> Créer une faction
            </a>
        </div>
    </div>

    {% if universes|length > 0 %}
        <div class="accordion" id="universesAccordion">
            {% for universe in universes %}
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading{{ universe.id }}">
                        <button class="accordion-button {% if loop.index > 1 %}collapsed{% endif %}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ universe.id }}" aria-expanded="{{ loop.index == 1 ? 'true' : 'false' }}" aria-controls="collapse{{ universe.id }}">
                            <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                <span>{{ universe.name }}</span>
                                <span class="badge bg-primary rounded-pill">{{ universe.factions|length }} faction(s)</span>
                            </div>
                        </button>
                    </h2>
                    <div id="collapse{{ universe.id }}" class="accordion-collapse collapse {% if loop.index == 1 %}show{% endif %}" aria-labelledby="heading{{ universe.id }}" data-bs-parent="#universesAccordion">
                        <div class="accordion-body">
                            {% if universe.factions|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Nom</th>
                                                <th>Alignement</th>
                                                <th>Statut</th>
                                                <th>Membres</th>
                                                <th>Fondateur</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for faction in universe.factions %}
                                                <tr>
                                                    <td>{{ faction.name }}</td>
                                                    <td>
                                                        {% if faction.alignment %}
                                                            {% set alignmentLabels = {
                                                                'hero': 'Super-héros',
                                                                'villain': 'Super-vilains',
                                                                'antihero': 'Anti-héros',
                                                                'vigilante': 'Vigilante',
                                                                'neutral': 'Neutre',
                                                                'other': 'Autre'
                                                            } %}
                                                            {{ alignmentLabels[faction.alignment] ?? faction.alignment }}
                                                        {% else %}
                                                            <span class="text-muted">Non défini</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        {% if faction.status == 'open' %}
                                                            <span class="badge bg-success">Ouvert</span>
                                                        {% else %}
                                                            <span class="badge bg-danger">Fermé</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-primary">{{ faction.characters|length }} PJ</span>
                                                        <span class="badge bg-info">{{ faction.npcs|length }} PNJ</span>
                                                    </td>
                                                    <td>{{ faction.founder.pseudo }}</td>
                                                    <td>
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('admin_faction_show', {'id': faction.id}) }}" class="btn btn-sm btn-info">
                                                                <i class="bi bi-eye"></i>
                                                            </a>
                                                            <a href="{{ path('admin_faction_edit', {'id': faction.id}) }}" class="btn btn-sm btn-warning">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ faction.id }}">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </div>

                                                        <!-- Modal de confirmation de suppression -->
                                                        <div class="modal fade" id="deleteModal{{ faction.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ faction.id }}" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title" id="deleteModalLabel{{ faction.id }}">Confirmer la suppression</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        Êtes-vous sûr de vouloir supprimer la faction <strong>{{ faction.name }}</strong> ?
                                                                        <p class="text-danger mt-2"><i class="bi bi-exclamation-triangle"></i> Cette action est irréversible.</p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                                        <form method="post" action="{{ path('admin_faction_delete', {'id': faction.id}) }}" style="display: inline-block">
                                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ faction.id) }}">
                                                                            <button type="submit" class="btn btn-danger">Supprimer</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> Aucune faction n'a été créée pour cet univers.
                                </div>
                                <a href="{{ path('admin_faction_new') }}" class="btn btn-primary">
                                    <i class="bi bi-plus"></i> Créer une faction dans cet univers
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> Aucun univers n'a été créé. Veuillez d'abord créer un univers.
        </div>
        <a href="{{ path('admin_univers_new') }}" class="btn btn-primary">
            <i class="bi bi-plus"></i> Créer un univers
        </a>
    {% endif %}
{% endblock %} 