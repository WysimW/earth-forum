{% extends 'admin/base.html.twig' %}

{% block title %}Modifier la faction {{ faction.name }} | Administration{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Modifier la faction "{{ faction.name }}"</h1>
        <div>
            <a href="{{ path('admin_faction_show', {'id': faction.id}) }}" class="btn btn-info">
                <i class="bi bi-eye"></i> Voir
            </a>
            <a href="{{ path('admin_faction_index') }}" class="btn btn-secondary ms-2">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-header">
            <i class="bi bi-pencil"></i> Informations de la faction
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.name) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.universe) }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.alignment) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.scope) }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.status) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.founder) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.objectives) }}
                </div>

                <h4 class="mt-4 mb-3">Quartier général</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.headquarters) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.subforum) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.headquartersDescription) }}
                </div>

                <h4 class="mt-4 mb-3">Membres</h4>
                <div class="row mb-3">
                    <div class="col-md-6">
                        {{ form_row(form.characters) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.npcs) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_row(form.scenes) }}
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Enregistrer les modifications
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-danger text-white">
            <i class="bi bi-exclamation-triangle"></i> Zone de danger
        </div>
        <div class="card-body">
            <h5>Supprimer cette faction</h5>
            <p>Cette action est irréversible et supprimera définitivement cette faction.</p>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash"></i> Supprimer
            </button>

            <!-- Modal de confirmation de suppression -->
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            Êtes-vous sûr de vouloir supprimer la faction <strong>{{ faction.name }}</strong> ?
                            <p class="text-danger mt-2"><i class="bi bi-exclamation-triangle"></i> Cette action est irréversible.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                            <form method="post" action="{{ path('admin_faction_delete', {'id': faction.id}) }}" style="display: inline-block">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ faction.id) }}">
                                <button type="submit" class="btn btn-danger">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('.select2').select2({
                theme: 'bootstrap-5'
            });
        });
    </script>
{% endblock %} 