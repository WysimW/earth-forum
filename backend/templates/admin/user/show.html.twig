{% extends 'admin/base.html.twig' %}

{% block title %}Détails Utilisateur | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails de l'utilisateur</h1>
        <div>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning me-2"><i class="bi bi-pencil"></i> Modifier</a>
            <a href="{{ path('admin_user_change_password', {'id': user.id}) }}" class="btn btn-primary"><i class="bi bi-key"></i> Changer mot de passe</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Profil utilisateur
                </div>
                <div class="card-body text-center">
                    {% if user.avatar %}
                        <img src="{{ user.avatar }}" alt="{{ user.pseudo }}" class="img-fluid rounded-circle mb-3" style="max-width: 150px;">
                    {% else %}
                        <div class="bg-light p-5 rounded-circle d-inline-block mb-3">
                            <i class="bi bi-person-circle fs-1"></i>
                        </div>
                    {% endif %}
                    <h5 class="card-title">{{ user.pseudo }}</h5>
                    <p class="card-text">{{ user.email }}</p>
                    <p>Inscrit depuis le {{ user.createdAt|date('d/m/Y') }}</p>
                    
                    <h6 class="mt-3">Rôles</h6>
                    <div>
                        {% for role in user.playerRoles %}
                            <span class="badge mb-1" style="background-color: {{ role.color }};">{{ role.name }}</span>
                        {% else %}
                            <span class="badge bg-secondary">Aucun rôle</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    Threads créés ({{ user.threads|length }})
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Titre</th>
                                    <th>Forum</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for thread in user.threads %}
                                    <tr>
                                        <td>{{ thread.id }}</td>
                                        <td>{{ thread.title }}</td>
                                        <td>{{ thread.forum.name }}</td>
                                        <td>{{ thread.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5">Aucun thread créé</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    Derniers posts ({{ user.posts|length }})
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Thread</th>
                                    <th>Contenu</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for post in user.posts|slice(0, 10) %}
                                    <tr>
                                        <td>{{ post.id }}</td>
                                        <td>{{ post.thread.title }}</td>
                                        <td>{{ post.content|length > 30 ? post.content|slice(0, 30) ~ '...' : post.content }}</td>
                                        <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <a href="#" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5">Aucun post</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        {% if user.posts|length > 10 %}
                            <div class="text-center mt-2">
                                <span class="badge bg-secondary">{{ user.posts|length - 10 }} posts supplémentaires non affichés</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}