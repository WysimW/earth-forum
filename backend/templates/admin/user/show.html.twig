{% extends 'admin/base.html.twig' %}

{% block title %}Détails Utilisateur | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails de l'utilisateur</h1>
        <div>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-warning me-2"><i class="bi bi-pencil"></i> Modifier</a>
            <a href="{{ path('admin_user_change_password', {'id': user.id}) }}" class="btn btn-primary"><i class="bi bi-key"></i> Changer mot de passe</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    Informations générales
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="150">ID</th>
                                <td>{{ user.id }}</td>
                            </tr>
                            <tr>
                                <th>Pseudo</th>
                                <td>{{ user.pseudo }}</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>{{ user.email }}</td>
                            </tr>
                            <tr>
                                <th>Date d'inscription</th>
                                <td>{{ user.createdAt ? user.createdAt|date('d/m/Y à H:i') : 'Non définie' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <div class="col-md-8 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    Avatar
                </div>
                <div class="card-body text-center">
                    {% if user.avatar %}
                        <img src="{{ user.avatar }}" alt="{{ user.pseudo }}" class="img-fluid rounded" style="max-height: 200px;">
                    {% else %}
                        <div class="alert alert-info">Aucun avatar défini</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Rôles
                </div>
                <div class="card-body">
                    {% if user.playerRoles|length > 0 %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for role in user.playerRoles %}
                                <span class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucun rôle attribué</div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Rôles système
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        {% for role in user.roles %}
                            {% if role != 'ROLE_USER' %}
                                {% set badgeClass = 'bg-secondary' %}
                                {% if role == 'ROLE_ADMIN' %}
                                    {% set badgeClass = 'bg-danger' %}
                                {% elseif role == 'ROLE_MODERATOR' %}
                                    {% set badgeClass = 'bg-warning text-dark' %}
                                {% elseif role == 'ROLE_ANIMATOR' %}
                                    {% set badgeClass = 'bg-info text-dark' %}
                                {% endif %}
                                <span class="badge {{ badgeClass }}">{{ role|replace({'ROLE_': ''}) }}</span>
                            {% endif %}
                        {% else %}
                            <span class="badge bg-secondary">UTILISATEUR</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Activité
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th>Threads créés</th>
                                <td>{{ user.threads|length }}</td>
                            </tr>
                            <tr>
                                <th>Messages postés</th>
                                <td>{{ user.posts|length }}</td>
                            </tr>
                            <tr>
                                <th>Personnages</th>
                                <td>{{ user.characters|length }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Danger Zone
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur? Cette action est irréversible.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn btn-danger">
                    <i class="bi bi-trash"></i> Supprimer l'utilisateur
                </button>
            </form>
        </div>
    </div>

    <div class="d-grid gap-2 mt-3">
        <form method="post" action="{{ path('admin_user_toggle_faction_permission', {'id': user.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_faction_permission' ~ user.id) }}">
            <button type="submit" class="btn btn-{{ user.canCreateFaction ? 'danger' : 'success' }} w-100">
                {% if user.canCreateFaction %}
                    <i class="bi bi-x-circle-fill"></i> Retirer la permission de créer une faction
                {% else %}
                    <i class="bi bi-check-circle-fill"></i> Donner la permission de créer une faction
                {% endif %}
            </button>
        </form>
        
        <form method="post" action="{{ path('admin_user_toggle_rp_forum_permission', {'id': user.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('toggle_rp_forum_permission' ~ user.id) }}">
            <button type="submit" class="btn btn-{{ user.canCreateRpForum ? 'danger' : 'success' }} w-100">
                {% if user.canCreateRpForum %}
                    <i class="bi bi-x-circle-fill"></i> Retirer la permission de créer un forum RP
                {% else %}
                    <i class="bi bi-check-circle-fill"></i> Donner la permission de créer un forum RP
                {% endif %}
            </button>
        </form>
    </div>
{% endblock %}