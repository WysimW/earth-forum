{% extends 'admin/base.html.twig' %}

{% block title %}Changer Mot de Passe | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Changer le mot de passe</h1>
        <div>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-info"><i class="bi bi-eye"></i> Voir détails</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-key"></i> Changer le mot de passe pour {{ user.pseudo }}
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.password) }}
                            {{ form_widget(form.password) }}
                            {{ form_errors(form.password) }}
                            <div class="form-text">Entrez le nouveau mot de passe.</div>
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.confirmPassword) }}
                            {{ form_widget(form.confirmPassword) }}
                            {{ form_errors(form.confirmPassword) }}
                            <div class="form-text">Confirmez le nouveau mot de passe.</div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Cette action va immédiatement changer le mot de passe de l'utilisateur.
                        </div>

                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Mettre à jour le mot de passe</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}