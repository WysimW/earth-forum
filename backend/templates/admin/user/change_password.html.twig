{% extends 'admin/base.html.twig' %}

{% block title %}Changer Mot de Passe | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Changer le mot de passe</h1>
        <div>
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-info"><i class="bi bi-eye"></i> Voir détails</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-header bg-primary text-white">
            Modification du mot de passe pour {{ user.pseudo }}
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password) }}
                    {{ form_errors(form.password) }}
                    <div class="form-text">Choisissez un mot de passe fort combinant lettres, chiffres et caractères spéciaux.</div>
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.confirmPassword) }}
                    {{ form_widget(form.confirmPassword) }}
                    {{ form_errors(form.confirmPassword) }}
                    <div class="form-text">Répétez le même mot de passe pour confirmation.</div>
                </div>
                
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> La modification du mot de passe déconnectera l'utilisateur de toutes ses sessions actives.
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer le nouveau mot de passe</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}