{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Utilisateurs | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des utilisateurs</h1>
        <a href="{{ path('admin_user_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouvel utilisateur</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Avatar</th>
                            <th>Pseudo</th>
                            <th>Email</th>
                            <th>Rôles</th>
                            <th>Inscription</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>
                                    {% if user.avatar %}
                                        <img src="{{ user.avatar }}" alt="{{ user.pseudo }}" class="rounded-circle" width="40" height="40">
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="bi bi-person"></i></span>
                                    {% endif %}
                                </td>
                                <td>{{ user.pseudo }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% for role in user.playerRoles %}
                                        <span class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Aucun</span>
                                    {% endfor %}
                                </td>
                                <td>{{ user.createdAt ? user.createdAt|date('d/m/Y') : '' }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <a href="{{ path('admin_user_change_password', {'id': user.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-key"></i></a>
                                        <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">Aucun utilisateur trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}