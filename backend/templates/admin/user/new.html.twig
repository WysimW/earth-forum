{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel Utilisateur | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Créer un nouvel utilisateur</h1>
        <a href="{{ path('admin_user_index') }}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.pseudo) }}
                    {{ form_widget(form.pseudo) }}
                    {{ form_errors(form.pseudo) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.password) }}
                    {{ form_widget(form.password) }}
                    {{ form_errors(form.password) }}
                    <div class="form-text">Choisissez un mot de passe solide.</div>
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.avatar) }}
                    {{ form_widget(form.avatar) }}
                    {{ form_errors(form.avatar) }}
                    <div class="form-text">URL d'une image à utiliser comme avatar.</div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Rôles</label>
                    <div class="card">
                        <div class="card-body">
                            {{ form_widget(form.playerRoles) }}
                            {{ form_errors(form.playerRoles) }}
                        </div>
                    </div>
                </div>

                {% if form.roles is defined %}
                <div class="mb-3">
                    <label class="form-label">Rôles système</label>
                    <div class="card">
                        <div class="card-body">
                            {{ form_widget(form.roles) }}
                            {{ form_errors(form.roles) }}
                            <div class="form-text">Ces rôles déterminent les permissions de l'utilisateur sur le forum.</div>
                        </div>
                    </div>
                </div>
                {% endif %}

                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}