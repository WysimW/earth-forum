{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard Admin | Earth Forum{% endblock %}

{% block body %}
    <h1 class="mb-4">Tableau de bord administratif</h1>
    
    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-people fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Utilisateurs</h5>
                            <p class="card-text fs-2">{{ userCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_user_index') }}" class="text-white text-decoration-none">
                        <small>Voir tous les utilisateurs <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-diagram-3 fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Forums</h5>
                            <p class="card-text fs-2">{{ forumCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_forum_index') }}" class="text-white text-decoration-none">
                        <small>Voir tous les forums <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chat-dots fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Threads</h5>
                            <p class="card-text fs-2">{{ threadCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_thread_index') }}" class="text-white text-decoration-none">
                        <small>Voir tous les threads <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chat-left-text fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Messages</h5>
                            <p class="card-text fs-2">{{ postCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <small>Messages totaux</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques du Roleplay -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-purple" style="background-color: #6f42c1;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-badge fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Personnages</h5>
                            <p class="card-text fs-2">{{ characterCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_character_index') }}" class="text-white text-decoration-none">
                        <small>Voir tous les personnages <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-teal" style="background-color: #20c997;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-geo-alt fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Lieux</h5>
                            <p class="card-text fs-2">{{ locationCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_location_index') }}" class="text-white text-decoration-none">
                        <small>Voir tous les lieux <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-white bg-indigo" style="background-color: #6610f2;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-arrows-angle-contract fs-1 me-3"></i>
                        <div>
                            <h5 class="card-title">Relations</h5>
                            <p class="card-text fs-2">{{ relationCount }}</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-top-0 text-white">
                    <a href="{{ path('admin_character_relation_index') }}" class="text-white text-decoration-none">
                        <small>Voir toutes les relations <i class="bi bi-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Sections d'activité récente -->
    <div class="row">
        <!-- Derniers utilisateurs -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person-plus-fill me-2"></i> Derniers utilisateurs inscrits
                </div>
                <div class="card-body">
                    {% if latestUsers|length > 0 %}
                        <div class="list-group">
                            {% for user in latestUsers %}
                                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        {% if user.avatar %}
                                            <img src="{{ user.avatar }}" class="rounded-circle me-3" width="40" height="40" alt="{{ user.pseudo }}">
                                        {% else %}
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        {% endif %}
                                        <div>
                                            <h6 class="mb-0">{{ user.pseudo }}</h6>
                                            <small class="text-muted">{{ user.email }}</small>
                                        </div>
                                    </div>
                                    <span class="text-muted small">{{ user.createdAt|date('d/m/Y') }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucun utilisateur inscrit récemment.</div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <a href="{{ path('admin_user_index') }}" class="btn btn-sm btn-outline-primary">Voir tous les utilisateurs</a>
                </div>
            </div>
        </div>
        
        <!-- Derniers threads -->
        <div class="col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-chat-dots me-2"></i> Derniers threads créés
                </div>
                <div class="card-body">
                    {% if latestThreads|length > 0 %}
                        <div class="list-group">
                            {% for thread in latestThreads %}
                                <a href="{{ path('admin_thread_show', {'id': thread.id}) }}" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">
                                            {% if thread.sticky %}
                                                <span class="badge bg-info me-1" title="Thread épinglé"><i class="bi bi-pin"></i></span>
                                            {% endif %}
                                            {{ thread.title }}
                                        </h6>
                                        <small>{{ thread.createdAt|date('d/m/Y') }}</small>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex gap-2 align-items-center">
                                            <small class="text-muted">
                                                {% if thread.type == 'normal' %}
                                                    <span class="badge bg-secondary">Normal</span>
                                                {% elseif thread.type == 'roleplay' %}
                                                    <span class="badge bg-primary">Roleplay</span>
                                                {% elseif thread.type == 'announcement' %}
                                                    <span class="badge bg-warning">Annonce</span>
                                                {% elseif thread.type == 'character_sheet' %}
                                                    <span class="badge bg-info">Fiche personnage</span>
                                                {% endif %}
                                            </small>
                                            <small class="text-muted">Dans <strong>{{ thread.forum.name }}</strong></small>
                                        </div>
                                        <small class="text-muted">
                                            Par {{ thread.author ? thread.author.pseudo : 'Anonyme' }}
                                        </small>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucun thread créé récemment.</div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <a href="{{ path('admin_thread_index') }}" class="btn btn-sm btn-outline-info">Voir tous les threads</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Derniers personnages créés -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-purple text-white" style="background-color: #6f42c1;">
                    <i class="bi bi-person-badge me-2"></i> Derniers personnages créés
                </div>
                <div class="card-body">
                    {% if latestCharacters|length > 0 %}
                        <div class="row">
                            {% for character in latestCharacters %}
                                <div class="col-md-3 mb-3">
                                    <div class="card h-100">
                                        <div class="card-header">
                                            <h6 class="mb-0">{{ character.name }}</h6>
                                        </div>
                                        <div class="card-body text-center">
                                            {% if character.avatar %}
                                                <img src="{{ character.avatar }}" alt="{{ character.name }}" class="rounded-circle mb-2" style="width: 80px; height: 80px; object-fit: cover;">
                                            {% else %}
                                                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 80px; height: 80px;">
                                                    <i class="bi bi-person-fill fs-3"></i>
                                                </div>
                                            {% endif %}
                                            <p class="small text-muted mb-1">
                                                {{ character.user ? 'Par ' ~ character.user.pseudo : 'Sans joueur' }}
                                            </p>
                                            <div class="mt-2">
                                                <a href="{{ path('admin_character_show', {'id': character.id}) }}" class="btn btn-sm btn-outline-primary">Voir détails</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Aucun personnage créé récemment.</div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <a href="{{ path('admin_character_index') }}" class="btn btn-sm btn-outline-purple" style="border-color: #6f42c1; color: #6f42c1;">Voir tous les personnages</a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Raccourcis d'administration -->
    <div class="card mb-4">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-lightning-fill me-2"></i> Actions rapides
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_user_new') }}" class="btn btn-success w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                        <i class="bi bi-person-plus fs-1 mb-2"></i>
                        <span>Nouvel utilisateur</span>
                    </a>
                </div>
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_character_new') }}" class="btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" style="background-color: #6f42c1; color: white;">
                        <i class="bi bi-person-badge fs-1 mb-2"></i>
                        <span>Nouveau personnage</span>
                    </a>
                </div>
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_category_new') }}" class="btn btn-primary w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                        <i class="bi bi-tags fs-1 mb-2"></i>
                        <span>Nouvelle catégorie</span>
                    </a>
                </div>
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_forum_new') }}" class="btn btn-info w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                        <i class="bi bi-diagram-3 fs-1 mb-2"></i>
                        <span>Nouveau forum</span>
                    </a>
                </div>
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_role_new') }}" class="btn btn-warning w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3">
                        <i class="bi bi-person-badge fs-1 mb-2"></i>
                        <span>Nouveau rôle</span>
                    </a>
                </div>
                <div class="col-md-2 mb-3">
                    <a href="{{ path('admin_location_new') }}" class="btn w-100 h-100 d-flex flex-column align-items-center justify-content-center p-3" style="background-color: #20c997; color: white;">
                        <i class="bi bi-geo-alt fs-1 mb-2"></i>
                        <span>Nouveau lieu</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}