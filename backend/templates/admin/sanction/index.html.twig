{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des sanctions{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2">
            <i class="fas fa-shield-alt me-2"></i>
            Gestion des sanctions
        </h1>
        <a href="{{ path('app_admin_sanctions_new') }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>
            Nouvelle sanction
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h3 class="h5 mb-0">Filtres</h3>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('app_admin_sanctions_index') }}" class="row g-3">
                <div class="col-md-3">
                    <label for="status" class="form-label">Statut</label>
                    <select id="status" name="status" class="form-select">
                        <option value="active" {% if status == 'active' %}selected{% endif %}>Actives</option>
                        <option value="expired" {% if status == 'expired' %}selected{% endif %}>Expirées</option>
                        <option value="revoked" {% if status == 'revoked' %}selected{% endif %}>Révoquées</option>
                        <option value="inactive" {% if status == 'inactive' %}selected{% endif %}>Inactives</option>
                        <option value="all" {% if status == 'all' %}selected{% endif %}>Toutes</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="type" class="form-label">Type</label>
                    <select id="type" name="type" class="form-select">
                        <option value="">Tous les types</option>
                        {% for label, value in typeChoices %}
                            <option value="{{ value }}" {% if type == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="user" class="form-label">Utilisateur (ID)</label>
                    <input type="number" class="form-control" id="user" name="user" value="{{ userId > 0 ? userId : '' }}">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>
                        Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0">Liste des sanctions ({{ totalCount }})</h3>
            <span class="badge bg-secondary">Page {{ page }} / {{ (totalCount / limit)|round(0, 'ceil') }}</span>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Utilisateur</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Expiration</th>
                        <th>Statut</th>
                        <th>Modérateur</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sanction in sanctions %}
                        <tr>
                            <td>{{ sanction.id }}</td>
                            <td>
                                <a href="{{ path('app_admin_user_sanctions', {'id': sanction.user.id}) }}">
                                    {{ sanction.user.pseudo }}
                                </a>
                            </td>
                            <td>
                                <span class="badge {{ sanction.type == 'full_ban' ? 'bg-danger' : 'bg-warning' }}">
                                    {{ sanction.typeLabel }}
                                </span>
                            </td>
                            <td>{{ sanction.createdAt|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if sanction.expiresAt %}
                                    {{ sanction.expiresAt|date('d/m/Y H:i') }}
                                {% else %}
                                    <span class="badge bg-danger">Permanent</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if sanction.status == 'active' %}
                                    <span class="badge bg-success">Active</span>
                                {% elseif sanction.status == 'expired' %}
                                    <span class="badge bg-secondary">Expirée</span>
                                {% elseif sanction.status == 'revoked' %}
                                    <span class="badge bg-info">Révoquée</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactive</span>
                                {% endif %}
                            </td>
                            <td>{{ sanction.moderator.pseudo }}</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_admin_sanctions_show', {'id': sanction.id}) }}" class="btn btn-sm btn-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    {% if sanction.status == 'active' %}
                                        <a href="{{ path('app_admin_sanctions_revoke', {'id': sanction.id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-ban"></i>
                                        </a>
                                        {% if sanction.expiresAt %}
                                            <a href="{{ path('app_admin_sanctions_extend', {'id': sanction.id}) }}" class="btn btn-sm btn-danger">
                                                <i class="fas fa-clock"></i>
                                            </a>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">Aucune sanction trouvée</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if totalCount > limit %}
            <div class="card-footer">
                <div class="d-flex justify-content-center">
                    <nav aria-label="Pagination des sanctions">
                        <ul class="pagination mb-0">
                            {% set pages = (totalCount / limit)|round(0, 'ceil') %}
                            {% for p in 1..pages %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('app_admin_sanctions_index', {'page': p, 'limit': limit, 'status': status, 'type': type, 'user': userId}) }}">
                                        {{ p }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %} 