{% extends 'admin/base.html.twig' %}

{% block title %}Détails de la relation | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails de la relation</h1>
        <div>
            <a href="{{ path('admin_character_relation_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_character_relation_edit', {'id': character_relation.id}) }}" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-indigo text-white" style="background-color: #6610f2;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-diagram-3 me-2"></i> Informations générales</span>
                        <span class="badge rounded-pill bg-light text-dark">ID: {{ character_relation.id }}</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="relation-diagram">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="text-center">
                                    {% if character_relation.sourceCharacter.avatar %}
                                        <img src="{{ character_relation.sourceCharacter.avatar }}" alt="{{ character_relation.sourceCharacter.name }}" class="rounded-circle mb-2" width="70" height="70" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 70px; height: 70px;">
                                            <i class="bi bi-person-fill fs-4"></i>
                                        </div>
                                    {% endif %}
                                    <a href="{{ path('admin_character_show', {'id': character_relation.sourceCharacter.id}) }}" class="d-block">
                                        {{ character_relation.sourceCharacter.name }}
                                    </a>
                                </div>
                                <div class="relation-arrow mx-2 text-center">
                                    <div class="bg-indigo text-white rounded px-2 py-1 mb-2" style="background-color: #6610f2;">
                                        <strong>{{ character_relation.type }}</strong>
                                        {% if character_relation.intensity %}
                                            <div class="progress mt-1" style="height: 5px;">
                                                <div class="progress-bar bg-warning" role="progressbar" 
                                                    style="width: {{ (character_relation.intensity / 5) * 100 }}%;" 
                                                    aria-valuenow="{{ character_relation.intensity }}" 
                                                    aria-valuemin="0" 
                                                    aria-valuemax="5"></div>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <i class="bi bi-arrow-right fs-4"></i>
                                </div>
                                <div class="text-center">
                                    {% if character_relation.targetCharacter.avatar %}
                                        <img src="{{ character_relation.targetCharacter.avatar }}" alt="{{ character_relation.targetCharacter.name }}" class="rounded-circle mb-2" width="70" height="70" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 70px; height: 70px;">
                                            <i class="bi bi-person-fill fs-4"></i>
                                        </div>
                                    {% endif %}
                                    <a href="{{ path('admin_character_show', {'id': character_relation.targetCharacter.id}) }}" class="d-block">
                                        {{ character_relation.targetCharacter.name }}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="130">Type</th>
                                <td>{{ character_relation.type }}</td>
                            </tr>
                            <tr>
                                <th>Intensité</th>
                                <td>
                                    {% if character_relation.intensity %}
                                        <div class="d-flex align-items-center">
                                            <span class="me-2">{{ character_relation.intensity }}/5</span>
                                            <div class="progress flex-grow-1" style="height: 10px;">
                                                <div class="progress-bar bg-indigo" role="progressbar" 
                                                    style="width: {{ (character_relation.intensity / 5) * 100 }}%; background-color: #6610f2;" 
                                                    aria-valuenow="{{ character_relation.intensity }}" 
                                                    aria-valuemin="0" 
                                                    aria-valuemax="5"></div>
                                            </div>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">Non définie</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Visibilité</th>
                                <td>
                                    {% if character_relation.isPublic %}
                                        <span class="badge bg-success">Publique</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Privée</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Date de création</th>
                                <td>{{ character_relation.createdAt|date('d/m/Y') }}</td>
                            </tr>
                            <tr>
                                <th>Dernière mise à jour</th>
                                <td>{{ character_relation.updatedAt ? character_relation.updatedAt|date('d/m/Y') : 'Jamais' }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <form method="post" action="{{ path('admin_character_relation_delete', {'id': character_relation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette relation? Cette action est irréversible.');" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character_relation.id) }}">
                        <button class="btn btn-danger w-100"><i class="bi bi-trash"></i> Supprimer cette relation</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-indigo text-white" style="background-color: #6610f2;">
                    <i class="bi bi-card-text me-2"></i> Description de la relation
                </div>
                <div class="card-body">
                    {% if character_relation.description %}
                        <div class="relation-description">
                            {{ character_relation.description|raw }}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Cette relation n'a pas de description.</div>
                    {% endif %}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header bg-purple text-white" style="background-color: #6f42c1;">
                            <i class="bi bi-person me-2"></i> Personnage source
                        </div>
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="me-3">
                                    {% if character_relation.sourceCharacter.avatar %}
                                        <img src="{{ character_relation.sourceCharacter.avatar }}" alt="{{ character_relation.sourceCharacter.name }}" class="rounded-circle" width="100" height="100" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                            <i class="bi bi-person-fill fs-1"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div>
                                    <h5 class="mb-1">{{ character_relation.sourceCharacter.name }}</h5>
                                    <p class="text-muted mb-2">
                                        {% if character_relation.sourceCharacter.user %}
                                            Joué par {{ character_relation.sourceCharacter.user.pseudo }}
                                        {% else %}
                                            Sans joueur
                                        {% endif %}
                                    </p>
                                    <a href="{{ path('admin_character_show', {'id': character_relation.sourceCharacter.id}) }}" class="btn btn-sm btn-outline-primary">
                                        Voir le profil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header bg-teal text-white" style="background-color: #20c997;">
                            <i class="bi bi-person me-2"></i> Personnage cible
                        </div>
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="me-3">
                                    {% if character_relation.targetCharacter.avatar %}
                                        <img src="{{ character_relation.targetCharacter.avatar }}" alt="{{ character_relation.targetCharacter.name }}" class="rounded-circle" width="100" height="100" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                                            <i class="bi bi-person-fill fs-1"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div>
                                    <h5 class="mb-1">{{ character_relation.targetCharacter.name }}</h5>
                                    <p class="text-muted mb-2">
                                        {% if character_relation.targetCharacter.user %}
                                            Joué par {{ character_relation.targetCharacter.user.pseudo }}
                                        {% else %}
                                            Sans joueur
                                        {% endif %}
                                    </p>
                                    <a href="{{ path('admin_character_show', {'id': character_relation.targetCharacter.id}) }}" class="btn btn-sm btn-outline-primary">
                                        Voir le profil
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}