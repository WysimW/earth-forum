{% extends 'admin/base.html.twig' %}

{% block title %}Relations entre personnages | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Relations entre personnages</h1>
        <a href="{{ path('admin_character_relation_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouvelle relation</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Personnage source</th>
                            <th>Relation</th>
                            <th>Personnage cible</th>
                            <th>Intensité</th>
                            <th>Visibilité</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for relation in character_relations %}
                            <tr>
                                <td>{{ relation.id }}</td>
                                <td>{{ relation.type }}</td>
                                <td>
                                    <a href="{{ path('admin_character_show', {'id': relation.sourceCharacter.id}) }}" class="d-flex align-items-center">
                                        {% if relation.sourceCharacter.avatar %}
                                            <img src="{{ relation.sourceCharacter.avatar }}" class="rounded-circle me-2" width="30" height="30" style="object-fit: cover;">
                                        {% else %}
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        {% endif %}
                                        {{ relation.sourceCharacter.name }}
                                    </a>
                                </td>
                                <td>
                                    <i class="bi bi-arrow-right text-indigo" style="color: #6610f2;"></i>
                                </td>
                                <td>
                                    <a href="{{ path('admin_character_show', {'id': relation.targetCharacter.id}) }}" class="d-flex align-items-center">
                                        {% if relation.targetCharacter.avatar %}
                                            <img src="{{ relation.targetCharacter.avatar }}" class="rounded-circle me-2" width="30" height="30" style="object-fit: cover;">
                                        {% else %}
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2" style="width: 30px; height: 30px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        {% endif %}
                                        {{ relation.targetCharacter.name }}
                                    </a>
                                </td>
                                <td>
                                    {% if relation.intensity %}
                                        <div class="progress" style="height: 10px;" title="Intensité: {{ relation.intensity }}/5">
                                            <div class="progress-bar bg-indigo" role="progressbar" 
                                                style="width: {{ (relation.intensity / 5) * 100 }}%; background-color: #6610f2;" 
                                                aria-valuenow="{{ relation.intensity }}" 
                                                aria-valuemin="0" 
                                                aria-valuemax="5"></div>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if relation.isPublic %}
                                        <span class="badge bg-success">Publique</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Privée</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_character_relation_show', {'id': relation.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_character_relation_edit', {'id': relation.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_character_relation_delete', {'id': relation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette relation?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ relation.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8">Aucune relation trouvée</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}