{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Personnages | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des personnages</h1>
        <a href="{{ path('admin_character_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau personnage</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Avatar</th>
                            <th>Nom</th>
                            <th>Joueur</th>
                            <th>Âge</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for character in characters %}
                            <tr>
                                <td>{{ character.id }}</td>
                                <td>
                                    {% if character.avatar %}
                                        <img src="{{ character.avatar }}" alt="{{ character.name }}" class="rounded-circle" width="40" height="40" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ character.name }}</td>
                                <td>
                                    {% if character.user %}
                                        <a href="{{ path('admin_user_show', {'id': character.user.id}) }}">
                                            {{ character.user.pseudo }}
                                        </a>
                                    {% else %}
                                        <span class="badge bg-secondary">Sans joueur</span>
                                    {% endif %}
                                </td>
                                <td>{{ character.age ?: '-' }}</td>
                                <td>
                                    {% if character.status == 'active' %}
                                        <span class="badge bg-success">Actif</span>
                                    {% elseif character.status == 'inactive' %}
                                        <span class="badge bg-secondary">Inactif</span>
                                    {% elseif character.status == 'dead' %}
                                        <span class="badge bg-danger">Décédé</span>
                                    {% else %}
                                        <span class="badge bg-info">{{ character.status }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ character.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_character_show', {'id': character.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_character_edit', {'id': character.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8">Aucun personnage trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}