{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Personnages{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des Personnages</h1>
        <a href="{{ path('admin_character_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Créer un personnage
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Univers</th>
                            <th>Propriétaire</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for character in characters %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if character.avatar %}
                                            <img src="{{ character.avatar }}" alt="{{ character.name }}" class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        {% endif %}
                                        {{ character.name }}
                                    </div>
                                </td>
                                <td>
                                    {% if character.universe %}
                                        <span class="badge bg-primary">{{ character.universe.name }}</span>
                                    {% else %}
                                        <span class="text-muted">Aucun</span>
                                    {% endif %}
                                </td>
                                <td>{{ character.user.pseudo }}</td>
                                <td>
                                    <span class="status-badge status-{{ character.status }}">
                                        {% if character.status == 'draft' %}
                                            Brouillon
                                        {% elseif character.status == 'pending' %}
                                            En attente
                                        {% elseif character.status == 'validated' %}
                                            Validé
                                        {% elseif character.status == 'rejected' %}
                                            Refusé
                                        {% elseif character.status == 'abandoned' %}
                                            Abandonné
                                        {% elseif character.status == 'editing' %}
                                            En édition
                                        {% endif %}
                                    </span>
                                </td>
                                <td>{{ character.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('admin_character_show', {'id': character.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_character_edit', {'id': character.id}) }}" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        {% if character.status == 'pending' %}
                                            <form method="post" action="{{ path('admin_character_validate', {'id': character.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ character.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal{{ character.id }}">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        {% endif %}
                                    </div>

                                    <!-- Modal de rejet -->
                                    <div class="modal fade" id="rejectModal{{ character.id }}" tabindex="-1" aria-labelledby="rejectModalLabel{{ character.id }}" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="rejectModalLabel{{ character.id }}">Rejeter le personnage</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form method="post" action="{{ path('admin_character_reject', {'id': character.id}) }}">
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label for="rejection_reason" class="form-label">Raison du rejet</label>
                                                            <textarea class="form-control" id="rejection_reason" name="rejection_reason" rows="3" required></textarea>
                                                        </div>
                                                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ character.id) }}">
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                        <button type="submit" class="btn btn-danger">Rejeter</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">Aucun personnage trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}