{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau Personnage | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Créer un nouveau personnage</h1>
        <a href="{{ path('admin_character_index') }}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% include 'admin/character/_form.html.twig' with {'button_label': 'Créer'} %}
{% endblock %}