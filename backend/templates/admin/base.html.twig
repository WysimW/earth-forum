<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Admin - Earth Forum{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
        <link rel="stylesheet" href="{{ asset('css/components/variables.css') }}">
        <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <!-- Sidebar -->
                <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-dark">
                    <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                        <a href="{{ path('admin_dashboard') }}" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                            <span class="fs-5 d-none d-sm-inline">Earth Forum Admin</span>
                        </a>

                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                            <li class="nav-item">
                                <a href="{{ path('admin_dashboard') }}" class="nav-link align-middle px-0 text-white">
                                    <i class="bi bi-speedometer2"></i> <span class="ms-1 d-none d-sm-inline">Dashboard</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_user_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-people"></i> <span class="ms-1 d-none d-sm-inline">Utilisateurs</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_admin_sanctions_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-shield-exclamation"></i> <span class="ms-1 d-none d-sm-inline">Sanctions</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_category_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-tags"></i> <span class="ms-1 d-none d-sm-inline">Catégories</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_forum_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-card-list"></i> <span class="ms-1 d-none d-sm-inline">Forums</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_thread_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-chat-dots"></i> <span class="ms-1 d-none d-sm-inline">Threads</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_role_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-person-badge"></i> <span class="ms-1 d-none d-sm-inline">Rôles</span>
                                </a>
                            </li>
                            <!-- Ajout du menu Roleplay -->
                            <li class="mt-3">
                                <span class="fs-6 d-none d-sm-inline text-muted">Roleplay</span>
                            </li>
                            <li>
                                <a href="{{ path('admin_character_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-person-badge-fill"></i> <span class="ms-1 d-none d-sm-inline">Personnages</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_location_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-geo-alt"></i> <span class="ms-1 d-none d-sm-inline">Lieux</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_character_relation_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-arrows-angle-contract"></i> <span class="ms-1 d-none d-sm-inline">Relations</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_admin_npc_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-robot"></i> <span class="ms-1 d-none d-sm-inline">PNJ</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_univers_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-globe"></i> <span class="ms-1 d-none d-sm-inline">Univers</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_elseworld_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-globe-americas"></i> <span class="ms-1 d-none d-sm-inline">Elseworlds</span>
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('admin_faction_index') }}" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-people-fill"></i> <span class="ms-1 d-none d-sm-inline">Factions</span>
                                </a>
                            </li>
                            <li class="mt-3">
                                <a href="/" class="nav-link px-0 align-middle text-white">
                                    <i class="bi bi-box-arrow-right"></i> <span class="ms-1 d-none d-sm-inline">Retour au site</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- Contenu Principal -->
                <div class="col py-3">
                    <div class="container-fluid">
                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>
        
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>