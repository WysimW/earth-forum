{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Forums | Earth Forum{% endblock %}

{% block body %}
    {# Debug - Univers disponibles #}
    {% if app.debug %}
        <div class="alert alert-info small mb-3">
            <strong>Debug:</strong> Nombre d'univers disponibles: {{ universes is defined ? universes|length : 'Non défini' }}
            {% if universesInfo is defined %}
                <hr>
                <strong>Univers détails:</strong> {{ universesInfo|json_encode(constant('JSON_PRETTY_PRINT')) }}
                <hr>
                <strong>URL bulk action:</strong> {{ bulkActionUrl }}
            {% endif %}
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des forums</h1>
        <div>
            <a href="{{ path('admin_forum_by_universe') }}" class="btn btn-info me-2">
                <i class="bi bi-globe"></i> Vue par univers
            </a>
            <a href="{{ path('admin_forum_positions') }}" class="btn btn-primary me-2">
                <i class="bi bi-arrows-move"></i> Gérer les positions
            </a>
            <a href="{{ path('admin_forum_new') }}" class="btn btn-success">
                <i class="bi bi-plus"></i> Nouveau forum
            </a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Résumé des statistiques -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Forums</h6>
                            <h2 class="mb-0">{{ forums|length }}</h2>
                        </div>
                        <div>
                            <i class="fas fa-list-alt fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-white" style="background-color: #6f42c1;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Forums RP</h6>
                            <h2 class="mb-0">
                                {% set rpCount = 0 %}
                                {% for forum in forums %}
                                    {% if forum.isRoleplay() %}
                                        {% set rpCount = rpCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ rpCount }}
                            </h2>
                        </div>
                        <div>
                            <i class="fas fa-dice-d20 fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-white" style="background-color: #20c997;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Forums HRP</h6>
                            <h2 class="mb-0">
                                {% set hrpCount = 0 %}
                                {% for forum in forums %}
                                    {% if forum.isHrp() %}
                                        {% set hrpCount = hrpCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ hrpCount }}
                            </h2>
                        </div>
                        <div>
                            <i class="fas fa-comments fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Forums Importants</h6>
                            <h2 class="mb-0">
                                {% set importantCount = 0 %}
                                {% for forum in forums %}
                                    {% if forum.isImportant() %}
                                        {% set importantCount = importantCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ importantCount }}
                            </h2>
                        </div>
                        <div>
                            <i class="fas fa-thumbtack fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-filter"></i> Filtres</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8 mb-3">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary filter-btn active" data-filter="all">Tous</button>
                        <button type="button" class="btn btn-outline-primary filter-btn" data-filter="rp">RP</button>
                        <button type="button" class="btn btn-outline-success filter-btn" data-filter="hrp">HRP</button>
                        <button type="button" class="btn btn-outline-warning filter-btn" data-filter="important">Important</button>
                        <button type="button" class="btn btn-outline-info filter-btn" data-filter="univers">Univers</button>
                        <button type="button" class="btn btn-outline-dark filter-btn" data-filter="elseworld">Elseworld</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <input type="text" id="forum-search" class="form-control" placeholder="Rechercher un forum...">
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="forumsTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Type</th>
                            <th>Parent/Univers</th>
                            <th>Statistiques</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for forum in forums %}
                            <tr class="forum-row" 
                                data-type="{% if forum.isRoleplay() %}rp{% elseif forum.isHrp() %}hrp{% elseif forum.isImportant() %}important{% endif %}" 
                                data-universe="{{ forum.universe ? 'univers' : '' }}" 
                                data-elseworld="{{ forum.elseworld ? 'elseworld' : '' }}">
                                <td>{{ forum.id }}</td>
                                <td>
                                    <strong>{{ forum.name }}</strong>
                                    {% if forum.elseworld %}
                                        <span class="badge bg-info ms-1">Elseworld</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">{{ forum.description|slice(0, 100) }}{% if forum.description|length > 100 %}...{% endif %}</td>
                                <td>
                                    {% if forum.isRoleplay() %}
                                        <span class="badge bg-primary">RP</span>
                                    {% elseif forum.isHrp() %}
                                        <span class="badge" style="background-color: #20c997;">HRP</span>
                                    {% elseif forum.isImportant() %}
                                        <span class="badge bg-warning">Important</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if forum.category %}
                                        <span class="badge bg-secondary">{{ forum.category.name }}</span>
                                    {% endif %}
                                    
                                    {% if forum.universe %}
                                        <span class="badge bg-purple">{{ forum.universe.name }}</span>
                                    {% endif %}
                                    
                                    {% if forum.elseworld %}
                                        <span class="badge bg-info">{{ forum.elseworld.name }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex">
                                        <span class="badge bg-secondary me-1" title="Sujets">
                                            <i class="far fa-comment"></i> {{ forum.threads|length }}
                                        </span>
                                        {% if forum.subforums is defined %}
                                            <span class="badge bg-dark" title="Sous-forums">
                                                <i class="far fa-folder-open"></i> {{ forum.subforums|length }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_forum_show', {'id': forum.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_forum_edit', {'id': forum.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_forum_delete', {'id': forum.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce forum?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forum.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8">Aucun forum trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Filtrage des forums
        const filterButtons = document.querySelectorAll('.filter-btn');
        const searchInput = document.getElementById('forum-search');
        const forumRows = document.querySelectorAll('.forum-row');
        
        // Fonction pour filtrer les forums
        function filterForums() {
            const activeFilter = document.querySelector('.filter-btn.active').dataset.filter;
            const searchText = searchInput.value.toLowerCase();
            
            forumRows.forEach(row => {
                const rowType = row.dataset.type;
                const rowUniverse = row.dataset.universe;
                const rowElseworld = row.dataset.elseworld;
                const rowText = row.textContent.toLowerCase();
                
                // Filtre par type
                let showByType = activeFilter === 'all' || 
                                (activeFilter === 'rp' && rowType === 'rp') ||
                                (activeFilter === 'hrp' && rowType === 'hrp') ||
                                (activeFilter === 'important' && rowType === 'important') ||
                                (activeFilter === 'univers' && rowUniverse === 'univers') ||
                                (activeFilter === 'elseworld' && rowElseworld === 'elseworld');
                
                // Recherche textuelle
                let showBySearch = searchText === '' || rowText.includes(searchText);
                
                // Afficher/cacher la ligne
                row.style.display = (showByType && showBySearch) ? '' : 'none';
            });
        }
        
        // Écouteurs d'événements pour les filtres
        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                filterButtons.forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                filterForums();
            });
        });
        
        searchInput.addEventListener('input', filterForums);
    });
</script>
{% endblock %}