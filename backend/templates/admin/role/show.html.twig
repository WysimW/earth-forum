{% extends 'admin/base.html.twig' %}

{% block title %}Détails Rôle | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails du rôle</h1>
        <div>
            <a href="{{ path('admin_role_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Informations du rôle
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="150">ID</th>
                                <td>{{ role.id }}</td>
                            </tr>
                            <tr>
                                <th>Nom</th>
                                <td>{{ role.name }}</td>
                            </tr>
                            <tr>
                                <th>Couleur</th>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width: 25px; height: 25px; background-color: {{ role.color }}; border-radius: 5px;"></div>
                                        <code>{{ role.color }}</code>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>Aperçu</th>
                                <td>
                                    <span class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span>
                                </td>
                            </tr>
                            <tr>
                                <th>Utilisateurs</th>
                                <td>{{ role.users|length }} utilisateur(s)</td>
                            </tr>
                        </tbody>
                    </table>

                    {% if role.users|length == 0 %}
                        <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rôle?');" class="mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                            <button class="btn btn-danger">
                                <i class="bi bi-trash"></i> Supprimer ce rôle
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card">
                <div class="card-header bg-success text-white">
                    Utilisateurs avec ce rôle ({{ role.users|length }})
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Avatar</th>
                                    <th>Pseudo</th>
                                    <th>Email</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in role.users %}
                                    <tr>
                                        <td>
                                            {% if user.avatar %}
                                                <img src="{{ user.avatar }}" alt="{{ user.pseudo }}" class="rounded-circle" width="30" height="30">
                                            {% else %}
                                                <i class="bi bi-person-circle"></i>
                                            {% endif %}
                                        </td>
                                        <td>{{ user.pseudo }}</td>
                                        <td>{{ user.email }}</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center">Aucun utilisateur n'a ce rôle</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}