{% extends 'admin/base.html.twig' %}

{% block title %}Détails Rôle | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails du rôle</h1>
        <div>
            <a href="{{ path('admin_role_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Informations du rôle
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="150">ID</th>
                                <td>{{ role.id }}</td>
                            </tr>
                            <tr>
                                <th>Nom</th>
                                <td>{{ role.name }}</td>
                            </tr>
                            <tr>
                                <th>Couleur</th>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width: 25px; height: 25px; background-color: {{ role.color }}; border-radius: 5px;"></div>
                                        <code>{{ role.color }}</code>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <th>Aperçu</th>
                                <td>
                                    <span class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span>
                                </td>
                            </tr>
                            <tr>
                                <th>Utilisateurs</th>
                                <td>{{ role.users|length }} utilisateur(s)</td>
                            </tr>
                        </tbody>
                    </table>

                    {% if role.users|length == 0 %}
                        <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rôle?');" class="mt-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                            <button class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer ce rôle</button>
                        </form>
                    {% else %}
                        <div class="alert alert-warning mt-3">
                            <i class="bi bi-exclamation-triangle"></i> Ce rôle ne peut pas être supprimé car il est attribué à un ou plusieurs utilisateurs.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    Utilisateurs avec ce rôle
                </div>
                <div class="card-body">
                    {% if role.users|length > 0 %}
                        <div class="list-group">
                            {% for user in role.users %}
                                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="list-group-item list-group-item-action d-flex align-items-center">
                                    {% if user.avatar %}
                                        <img src="{{ user.avatar }}" class="rounded-circle me-3" width="40" height="40" alt="{{ user.pseudo }}">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    {% endif %}
                                    <div>
                                        <h6 class="mb-0">{{ user.pseudo }}</h6>
                                        <small class="text-muted">{{ user.email }}</small>
                                    </div>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Aucun utilisateur n'a ce rôle.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}