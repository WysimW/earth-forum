{% extends 'admin/base.html.twig' %}

{% block title %}Modifier Rôle | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Modifier le rôle</h1>
        <div>
            <a href="{{ path('admin_role_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-info"><i class="bi bi-eye"></i> Voir détails</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.color) }}
                            {{ form_widget(form.color) }}
                            {{ form_errors(form.color) }}
                            <div class="form-text">Choisissez une couleur pour ce rôle.</div>
                        </div>

                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer les modifications</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Aperçu</div>
                <div class="card-body">
                    <p>Voici un exemple de ce à quoi ressemblera le rôle :</p>
                    <div class="mb-3">
                        <span id="role-preview" class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span>
                    </div>
                    <p class="mb-0">Le texte du nom sera affiché sur la couleur de fond sélectionnée.</p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">Utilisateurs avec ce rôle</div>
                <div class="card-body">
                    {% if role.users|length > 0 %}
                        <p>Ce rôle est attribué à {{ role.users|length }} utilisateur(s).</p>
                        <ul class="list-group">
                            {% for user in role.users|slice(0, 5) %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        {% if user.avatar %}
                                            <img src="{{ user.avatar }}" alt="{{ user.pseudo }}" class="rounded-circle me-2" width="25" height="25">
                                        {% else %}
                                            <i class="bi bi-person-circle me-2"></i>
                                        {% endif %}
                                        {{ user.pseudo }}
                                    </div>
                                    <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                </li>
                            {% endfor %}
                            {% if role.users|length > 5 %}
                                <li class="list-group-item text-center">
                                    <span class="text-muted">{{ role.users|length - 5 }} utilisateur(s) supplémentaire(s)</span>
                                </li>
                            {% endif %}
                        </ul>
                    {% else %}
                        <p class="text-muted">Aucun utilisateur n'a ce rôle.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.querySelector('input[name="role[name]"]');
    const colorInput = document.querySelector('input[name="role[color]"]');
    const preview = document.getElementById('role-preview');
    
    // Update preview on input
    nameInput.addEventListener('input', function() {
        preview.textContent = this.value || 'Nom du rôle';
    });
    
    colorInput.addEventListener('input', function() {
        preview.style.backgroundColor = this.value;
    });
});
</script>
{% endblock %}