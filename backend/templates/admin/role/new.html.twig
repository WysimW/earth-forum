{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau Rôle | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Créer un nouveau rôle</h1>
        <a href="{{ path('admin_role_index') }}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.color) }}
                            {{ form_widget(form.color) }}
                            {{ form_errors(form.color) }}
                            <div class="form-text">Choisissez une couleur pour ce rôle.</div>
                        </div>

                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Aperçu</div>
                <div class="card-body">
                    <p>Voici un exemple de ce à quoi ressemblera le rôle :</p>
                    <div class="mb-3">
                        <span id="role-preview" class="badge bg-primary">Nom du rôle</span>
                    </div>
                    <p class="mb-0">Le texte du nom sera affiché sur la couleur de fond sélectionnée.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const nameInput = document.querySelector('input[name="role[name]"]');
    const colorInput = document.querySelector('input[name="role[color]"]');
    const preview = document.getElementById('role-preview');
    
    // Update preview on load
    if (nameInput.value) {
        preview.textContent = nameInput.value;
    }
    if (colorInput.value) {
        preview.style.backgroundColor = colorInput.value;
    }
    
    // Update preview on input
    nameInput.addEventListener('input', function() {
        preview.textContent = this.value || 'Nom du rôle';
    });
    
    colorInput.addEventListener('input', function() {
        preview.style.backgroundColor = this.value;
    });
});
</script>
{% endblock %}