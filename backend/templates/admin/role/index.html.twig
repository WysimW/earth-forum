{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Rôles | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des rôles</h1>
        <a href="{{ path('admin_role_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau rôle</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Couleur</th>
                            <th>Aperçu</th>
                            <th>Utilisateurs</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for role in roles %}
                            <tr>
                                <td>{{ role.id }}</td>
                                <td>{{ role.name }}</td>
                                <td><code>{{ role.color }}</code></td>
                                <td><span class="badge" style="background-color: {{ role.color }};">{{ role.name }}</span></td>
                                <td>{{ role.users|length }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_role_show', {'id': role.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_role_edit', {'id': role.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_role_delete', {'id': role.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rôle?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ role.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6">Aucun rôle trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}