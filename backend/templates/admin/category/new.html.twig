{% extends 'admin/base.html.twig' %}

{% block title %}Nouvelle Catégorie | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Créer une nouvelle catégorie</h1>
        <a href="{{ path('admin_category_index') }}" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.homeOrder) }}
                    {{ form_widget(form.homeOrder) }}
                    {{ form_errors(form.homeOrder) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type) }}
                    {{ form_errors(form.type) }}
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}