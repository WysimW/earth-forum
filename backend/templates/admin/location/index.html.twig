{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Lieux | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des lieux</h1>
        <a href="{{ path('admin_location_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau lieu</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Nom</th>
                            <th>Lieu parent</th>
                            <th>Univers</th>
                            <th>Personnages présents</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for location in locations %}
                            <tr>
                                <td>{{ location.id }}</td>
                                <td>
                                    {% if location.image %}
                                        <img src="{{ location.image }}" alt="{{ location.name }}" class="rounded" width="50" height="50" style="object-fit: cover;">
                                    {% else %}
                                        <div class="rounded bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-geo-alt"></i>
                                        </div>
                                    {% endif %}
                                </td>
                                <td>{{ location.name }}</td>
                                <td>
                                    {% if location.parent %}
                                        <a href="{{ path('admin_location_show', {'id': location.parent.id}) }}">
                                            {{ location.parent.name }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if location.universe %}
                                        {{ location.universe.name }}
                                    {% else %}
                                        <span class="text-muted">Global</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-teal" style="background-color: #20c997;">
                                        {{ location.characters|length }}
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_location_show', {'id': location.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_location_edit', {'id': location.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_location_delete', {'id': location.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce lieu?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">Aucun lieu trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}