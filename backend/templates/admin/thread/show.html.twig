{% extends 'admin/base.html.twig' %}

{% block title %}Détails Thread | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Détails du thread</h1>
        <div>
            <a href="{{ path('admin_thread_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_thread_edit', {'id': thread.id}) }}" class="btn btn-warning"><i class="bi bi-pencil"></i> Modifier</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            Informations générales
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="150">ID</th>
                                <td>{{ thread.id }}</td>
                            </tr>
                            <tr>
                                <th>Titre</th>
                                <td>{{ thread.title }}</td>
                            </tr>
                            <tr>
                                <th>Forum</th>
                                <td>
                                    <a href="{{ path('admin_forum_show', {'id': thread.forum.id}) }}" class="badge bg-success text-decoration-none">
                                        {{ thread.forum.name }}
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <th>Auteur</th>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if thread.author.avatar %}
                                            <img src="{{ thread.author.avatar }}" alt="{{ thread.author.pseudo }}" class="rounded-circle me-2" width="30" height="30">
                                        {% else %}
                                            <i class="bi bi-person-circle me-2"></i>
                                        {% endif %}
                                        <a href="{{ path('admin_user_show', {'id': thread.author.id}) }}" class="text-decoration-none">
                                            {{ thread.author.pseudo }}
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="150">Date de création</th>
                                <td>{{ thread.createdAt|date('d/m/Y H:i:s') }}</td>
                            </tr>
                            <tr>
                                <th>Dernière mise à jour</th>
                                <td>{{ thread.updatedAt|date('d/m/Y H:i:s') }}</td>
                            </tr>
                            <tr>
                                <th>Nombre de messages</th>
                                <td>{{ thread.posts|length }}</td>
                            </tr>
                            <tr>
                                <th>Statut</th>
                                <td>
                                    {% if thread.posts|length > 0 %}
                                        <span class="badge bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-warning">Sans messages</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {% if thread.posts|length == 0 %}
                <form method="post" action="{{ path('admin_thread_delete', {'id': thread.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce thread?');" class="mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ thread.id) }}">
                    <button class="btn btn-danger">
                        <i class="bi bi-trash"></i> Supprimer ce thread
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center bg-info text-white">
            <span>Messages du thread ({{ thread.posts|length }})</span>
            <a href="#" class="btn btn-sm btn-light"><i class="bi bi-plus-circle"></i> Ajouter un message</a>
        </div>
        <div class="card-body">
            {% if thread.posts|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Auteur</th>
                                <th>Contenu</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for post in thread.posts %}
                                <tr>
                                    <td>{{ post.id }}</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            {% if post.author.avatar %}
                                                <img src="{{ post.author.avatar }}" alt="{{ post.author.pseudo }}" class="rounded-circle me-2" width="25" height="25">
                                            {% else %}
                                                <i class="bi bi-person-circle me-2"></i>
                                            {% endif %}
                                            {{ post.author.pseudo }}
                                        </div>
                                    </td>
                                    <td>{{ post.content|length > 50 ? post.content|slice(0, 50) ~ '...' : post.content }}</td>
                                    <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="#" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                            <a href="#" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                            <a href="#" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i> Ce thread ne contient aucun message.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}