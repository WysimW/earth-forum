{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Threads | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des threads</h1>
        <a href="{{ path('admin_thread_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau thread</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Forum</th>
                            <th>Auteur</th>
                            <th>Messages</th>
                            <th>Date de création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for thread in threads %}
                            <tr>
                                <td>{{ thread.id }}</td>
                                <td>{{ thread.title }}</td>
                                <td>
                                    <span class="badge bg-success">{{ thread.forum.name }}</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if thread.author.avatar %}
                                            <img src="{{ thread.author.avatar }}" alt="{{ thread.author.pseudo }}" class="rounded-circle me-2" width="25" height="25">
                                        {% else %}
                                            <i class="bi bi-person-circle me-2"></i>
                                        {% endif %}
                                        {{ thread.author.pseudo }}
                                    </div>
                                </td>
                                <td>{{ thread.posts|length }}</td>
                                <td>{{ thread.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_thread_show', {'id': thread.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_thread_edit', {'id': thread.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_thread_delete', {'id': thread.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce thread?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ thread.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7">Aucun thread trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}