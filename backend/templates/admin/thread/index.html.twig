{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Threads | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gestion des threads</h1>
        <a href="{{ path('admin_thread_new') }}" class="btn btn-success"><i class="bi bi-plus-circle"></i> Nouveau thread</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Forum</th>
                            <th>Auteur</th>
                            <th>Type</th>
                            <th>Statut</th>
                            <th>Messages</th>
                            <th>Création</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for thread in threads %}
                            <tr>
                                <td>{{ thread.id }}</td>
                                <td>
                                    {% if thread.sticky %}
                                        <span class="badge bg-info me-1" title="Thread épinglé"><i class="bi bi-pin"></i></span>
                                    {% endif %}
                                    {{ thread.title }}
                                </td>
                                <td>{{ thread.forum.name }}</td>
                                <td>{{ thread.author ? thread.author.pseudo : 'Non défini' }}</td>
                                <td>
                                    {% if thread.type == 'normal' %}
                                        <span class="badge bg-secondary">Normal</span>
                                    {% elseif thread.type == 'roleplay' %}
                                        <span class="badge bg-primary">Roleplay</span>
                                    {% elseif thread.type == 'announcement' %}
                                        <span class="badge bg-warning">Annonce</span>
                                    {% elseif thread.type == 'character_sheet' %}
                                        <span class="badge bg-info">Fiche personnage</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ thread.type }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if thread.status == 'open' %}
                                        <span class="badge bg-success">Ouvert</span>
                                    {% elseif thread.status == 'closed' %}
                                        <span class="badge bg-danger">Fermé</span>
                                    {% elseif thread.status == 'archived' %}
                                        <span class="badge bg-secondary">Archivé</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ thread.status }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ thread.posts|length }}</td>
                                <td>{{ thread.createdAt ? thread.createdAt|date('d/m/Y H:i') : '' }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_thread_show', {'id': thread.id}) }}" class="btn btn-sm btn-info"><i class="bi bi-eye"></i></a>
                                        <a href="{{ path('admin_thread_edit', {'id': thread.id}) }}" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                        <form method="post" action="{{ path('admin_thread_delete', {'id': thread.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce thread?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ thread.id) }}">
                                            <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9">Aucun thread trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}