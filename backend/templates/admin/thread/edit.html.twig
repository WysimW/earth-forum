{% extends 'admin/base.html.twig' %}

{% block title %}Modifier Thread | Earth Forum{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Modifier le thread</h1>
        <div>
            <a href="{{ path('admin_thread_index') }}" class="btn btn-secondary me-2"><i class="bi bi-arrow-left"></i> Retour à la liste</a>
            <a href="{{ path('admin_thread_show', {'id': thread.id}) }}" class="btn btn-info"><i class="bi bi-eye"></i> Voir détails</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title) }}
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.forum) }}
                    {{ form_widget(form.forum) }}
                    {{ form_errors(form.forum) }}
                    <div class="form-text">Sélectionnez le forum où le thread sera placé.</div>
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.author) }}
                    {{ form_widget(form.author) }}
                    {{ form_errors(form.author) }}
                    <div class="form-text">Sélectionnez l'auteur du thread.</div>
                </div>

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> Attention, modifier le forum ou l'auteur d'un thread peut affecter la cohérence des discussions existantes.
                </div>

                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer les modifications</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}