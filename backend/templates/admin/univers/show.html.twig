{% extends 'admin/base.html.twig' %}

{% block title %}Détails de l'univers {{ univers.name }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 text-gray-800">Univers : {{ univers.name }}</h1>
    </div>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_univers_index') }}">Univers</a></li>
            <li class="breadcrumb-item active" aria-current="page">Détails</li>
        </ol>
    </nav>

    <!-- Messages flash -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Informations générales</h6>
                    <div class="btn-group" role="group">
                        <a href="{{ path('admin_univers_edit', {'id': univers.id}) }}" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">ID</th>
                                <td>{{ univers.id }}</td>
                            </tr>
                            <tr>
                                <th>Nom</th>
                                <td>{{ univers.name }}</td>
                            </tr>
                            <tr>
                                <th>Slug</th>
                                <td><code>{{ univers.slug }}</code></td>
                            </tr>
                            <tr>
                                <th>Date de création</th>
                                <td>{{ univers.createdAt ? univers.createdAt|date('d/m/Y H:i') : '-' }}</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>
                                    {% if univers.description %}
                                        <div class="card bg-light p-3">
                                            {{ univers.description|nl2br }}
                                        </div>
                                    {% else %}
                                        <em>Aucune description</em>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Statistiques -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Statistiques</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <div class="card bg-primary text-white shadow">
                                <div class="card-body">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Forums</div>
                                    <div class="h5 mb-0 font-weight-bold">{{ univers.forums|length }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="card bg-success text-white shadow">
                                <div class="card-body">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Personnages</div>
                                    <div class="h5 mb-0 font-weight-bold">{{ univers.characters|length }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="card bg-warning text-white shadow">
                                <div class="card-body">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Elseworlds</div>
                                    <div class="h5 mb-0 font-weight-bold">{{ univers.elseworlds|length }}</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="card bg-info text-white shadow">
                                <div class="card-body">
                                    <div class="text-xs font-weight-bold text-uppercase mb-1">Lieux</div>
                                    <div class="h5 mb-0 font-weight-bold">{{ univers.locations|length }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Elseworlds associés -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Elseworlds associés</h6>
            <a href="{{ path('admin_elseworld_new') }}" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle"></i> Ajouter un Elseworld
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="elseworldsTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Slug</th>
                            <th>Créé le</th>
                            <th class="text-center">Forums</th>
                            <th class="text-center">Personnages</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for elseworld in univers.elseworlds %}
                            <tr>
                                <td>{{ elseworld.id }}</td>
                                <td>
                                    <strong>{{ elseworld.name }}</strong>
                                    {% if elseworld.logo %}
                                        <img src="{{ elseworld.logo }}" alt="Logo" class="ms-2" style="height: 20px; width: auto;">
                                    {% endif %}
                                </td>
                                <td><code>{{ elseworld.slug }}</code></td>
                                <td>{{ elseworld.createdAt ? elseworld.createdAt|date('d/m/Y H:i') : '' }}</td>
                                <td class="text-center">
                                    <span class="badge bg-info">{{ elseworld.forums|length }}</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">{{ elseworld.characters|length }}</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('admin_elseworld_show', {'id': elseworld.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_elseworld_edit', {'id': elseworld.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Aucun Elseworld associé à cet univers</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal de suppression -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmation de suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Êtes-vous sûr de vouloir supprimer l'univers <strong>{{ univers.name }}</strong> ?</p>
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i> Attention : Cette action est irréversible et supprimera également tous les elseworlds, forums, personnages et PNJ associés à cet univers.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form method="post" action="{{ path('admin_univers_delete', {'id': univers.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ univers.id) }}">
                        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function() {
        $('#elseworldsTable').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json"
            },
            "order": [[0, 'desc']], // Trier par ID décroissant par défaut
            "pageLength": 10
        });
    });
</script>
{% endblock %} 