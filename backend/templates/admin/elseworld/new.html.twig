{% extends 'admin/base.html.twig' %}

{% block title %}Créer un Elseworld{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800">Créer un nouvel Elseworld</h1>
    
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_elseworld_index') }}">Elseworlds</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouveau</li>
        </ol>
    </nav>
    
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Nouveau Elseworld</h6>
            <a href="{{ path('admin_elseworld_index') }}" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
        <div class="card-body">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Un Elseworld est un univers alternatif relié à un univers principal. Par exemple, "DC Medieval" ou "DC Beyond" sont des Elseworlds connectés à l'univers DC.
                </div>
                
                {% if form_errors(form) %}
                    <div class="alert alert-danger">
                        {{ form_errors(form) }}
                    </div>
                {% endif %}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            {{ form_label(form.name, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                            {{ form_help(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        
                        <div class="form-group mb-3">
                            {{ form_label(form.parentUniverse, 'Univers parent', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.parentUniverse, {'attr': {'class': 'form-select'}}) }}
                            {{ form_help(form.parentUniverse) }}
                            {{ form_errors(form.parentUniverse) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            {{ form_label(form.banner, 'Bannière (URL)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.banner, {'attr': {'class': 'form-control'}}) }}
                            {{ form_help(form.banner) }}
                            {{ form_errors(form.banner) }}
                        </div>
                        
                        <div class="form-group mb-3">
                            {{ form_label(form.logo, 'Logo (URL)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.logo, {'attr': {'class': 'form-control'}}) }}
                            {{ form_help(form.logo) }}
                            {{ form_errors(form.logo) }}
                        </div>
                    </div>
                </div>
                
                <div class="form-group mb-4">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                    {{ form_help(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="{{ path('admin_elseworld_index') }}" class="btn btn-secondary me-md-2">
                        <i class="bi bi-x-circle"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Créer l'Elseworld
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %} 