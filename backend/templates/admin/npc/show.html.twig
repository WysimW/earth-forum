{% extends 'admin/base.html.twig' %}

{% block title %}Détails du PNJ - {{ npc.name }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Détails du PNJ</h1>
            <p class="text-muted mb-0">{{ npc.name }}</p>
        </div>
        <div class="btn-group">
            <a href="{{ path('app_admin_npc_edit', {'id': npc.id}) }}" class="btn btn-primary">
                <i class="fas fa-edit"></i> Modifier
            </a>
            <a href="{{ path('app_admin_npc_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row">
        <!-- Informations principales -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center">
                    {% if npc.avatar %}
                        <img src="{{ npc.avatar }}" alt="{{ npc.name }}" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;">
                    {% else %}
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 150px; height: 150px;">
                            <i class="fas fa-user fa-3x"></i>
                        </div>
                    {% endif %}
                    <h3 class="card-title">{{ npc.name }}</h3>
                    <p class="text-muted">{{ npc.occupation }}</p>
                    <span class="status-badge status-{{ npc.status }}">
                        {% if npc.status == 'draft' %}
                            Brouillon
                        {% elseif npc.status == 'pending' %}
                            En attente
                        {% elseif npc.status == 'validated' %}
                            Validé
                        {% elseif npc.status == 'rejected' %}
                            Refusé
                        {% elseif npc.status == 'abandoned' %}
                            Abandonné
                        {% elseif npc.status == 'editing' %}
                            En édition
                        {% endif %}
                    </span>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Univers</dt>
                        <dd class="col-sm-8">
                            {% if npc.universe %}
                                <span class="badge bg-primary">{{ npc.universe.name }}</span>
                            {% else %}
                                <span class="text-muted">Aucun</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Propriétaire</dt>
                        <dd class="col-sm-8">{{ npc.owner.username }}</dd>

                        <dt class="col-sm-4">Créé le</dt>
                        <dd class="col-sm-8">{{ npc.createdAt|date('d/m/Y H:i') }}</dd>

                        {% if npc.validatedAt %}
                            <dt class="col-sm-4">Validé le</dt>
                            <dd class="col-sm-8">{{ npc.validatedAt|date('d/m/Y H:i') }}</dd>
                        {% endif %}

                        {% if npc.status == 'rejected' and npc.statusMessage %}
                            <dt class="col-sm-4">Raison du rejet</dt>
                            <dd class="col-sm-8">{{ npc.statusMessage }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>

        <!-- Détails du PNJ -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Description</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted">Biographie</h6>
                        <div class="npc-content">{{ npc.biography|raw }}</div>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-muted">Personnalité</h6>
                        <div class="npc-content">{{ npc.personality|raw }}</div>
                    </div>
                    <div>
                        <h6 class="text-muted">Apparence</h6>
                        <div class="npc-content">{{ npc.appearance|raw }}</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Caractéristiques</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted">Capacités</h6>
                        <div class="npc-content">{{ npc.abilities|raw }}</div>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-muted">Équipement</h6>
                        <div class="npc-content">{{ npc.equipment|raw }}</div>
                    </div>
                    <div>
                        <h6 class="text-muted">Faiblesses</h6>
                        <div class="npc-content">{{ npc.weaknesses|raw }}</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="card-title mb-0">Rôle et Relations</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6 class="text-muted">Rôle dans l'histoire</h6>
                        <div class="npc-content">{{ npc.roleInStory|raw }}</div>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-muted">Relations</h6>
                        <div class="npc-content">{{ npc.relationships|raw }}</div>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-muted">Quêtes</h6>
                        <div class="npc-content">{{ npc.quests|raw }}</div>
                    </div>
                    <div>
                        <h6 class="text-muted">Style de dialogue</h6>
                        <div class="npc-content">{{ npc.dialogueStyle|raw }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 