{% extends 'admin/base.html.twig' %}

{% block title %}{{ editMode ? 'Modifier' : 'Créer' }} un PNJ{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>{{ editMode ? 'Modifier' : 'Créer' }} un PNJ</h1>
            {% if editMode %}
                <p class="text-muted mb-0">{{ npc.name }}</p>
            {% endif %}
        </div>
        <a href="{{ path('app_admin_npc_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    <div class="row">
        <!-- Informations principales -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Informations principales</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.name) }}
                    {{ form_row(form.universe) }}
                    {{ form_row(form.user) }}
                    {{ form_row(form.status) }}
                    {{ form_row(form.avatar) }}
                    <div id="avatar-preview" class="text-center mt-3" style="display: none;">
                        <img src="" alt="Aperçu de l'avatar" class="img-thumbnail" style="max-width: 200px;">
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Identité</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.pseudonyms) }}
                    {{ form_row(form.gender) }}
                    {{ form_row(form.age) }}
                    {{ form_row(form.occupation) }}
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="card-title mb-0">Affiliation</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.moralAffiliation) }}
                    {{ form_row(form.factions) }}
                </div>
            </div>
        </div>

        <!-- Détails du PNJ -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Description</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.biography) }}
                    {{ form_row(form.personality) }}
                    {{ form_row(form.appearance) }}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Caractéristiques</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.abilities) }}
                    {{ form_row(form.equipment) }}
                    {{ form_row(form.weaknesses) }}
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Rôle et Relations</h5>
                </div>
                <div class="card-body">
                    {{ form_row(form.roleInStory) }}
                    {{ form_row(form.relationships) }}
                    {{ form_row(form.quests) }}
                    {{ form_row(form.dialogueStyle) }}
                    {{ form_row(form.secrets) }}
                </div>
            </div>

            {% if editMode %}
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Modération</h5>
                    </div>
                    <div class="card-body">
                        {{ form_row(form.moderationNote) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a href="{{ path('app_admin_npc_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-times"></i> Annuler
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> {{ editMode ? 'Enregistrer' : 'Créer' }}
        </button>
    </div>
    {{ form_end(form) }}
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialisation des éditeurs WYSIWYG
    const editors = document.querySelectorAll('.wysiwyg-editor');
    editors.forEach(function(editor) {
        ClassicEditor
            .create(editor)
            .catch(error => {
                console.error(error);
            });
    });

    // Prévisualisation de l'avatar
    const avatarInput = document.querySelector('#npc_avatar');
    const avatarPreview = document.querySelector('#avatar-preview img');

    if (avatarInput && avatarPreview) {
        avatarInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    avatarPreview.src = e.target.result;
                    document.querySelector('#avatar-preview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });

        // Afficher l'avatar existant si en mode édition
        if (avatarPreview.src) {
            document.querySelector('#avatar-preview').style.display = 'block';
        }
    }
});
</script>
{% endblock %}
{% endblock %} 