{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des PNJ{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Gestion des PNJ</h1>
        <a href="{{ path('app_admin_npc_new') }}" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Nouveau PNJ
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Univers</th>
                            <th>Propriétaire</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for npc in npcs %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if npc.avatar %}
                                            <img src="{{ npc.avatar }}" alt="{{ npc.name }}" class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                        {% else %}
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        {% endif %}
                                        <span class="fw-medium">{{ npc.name }}</span>
                                    </div>
                                </td>
                                <td>
                                    {% if npc.universe %}
                                        <span class="badge bg-primary">{{ npc.universe.name }}</span>
                                    {% else %}
                                        <span class="text-muted">Aucun</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="text-muted">{{ npc.user.username }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-{{ npc.status == 'validated' ? 'success' : (npc.status == 'pending' ? 'warning' : (npc.status == 'rejected' ? 'danger' : (npc.status == 'draft' ? 'secondary' : 'info'))) }}">
                                        {% if npc.status == 'draft' %}
                                            <i class="fas fa-file me-1"></i>Brouillon
                                        {% elseif npc.status == 'pending' %}
                                            <i class="fas fa-clock me-1"></i>En attente
                                        {% elseif npc.status == 'validated' %}
                                            <i class="fas fa-check me-1"></i>Validé
                                        {% elseif npc.status == 'rejected' %}
                                            <i class="fas fa-times me-1"></i>Refusé
                                        {% elseif npc.status == 'abandoned' %}
                                            <i class="fas fa-ban me-1"></i>Abandonné
                                        {% elseif npc.status == 'editing' %}
                                            <i class="fas fa-edit me-1"></i>En édition
                                        {% endif %}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted">{{ npc.createdAt|date('d/m/Y H:i') }}</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_admin_npc_show', {'id': npc.id}) }}" class="btn btn-sm btn-info px-3" title="Voir">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('app_admin_npc_edit', {'id': npc.id}) }}" class="btn btn-sm btn-warning px-3" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        {% if npc.status == 'pending' %}
                                            <form method="post" action="{{ path('app_admin_npc_validate', {'id': npc.id}) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ npc.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success px-3" title="Valider">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-danger px-3" data-bs-toggle="modal" data-bs-target="#rejectModal{{ npc.id }}" title="Rejeter">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        {% endif %}
                                    </div>

                                    <!-- Modal de rejet -->
                                    <div class="modal fade" id="rejectModal{{ npc.id }}" tabindex="-1" aria-labelledby="rejectModalLabel{{ npc.id }}" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="rejectModalLabel{{ npc.id }}">Rejeter le PNJ</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form method="post" action="{{ path('app_admin_npc_reject', {'id': npc.id}) }}">
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label for="rejection_reason" class="form-label">Raison du rejet</label>
                                                            <textarea class="form-control" id="rejection_reason" name="rejection_reason" rows="3" required></textarea>
                                                        </div>
                                                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ npc.id) }}">
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                        <button type="submit" class="btn btn-danger">Rejeter</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="text-muted">
                                        <i class="fas fa-inbox fa-2x mb-3"></i>
                                        <p class="mb-0">Aucun PNJ trouvé</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %} 